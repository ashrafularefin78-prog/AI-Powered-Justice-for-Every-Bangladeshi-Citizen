:all .3s;cursor:default" onmouseover="this.style.borderColor='var(--pri)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--gb)';this.style.transform='none'"><span style="font-size:.85rem;color:#e2e8f0;font-weight:500">Sirajganj</span></div><div style="background:var(--glass);border:1px solid var(--gb);border-radius:10px;padding:.75rem 1rem;text-align:center;transition:all .3s;cursor:default" onmouseover="this.style.borderColor='var(--pri)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--gb)';this.style.transform='none'"><span style="font-size:.85rem;color:#e2e8f0;font-weight:500">Pabna</span></div><div style="background:var(--glass);border:1px solid var(--gb);border-radius:10px;padding:.75rem 1rem;text-align:center;transition:all .3s;cursor:default" onmouseover="this.style.borderColor='var(--pri)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--gb)';this.style.transform='none'"><span style="font-size:.85rem;color:#e2e8f0;font-weight:500">Kurigram</span></div><div style="background:var(--glass);border:1px solid var(--gb);border-radius:10px;padding:.75rem 1rem;text-align:center;transition:all .3s;cursor:default" onmouseover="this.style.borderColor='var(--pri)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--gb)';this.style.transform='none'"><span style="font-size:.85rem;color:#e2e8f0;font-weight:500">Dinajpur</span></div><div style="background:var(--glass);border:1px solid var(--gb);border-radius:10px;padding:.75rem 1rem;text-align:center;transition:all .3s;cursor:default" onmouseover="this.style.borderColor='var(--pri)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--gb)';this.style.transform='none'"><span style="font-size:.85rem;color:#e2e8f0;font-weight:500">Thakurgaon</span></div><div style="background:var(--glass);border:1px solid var(--gb);border-radius:10px;padding:.75rem 1rem;text-align:center;transition:all .3s;cursor:default" onmouseover="this.style.borderColor='var(--pri)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--gb)';this.style.transform='none'"><span style="font-size:.85rem;color:#e2e8f0;font-weight:500">Nilphamari</span></div><div style="background:var(--glass);border:1px solid var(--gb);border-radius:10px;padding:.75rem 1rem;text-align:center;transition:all .3s;cursor:default" onmouseover="this.style.borderColor='var(--pri)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--gb)';this.style.transform='none'"><span style="font-size:.85rem;color:#e2e8f0;font-weight:500">Lalmonirhat</span></div><div style="background:var(--glass);border:1px solid var(--gb);border-radius:10px;padding:.75rem 1rem;text-align:center;transition:all .3s;cursor:default" onmouseover="this.style.borderColor='var(--pri)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--gb)';this.style.transform='none'"><span style="font-size:.85rem;color:#e2e8f0;font-weight:500">Gaibandha</span></div><div style="background:var(--glass);border:1px solid var(--gb);border-radius:10px;padding:.75rem 1rem;text-align:center;transition:all .3s;cursor:default" onmouseover="this.style.borderColor='var(--pri)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--gb)';this.style.transform='none'"><span style="font-size:.85rem;color:#e2e8f0;font-weight:500">Panchagarh</span></div></div></div></section>

<section id="vision" style="background:rgba(2,6,23,.5)"><div class="container"><div class="section-header"><div class="section-tag">Our Vision</div><h2>Democratizing Access to Justice</h2><p>Leveraging AI to make legal information, assistance, and dispute resolution affordable, transparent, and accessible to every citizen.</p></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;max-width:900px;margin:0 auto"><div class="pcard reveal" style="text-align:center"><div class="picon" style="background:rgba(14,165,233,.15);color:#0ea5e9;margin:0 auto 1.25rem"><i class="fas fa-eye"></i></div><h3>Vision</h3><p>To democratize access to justice in Bangladesh by leveraging AI, making legal information affordable and accessible to every citizen, regardless of language, literacy, or economic status.</p></div><div class="pcard reveal rd1" style="text-align:center"><div class="picon" style="background:rgba(99,102,241,.15);color:#6366f1;margin:0 auto 1.25rem"><i class="fas fa-rocket"></i></div><h3>Mission</h3><p>Build a user-centric digital platform integrating AI to bridge citizens and the legal system, empowering individuals with knowledge, tools, and connections to resolve legal issues efficiently.</p></div></div></div></section>
<button class="back-to-top" id="backToTop" aria-label="Back to top"><i class="fas fa-arrow-up"></i></button>
<footer><div class="fgrid"><div><a href="index.html" class="nav-logo" style="margin-bottom:1rem;display:inline-flex"><span>A ai</span></a><p>Next-Gen Digital Legal Aid - Access to justice for 682,500+ citizens across all 64 districts.</p></div><div class="fcol"><h4>Platform</h4><a href="ai.html">A ai AI Platform</a><a href="justice.html">Justice Map</a><a href="sheguard.html">SheGuard X</a><a href="july.html">July 2024</a></div><div class="fcol"><h4>Government</h4><a href="government.html">Structure &amp; e-Services</a><a href="blueprints.html">Visionary Blueprints</a><a href="contact.html">Complaints</a><a href="contact.html">Contact</a></div><div class="fcol"><h4>Resources</h4><a href="justice.html#emergency-helplines">Emergency Helplines</a><a href="justice.html#constitution-full">Constitution</a><a href="government.html#govt-services">e-Services Portals</a><a href="justice.html#interactive-map">Districts Map</a></div></div><div class="fb"><span>© 2025 A ai | EU / UNDP / DBLA</span><span>Accelerating Digital Legal Aid in Bangladesh</span></div></footer>
