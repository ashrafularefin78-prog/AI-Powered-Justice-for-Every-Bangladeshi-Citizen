<!-- LOGIN FORM -->
<form class="auth-form" id="loginForm" onsubmit="return handleLogin(event)">
<div class="form-group">
<label>NID Card Number *</label>
<input type="text" id="loginNid" placeholder="Enter your NID number" required="" maxlength="17" pattern="[0-9]{10,17}">
<div class="form-hint">10 or 17 digit National ID number</div>
</div>
<div class="form-group">
<label>Phone Number *</label>
<input type="tel" id="loginPhone" placeholder="01XXXXXXXXX" required="" pattern="01[3-9][0-9]{8}">
<div class="form-hint">11-digit Bangladeshi mobile number</div>
</div>
<button type="submit" class="submit-btn"><i class="fas fa-sign-in-alt"></i> Sign In</button>
</form>

<!-- SIGNUP FORM -->
<form class="auth-form" id="signupForm" style="display:none" onsubmit="return handleSignup(event)">
<div class="auth-wsteps-bar" id="wsBar">
<div class="ws-dot active" data-s="1" onclick="wsGo(1)"><span>1</span><b>Role</b></div>
<div class="ws-line"></div>
<div class="ws-dot" data-s="2" onclick="wsGo(2)"><span>2</span><b>Identity</b></div>
<div class="ws-line"></div>
<div class="ws-dot" data-s="3" onclick="wsGo(3)"><span>3</span><b>Address</b></div>
<div class="ws-line"></div>
<div class="ws-dot" data-s="4" onclick="wsGo(4)"><span>4</span><b>Photo</b></div>
</div>
<div class="auth-wsteps" id="wsSteps" dir="fwd">
<div class="auth-wstep active" data-step="1">

<div class="form-group">
<label>Select Your Role *</label>
<div class="role-select">
<div class="role-card selected" onclick="selectRole('general')" id="roleGeneral">
<i class="fas fa-user"></i>
<span>General User</span>
</div>
<div class="role-card" onclick="selectRole('officer')" id="roleOfficer">
<i class="fas fa-user-tie"></i>
<span>Officer / Official</span>
</div>
</div>
</div>
<button type="button" class="btn-ws btn-next" onclick="wsNext()">Next <i class="fas fa-arrow-right"></i></button>
</div>
<div class="auth-wstep" data-step="2">
<div class="form-group">
<label>Full Name (as per NID) *</label>
<input type="text" id="signupName" placeholder="Enter full name" required="">
</div>
<div class="form-row">
<div class="form-group">
<label>NID Card Number *</label>
<input type="text" id="signupNid" placeholder="NID number" required="" maxlength="17" pattern="[0-9]{10,17}">
</div>
<div class="form-group">
<label>Phone Number *</label>
<input type="tel" id="signupPhone" placeholder="01XXXXXXXXX" required="" pattern="01[3-9][0-9]{8}">
</div>
</div>
<div class="ws-nav"><button type="button" class="btn-ws btn-back" onclick="wsBack()"><i class="fas fa-arrow-left"></i> Back</button><button type="button" class="btn-ws btn-next" onclick="wsNext()">Next <i class="fas fa-arrow-right"></i></button></div>
</div>
<div class="auth-wstep" data-step="3">
<div class="form-row">
<div class="form-group">
<label>Division *</label>
<select id="signupDivision" required="" onchange="updateDistricts()">
<option value="">Select Division</option>
<option>Barishal</option><option>Chattogram</option><option>Dhaka</option>
<option>Khulna</option><option>Mymensingh</option><option>Rajshahi</option>
<option>Rangpur</option><option>Sylhet</option>
</select>
</div>
<div class="form-group">
<label>District (Zila) *</label>
<select id="signupDistrict" required="" onchange="updateUpazilas()">
<option value="">Select District</option>
</select>
</div>
</div>
<div class="form-row">
<div class="form-group">
<label>Upazila *</label>
<select id="signupUpazila" required="">
<option value="">Select Upazila</option>
</select>
</div>
<div class="form-group">
<label>Union *</label>
<input type="text" id="signupUnion" placeholder="Enter union name" required="">
</div>
</div>
<div class="ws-nav"><button type="button" class="btn-ws btn-back" onclick="wsBack()"><i class="fas fa-arrow-left"></i> Back</button><button type="button" class="btn-ws btn-next" onclick="wsNext()">Next <i class="fas fa-arrow-right"></i></button></div>
</div>
<div class="auth-wstep" data-step="4">
<div class="form-group">
<label>Your Photo *</label>
<div class="photo-upload" onclick="document.getElementById('signupPhoto').click()">
<i class="fas fa-camera"></i>
<span>Click to upload passport-size photo</span>
<input type="file" id="signupPhoto" accept="image/*" style="display:none" onchange="previewPhoto(this,'photoPreview')">
</div>
<div id="photoPreview" style="margin-top:.5rem"></div>
</div>
<div class="officer-fields" id="officerFields">
<div class="form-group">
<label>Designation / Post *</label>
<input type="text" id="signupDesignation" placeholder="e.g. Upazila Nirbahi Officer">
</div>
<div class="form-group">
<label>Office Name *</label>
<input type="text" id="signupOffice" placeholder="e.g. Office of the UNO, Dhaka">
</div>
<div class="form-group">
<label>Signature Image *</label>
<div class="photo-upload" onclick="document.getElementById('signupSig').click()">
<i class="fas fa-pen-nib"></i>
<span>Click to upload signature image</span>
<input type="file" id="signupSig" accept="image/*" style="display:none" onchange="previewPhoto(this,'sigPreview')">
</div>
<div id="sigPreview" style="margin-top:.5rem"></div>
</div>
</div>
<button type="submit" class="submit-btn"><i class="fas fa-user-plus"></i> Create Account</button>
</form>
<div class="ws-nav"><button type="button" class="btn-ws btn-back" onclick="wsBack()"><i class="fas fa-arrow-left"></i> Back</button></div>
</div>
</div>
</form>
</div>
</div>

<!-- Toast -->
<div class="auth-toast" id="authToast"></div>
<div class="chatbot-fab" id="chatFab" onclick="toggleCB()"><i class="fas fa-robot"></i><span>A ai</span></div>
<div class="chatbot-win" id="chatWin">
<div class="cb-head"><div class="cb-avatar"><i class="fas fa-robot"></i></div><div class="cb-info"><h4>A ai Legal Assistant</h4><span>Online - Ready to help</span></div><div class="cb-dot"></div><div class="cb-mem" id="cbMem" title="Active conversation topic"><i class="fas fa-brain"></i><span id="cbMemTxt">General</span><button class="cb-mem-x" onclick="resetMemChip()" title="Reset conversation memory"><i class="fas fa-times"></i></button></div><button class="cb-close" onclick="toggleCB()"><i class="fas fa-times"></i></button></div>
<div class="cb-msgs" id="chatMsgs"><div class="cb-msg bot">Assalamu Alaikum! I am <b>A ai</b>, your AI legal assistant powered by the Constitution of Bangladesh and public administration knowledge. I can help with:<br><br>- <b>Legal Information</b> - Bengali/English<br>- <b>Constitutional Rights</b> - Articles 27-44<br>- <b>Public Administration</b> - Reforms &amp; governance<br>- <b>Court Procedures</b> - All 64 districts<br>- <b>Corruption &amp; Accountability</b> - Anti-corruption<br>- <b>Case Status</b> - Real-time tracking<br><br>How can I assist you today?</div>
<div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:.3rem;padding:0 .3rem">
<span class="cb-followup" onclick="document.getElementById('chatIn').value='সংবিধান';sendMsg()" style="cursor:pointer;font-size:.7rem">সংবিধান</span>
<span class="cb-followup" onclick="document.getElementById('chatIn').value='মৌলিক অধিকার';sendMsg()" style="cursor:pointer;font-size:.7rem">মৌলিক অধিকার</span>
<span class="cb-followup" onclick="document.getElementById('chatIn').value='আদালত';sendMsg()" style="cursor:pointer;font-size:.7rem">আদালত</span>
<span class="cb-followup" onclick="document.getElementById('chatIn').value='পুলিশ কমপ্লেইন';sendMsg()" style="cursor:pointer;font-size:.7rem">পুলিশ কমপ্লেইন</span>
</div></div>
<div class="cb-input"><input type="text" id="chatIn" placeholder="Type in English or Bengali... / ইংরেজি বা বাংলায় লিখুন..." onkeypress="if(event.key==='Enter')sendMsg()"><button onclick="sendMsg()"><i class="fas fa-paper-plane"></i></button></div>
</div>

<script>
const pc=document.getElementById('particles');for(let i=0;i<30;i++){const p=document.createElement('div');p.className='particle';const s=Math.random()*4+1;p.style.cssText='width:'+s+'px;height:'+s+'px;top:'+Math.random()*100+'%;left:'+Math.random()*100+'%;animation-delay:'+Math.random()*15+'s;animation-duration:'+(10+Math.random()*20)+'s';pc.appendChild(p)}
// Typing animation for hero headline
(function(){
  const line1=document.getElementById('typingLine1');
  const line2=document.getElementById('typingLine2');
  const lines=[
    {el:line1,text:'AI-Powered',speed:80},
    {el:line2,text:'Justice for Every Bangladeshi Citizen',speed:50}
  ];
  let lineIdx=0,charIdx=0;
  function typeNext(){
    if(lineIdx>=lines.length)return;
    const current=lines[lineIdx];
    if(charIdx<current.text.length){
      current.el.textContent+=current.text[charIdx];
      charIdx++;
      setTimeout(typeNext,current.speed);
    }else{
      lineIdx++;
      charIdx=0;
      if(lineIdx<lines.length)setTimeout(typeNext,400);
    }
  }
  setTimeout(typeNext,800);
})();

// Parallax scrolling for hero particles
(function(){
  const particles=document.getElementById('particles');
  const heroBg=document.querySelector('.hero-bg');
  const hero=document.querySelector('.hero');
  if(!particles||!hero)return;
  
  // Create additional parallax layers
  const layer1=document.createElement('div');
  layer1.className='parallax-layer';
  layer1.style.cssText='position:absolute;inset:0;z-index:0;will-change:transform';
  
  // Add floating orbs with different sizes and speeds
  const orbs=[
    {size:120,color:'rgba(14,165,233,0.08)',x:10,y:20,speed:0.3},
    {size:80,color:'rgba(99,102,241,0.06)',x:70,y:30,speed:0.5},
    {size:60,color:'rgba(245,158,11,0.05)',x:85,y:70,speed:0.2},
    {size:100,color:'rgba(14,165,233,0.06)',x:20,y:80,speed:0.4},
    {size:50,color:'rgba(99,102,241,0.07)',x:60,y:15,speed:0.35},
  ];
  
  orbs.forEach(orb=>{
    const el=document.createElement('div');
    el.style.cssText='position:absolute;border-radius:50%;background:'+orb.color+';width:'+orb.size+'px;height:'+orb.size+'px;left:'+orb.x+'%;top:'+orb.y+'%;filter:blur(30px);will-change:transform;transition:transform .1s linear';
    el.dataset.speed=orb.speed;
    layer1.appendChild(el);
  });
  particles.appendChild(layer1);
  
  // Track scroll for parallax
  let ticking=false;
  window.addEventListener('scroll',()=>{
    if(!ticking){
      requestAnimationFrame(()=>{
        const scrollY=window.scrollY;
        const heroHeight=hero.offsetHeight;
        
        if(scrollY<heroHeight*1.5){
          // Parallax effect: particles move slower than scroll
          const orbs=layer1.querySelectorAll('div');
          orbs.forEach(orb=>{
            const speed=parseFloat(orb.dataset.speed);
            const yOffset=scrollY*speed;
            const xOffset=scrollY*speed*0.2;
            orb.style.transform='translate3d('+xOffset+'px,'+(-yOffset)+'px,0)';
          });
          
          // Fade hero content on scroll
          const heroContent=document.querySelector('.hero-content');
          if(heroContent){
            const fadeStart=heroHeight*0.1;
            const fadeEnd=heroHeight*0.6;
            const opacity=scrollY<fadeStart?1:scrollY>fadeEnd?0:1-(scrollY-fadeStart)/(fadeEnd-fadeStart);
            heroContent.style.opacity=opacity;
            heroContent.style.transform='translateY('+(scrollY*0.15)+'px)';
          }
          
          // Parallax on hero background gradient
          if(heroBg){
            heroBg.style.transform='translateY('+(scrollY*0.3)+'px)';
          }
        }
        ticking=false;
      });
      ticking=true;
    }
  });
})();
</script>
<script src="assets/app.js?v=app57"></script>
</body>
</html>
