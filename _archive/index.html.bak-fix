    body.light #agent-comm{background:linear-gradient(135deg,rgba(0,255,136,.02),rgba(168,85,247,.02))}


    body.light #constitutional-ai .fcard{background:#fff;border-color:#e2e8f0}
    body.light #constitutional-ai .fcard h3{color:#1e293b}
    body.light #constitutional-ai .fcard p{color:#475569}
    body.light #constitutional-ai{background:linear-gradient(135deg,rgba(0,255,136,.03),rgba(255,215,0,.03))}


    .chatbot-fab{position:fixed;bottom:24px;right:24px;z-index:10000;display:flex;align-items:center;gap:8px;background:linear-gradient(135deg,#00ff88,#00b4ff);color:#fff;padding:12px 20px;border-radius:50px;box-shadow:0 4px 24px rgba(0,255,136,.4);cursor:pointer;transition:all .3s ease;font-weight:600;font-size:.9rem;border:none}
    .chatbot-fab:hover{transform:translateY(-2px) scale(1.05);box-shadow:0 8px 32px rgba(0,255,136,.5)}
    .chatbot-pulse{position:absolute;width:100%;height:100%;border-radius:50px;background:linear-gradient(135deg,#00ff88,#00b4ff);animation:cpulse 2s infinite;z-index:-1}
    @keyframes cpulse{0%{transform:scale(1);opacity:.6}100%{transform:scale(1.5);opacity:0}}
    .chatbot-win{position:fixed;bottom:80px;right:24px;width:380px;max-height:520px;background:#0f172a;border:1px solid rgba(0,255,136,.2);border-radius:1rem;z-index:9998;display:none;flex-direction:column;overflow:hidden;box-shadow:0 8px 40px rgba(0,0,0,.5)}
    .chatbot-win.open{display:flex}
    .cb-head{background:linear-gradient(135deg,rgba(0,255,136,.15),rgba(0,180,255,.15));padding:1rem 1.2rem;display:flex;align-items:center;gap:.7rem;border-bottom:1px solid rgba(255,255,255,.1)}
    .cb-avatar{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#00ff88,#00b4ff);display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:#fff;flex-shrink:0}
    .cb-info h4{color:#fff;font-size:.95rem;margin:0}
    .cb-info span{color:rgba(255,255,255,.5);font-size:.75rem}
    .cb-dot{width:8px;height:8px;background:#00ff88;border-radius:50%;margin-left:auto;animation:blink 1.5s infinite}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
    .cb-msgs{flex:1;overflow-y:auto;padding:1rem;display:flex;flex-direction:column;gap:.7rem}
    .cb-msg{max-width:85%;padding:.7rem 1rem;border-radius:1rem;font-size:.85rem;line-height:1.5;color:#fff}
    .cb-msg.bot{background:rgba(0,255,136,.1);border:1px solid rgba(0,255,136,.2);align-self:flex-start;border-bottom-left-radius:4px}
    .cb-msg.user{background:linear-gradient(135deg,#0ea5e9,#6366f1);align-self:flex-end;border-bottom-right-radius:4px}
    .cb-typing span{display:inline-block;width:6px;height:6px;background:#00ff88;border-radius:50%;margin:0 2px;animation:tdot 1.2s infinite}
    .cb-typing span:nth-child(2){animation-delay:.2s}
    .cb-typing span:nth-child(3){animation-delay:.4s}
    @keyframes tdot{0%,100%{opacity:.3;transform:translateY(0)}50%{opacity:1;transform:translateY(-4px)}}
    .cb-input{display:flex;gap:.5rem;padding:.8rem 1rem;border-top:1px solid rgba(255,255,255,.1);background:rgba(0,0,0,.3)}
    .cb-input input{flex:1;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);border-radius:2rem;padding:.6rem 1rem;color:#fff;font-size:.85rem;outline:none}
    .cb-input input::placeholder{color:rgba(255,255,255,.3)}
    .cb-input input:focus{border-color:rgba(0,255,136,.5)}
    .cb-input button{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#00ff88,#00b4ff);border:none;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center}
    .cb-close{background:none;border:none;color:rgba(255,255,255,.6);cursor:pointer;font-size:1.1rem}
    .cb-close:hover{color:#fff}
    body.light .chatbot-win{background:#fff;border-color:#e2e8f0}
    body.light .cb-msg.bot{background:#f0fdf4;border-color:#bbf7d0;color:#1e293b}
    body.light .cb-input input{background:#f1f5f9;border-color:#e2e8f0;color:#1e293b}


/* Auth Modal */
.auth-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(8px);z-index:10000;display:none;align-items:center;justify-content:center;padding:1rem}
.auth-overlay.open{display:flex}
.auth-modal{background:var(--card);border:1px solid var(--border);border-radius:1.2rem;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;position:relative;box-shadow:0 25px 60px rgba(0,0,0,.4)}
.auth-close{position:absolute;top:1rem;right:1rem;background:none;border:none;color:var(--text);font-size:1.3rem;cursor:pointer;z-index:2;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:background .2s}
.auth-close:hover{background:rgba(255,255,255,.1)}
.auth-header{padding:2rem 2rem 0;text-align:center}
.auth-header .auth-icon{width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#0ea5e9,#6366f1);display:flex;align-items:center;justify-content:center;margin:0 auto .8rem;font-size:1.5rem;color:#fff}
.auth-header h2{font-size:1.4rem;font-weight:700;margin-bottom:.3rem}
.auth-header p{color:var(--muted);font-size:.85rem}
.auth-tabs{display:flex;gap:0;padding:1.2rem 2rem 0}
.auth-tab{flex:1;padding:.6rem;text-align:center;border:none;background:transparent;color:var(--muted);font-size:.9rem;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;transition:all .2s}
.auth-tab.active{color:var(--accent);border-bottom-color:var(--accent)}
.auth-form{padding:1.5rem 2rem 2rem}
.auth-form .form-group{margin-bottom:1rem}
.auth-form label{display:block;font-size:.8rem;font-weight:600;color:var(--text);margin-bottom:.3rem}
.auth-form select,.auth-form input{width:100%;padding:.65rem .8rem;background:var(--bg);border:1px solid var(--border);border-radius:.5rem;color:var(--text);font-size:.85rem;outline:none;transition:border .2s}
.auth-form select:focus,.auth-form input:focus{border-color:var(--accent)}
.auth-form .form-row{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.auth-form .form-full{grid-column:1/-1}
.auth-form .role-select{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-bottom:1rem}
.auth-form .role-card{padding:1rem;border:2px solid var(--border);border-radius:.8rem;text-align:center;cursor:pointer;transition:all .2s}
.auth-form .role-card:hover{border-color:var(--accent);background:rgba(14,165,233,.05)}
.auth-form .role-card.selected{border-color:var(--accent);background:rgba(14,165,233,.1)}
.auth-form .role-card i{font-size:1.5rem;color:var(--accent);margin-bottom:.3rem;display:block}
.auth-form .role-card span{font-size:.8rem;font-weight:600}
.auth-form .photo-upload{border:2px dashed var(--border);border-radius:.8rem;padding:1.2rem;text-align:center;cursor:pointer;transition:border .2s}
.auth-form .photo-upload:hover{border-color:var(--accent)}
.auth-form .photo-upload i{font-size:1.5rem;color:var(--accent);margin-bottom:.3rem;display:block}
.auth-form .photo-upload span{font-size:.75rem;color:var(--muted)}
.auth-form .submit-btn{width:100%;padding:.75rem;border:none;border-radius:.6rem;background:linear-gradient(135deg,#0ea5e9,#6366f1);color:#fff;font-size:.95rem;font-weight:600;cursor:pointer;transition:transform .2s,box-shadow .2s;margin-top:.5rem}
.auth-form .submit-btn:hover{transform:translateY(-1px);box-shadow:0 4px 15px rgba(14,165,233,.3)}
.auth-form .divider{text-align:center;margin:1rem 0;position:relative;color:var(--muted);font-size:.8rem}
.auth-form .divider::before,.auth-form .divider::after{content:'';position:absolute;top:50%;width:40%;height:1px;background:var(--border)}
.auth-form .divider::before{left:0}.auth-form .divider::after{right:0}
.auth-form .officer-fields{display:none}
.auth-form .officer-fields.show{display:block}
/* User Profile Bar */
.user-profile-bar{display:none;align-items:center;gap:.6rem;padding:.4rem .8rem;background:rgba(14,165,233,.1);border:1px solid rgba(14,165,233,.3);border-radius:2rem;cursor:pointer}
.user-profile-bar.show{display:inline-flex}
.user-profile-bar .up-avatar{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#0ea5e9,#6366f1);display:flex;align-items:center;justify-content:center;color:#fff;font-size:.7rem;font-weight:700}
.user-profile-bar .up-name{font-size:.8rem;font-weight:600;color:var(--text)}
.user-dropdown{position:absolute;top:100%;right:0;margin-top:.5rem;background:var(--card);border:1px solid var(--border);border-radius:.8rem;min-width:200px;box-shadow:0 10px 30px rgba(0,0,0,.3);display:none;z-index:9999;padding:.5rem 0}
.user-dropdown.open{display:block}
.user-dropdown .ud-item{padding:.6rem 1rem;font-size:.85rem;color:var(--text);cursor:pointer;display:flex;align-items:center;gap:.5rem;transition:background .15s}
.user-dropdown .ud-item:hover{background:rgba(14,165,233,.1)}
.user-dropdown .ud-item i{width:16px;text-align:center;color:var(--accent)}
.user-dropdown .ud-divider{height:1px;background:var(--border);margin:.3rem 0}
.user-dropdown .ud-item.logout{color:#ef4444}
.user-dropdown .ud-item.logout i{color:#ef4444}
/* Success toast */
.auth-toast{position:fixed;top:1.5rem;right:1.5rem;padding:1rem 1.5rem;border-radius:.8rem;background:linear-gradient(135deg,#10b981,#059669);color:#fff;font-size:.9rem;font-weight:600;z-index:99999;transform:translateX(120%);transition:transform .3s ease;box-shadow:0 5px 20px rgba(16,185,129,.3)}
.auth-toast.show{transform:translateX(0)}
.auth-form .form-hint{font-size:.7rem;color:var(--muted);margin-top:.2rem}


/* Map Tooltip */
.map-tooltip{position:fixed;pointer-events:none;z-index:9998;background:var(--card);border:1px solid var(--border);border-radius:.8rem;padding:.8rem 1rem;box-shadow:0 8px 30px rgba(0,0,0,.4);max-width:240px;opacity:0;transition:opacity .15s ease,transform .15s ease;transform:translateY(4px)}
.map-tooltip.visible{opacity:1;transform:translateY(0)}
.map-tooltip .tt-name{font-size:.95rem;font-weight:700;margin-bottom:.3rem}
.map-tooltip .tt-division{font-size:.7rem;font-weight:600;padding:.15rem .5rem;border-radius:1rem;display:inline-block;margin-bottom:.4rem}
.map-tooltip .tt-row{display:flex;justify-content:space-between;align-items:center;font-size:.78rem;color:var(--muted);padding:.15rem 0;border-bottom:1px solid rgba(255,255,255,.05)}
.map-tooltip .tt-row:last-child{border-bottom:none}
.map-tooltip .tt-val{font-weight:600;color:var(--text)}
.map-tooltip .tt-click{font-size:.65rem;color:var(--accent);margin-top:.3rem;text-align:center;font-style:italic}


/* Government Structure Section */
.govt-struct-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-top:1.5rem}
.govt-ministry-card{background:var(--card);border:1px solid var(--border);border-radius:.8rem;padding:1rem;transition:transform .2s,box-shadow .2s;cursor:default}
.govt-ministry-card:hover{transform:translateY(-2px);box-shadow:0 5px 20px rgba(14,165,233,.15)}
.govt-ministry-card .gmc-icon{width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:.5rem;font-size:.9rem}
.govt-ministry-card h4{margin:0 0 .2rem;font-size:.82rem;color:var(--text);font-weight:600}
.govt-ministry-card p{margin:0;font-size:.7rem;color:var(--muted)}
/* Helpline Cards */
.helpline-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem;margin-top:1.5rem}
.helpline-card{display:flex;align-items:center;gap:1rem;padding:1.2rem;background:var(--card);border:1px solid var(--border);border-radius:1rem;transition:transform .2s,box-shadow .2s}
.helpline-card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(0,0,0,.2)}
.helpline-card .hl-icon{width:50px;height:50px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0}
.helpline-card .hl-info h4{margin:0;font-size:.95rem;color:var(--text);font-weight:700}
.helpline-card .hl-info p{margin:.15rem 0 0;font-size:.75rem;color:var(--muted)}
.helpline-card .hl-number{margin-left:auto;font-size:1.1rem;font-weight:800;color:var(--accent);white-space:nowrap}
.helpline-card .hl-number a{color:inherit;text-decoration:none}
/* Division Tabs */
.div-tabs{display:flex;flex-wrap:wrap;gap:.4rem;margin:1rem 0}
.div-tab{padding:.4rem .8rem;border-radius:2rem;border:1px solid var(--border);background:transparent;color:var(--muted);font-size:.75rem;font-weight:600;cursor:pointer;transition:all .2s}
.div-tab.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.div-tab:hover{border-color:var(--accent);color:var(--accent)}
.div-content{display:none;padding:1rem;background:var(--card);border:1px solid var(--border);border-radius:.8rem}
.div-content.active{display:block}
.div-content h4{margin:0 0 .5rem;font-size:.9rem;color:var(--text)}
.div-districts{display:flex;flex-wrap:wrap;gap:.4rem}
.div-districts span{padding:.25rem .6rem;background:rgba(14,165,233,.1);color:var(--accent);border-radius:1rem;font-size:.72rem;font-weight:500}


/* Map Search & Filter */
.map-search-bar{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;margin-bottom:1.5rem;padding:1rem;background:var(--card);border:1px solid var(--border);border-radius:1rem}
.map-search-input{flex:1;min-width:200px;padding:.6rem 1rem .6rem 2.5rem;background:var(--bg);border:1px solid var(--border);border-radius:2rem;color:var(--text);font-size:.9rem;outline:none;transition:border .2s;position:relative}
.map-search-input:focus{border-color:var(--accent)}
.map-search-wrap{flex:1;min-width:200px;position:relative}
.map-search-wrap i{position:absolute;left:.8rem;top:50%;transform:translateY(-50%);color:var(--muted);font-size:.85rem;pointer-events:none}
.map-filter-btns{display:flex;flex-wrap:wrap;gap:.35rem}
.map-filter-btn{padding:.35rem .7rem;border-radius:2rem;border:1px solid var(--border);background:transparent;color:var(--muted);font-size:.72rem;font-weight:600;cursor:pointer;transition:all .2s;white-space:nowrap}
.map-filter-btn.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.map-filter-btn:hover{border-color:var(--accent);color:var(--accent)}
.map-filter-btn.active:hover{color:#fff}
.map-district.dimmed{opacity:.12!important;transform:none!important;filter:none!important;pointer-events:none}
.map-district.highlighted{opacity:1!important;filter:brightness(1.5)!important;stroke-width:2.5!important}
.map-results-count{font-size:.8rem;color:var(--muted);margin-bottom:.8rem;text-align:center}


/* Advanced AI Engine Styles */
.cb-thinking{display:flex;align-items:center;gap:.6rem;padding:.5rem 1rem;background:rgba(14,165,233,.06);border:1px solid rgba(14,165,233,.15);border-radius:1.2rem;border-bottom-left-radius:4px;align-self:flex-start;max-width:90%;transition:all .3s}
@keyframes thinkPulse{0%,100%{opacity:.7}50%{opacity:1}}
.cb-thinking .think-icon{width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,#00ff88,#0ea5e9);display:flex;align-items:center;justify-content:center;font-size:.7rem;color:#000;font-weight:800;animation:thinkSpin 3s linear infinite}
@keyframes thinkSpin{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}
.cb-thinking .think-text{font-size:.75rem;color:var(--muted);font-style:italic}
/* Reasoning Steps */
.cb-reasoning{margin:.4rem 0;padding:.6rem .8rem;background:rgba(14,165,233,.04);border:1px solid rgba(14,165,233,.12);border-radius:.8rem;font-size:.75rem;color:var(--muted)}.cb-reasoning .reason-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:.4rem;padding-bottom:.3rem;border-bottom:1px solid rgba(14,165,233,.1)}.cb-reasoning .reason-title{font-size:.7rem;color:#0ea5e9;font-weight:600;display:flex;align-items:center;gap:.3rem}.cb-reasoning .reason-title i{font-size:.65rem}.cb-reasoning .reason-stats{display:flex;gap:.6rem;font-size:.65rem}.cb-reasoning .stat-time{color:#10b981;font-weight:600}.cb-reasoning .stat-confidence{padding:.1rem .4rem;border-radius:.5rem;font-weight:600;font-size:.6rem}.cb-reasoning .stat-confidence.high{background:rgba(16,185,129,.15);color:#10b981}.cb-reasoning .stat-confidence.medium{background:rgba(245,158,11,.15);color:#f59e0b}.cb-reasoning .stat-confidence.low{background:rgba(239,68,68,.15);color:#ef4444}.cb-reasoning .reason-steps{display:flex;flex-direction:column;gap:.15rem}.cb-reasoning .rstep{display:flex;align-items:center;gap:.4rem;padding:.15rem 0}.cb-reasoning .rstep .rcheck{width:14px;height:14px;border-radius:50%;background:rgba(16,185,129,.15);color:#10b981;display:flex;align-items:center;justify-content:center;font-size:.55rem;flex-shrink:0}.cb-reasoning .rstep .rtext{font-size:.7rem;color:var(--text);opacity:.85}.cb-reasoning .rstep .rtag{font-size:.6rem;padding:.05rem .3rem;border-radius:.3rem;background:rgba(14,165,233,.1);color:#0ea5e9;margin-left:.2rem}
.cb-reasoning .step{padding:.2rem 0;display:flex;align-items:flex-start;gap:.4rem}
.cb-reasoning .step-num{color:#0ea5e9;font-weight:700;min-width:16px}
.cb-reasoning .step-text{color:var(--text);opacity:.8}
/* Follow-up Suggestions */
.cb-followups{display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.5rem;padding:.4rem 0}
.cb-followup{padding:.3rem .6rem;background:rgba(14,165,233,.1);border:1px solid rgba(14,165,233,.2);border-radius:1rem;font-size:.72rem;color:var(--accent);cursor:pointer;transition:all .2s}
.cb-followup:hover{background:rgba(14,165,233,.2);border-color:var(--accent)}
/* Learning Badge */
.cb-learn-badge{display:inline-flex;align-items:center;gap:.3rem;padding:.15rem .5rem;background:rgba(168,85,247,.1);border:1px solid rgba(168,85,247,.2);border-radius:1rem;font-size:.65rem;color:#a855f7;margin-top:.3rem}
.cb-learn-badge i{font-size:.6rem}
/* Conversation History Badge */
.cb-history-count{font-size:.65rem;color:var(--muted);text-align:center;padding:.2rem}


/* Emergency Hotline Ticker */
.hotline-ticker{width:100%;background:linear-gradient(90deg,#ef4444,#dc2626);color:#fff;padding:6px 0;overflow:hidden;white-space:nowrap;position:fixed;top:0;left:0;z-index:10001;font-size:12px;font-weight:600;letter-spacing:.5px}
.hotline-ticker .ticker-content{display:inline-block;animation:ticker 45s linear infinite}
.hotline-ticker .ticker-item{display:inline-block;padding:0 2rem}
.hotline-ticker .ticker-item a{color:#fff;text-decoration:none;transition:opacity .2s}
.hotline-ticker .ticker-item a:hover{opacity:.8;text-decoration:underline}
.hotline-ticker .ticker-dot{display:inline-block;width:5px;height:5px;background:#fbbf24;border-radius:50%;margin:0 .6rem;vertical-align:middle}
@keyframes ticker{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
body{padding-top:80px}
body.light .hotline-ticker{background:linear-gradient(90deg,#dc2626,#b91c1c)}

.timeline-section{padding:5rem 0;background:linear-gradient(135deg,rgba(239,68,68,.06),rgba(236,72,153,.06))}.timeline-header{text-align:center;margin-bottom:3rem}.timeline-header .section-tag{color:#ef4444;font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:2px;margin-bottom:.5rem}.timeline-header h2{font-size:2.2rem;font-weight:800;background:linear-gradient(135deg,#ef4444,#ec4899,#f59e0b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:.5rem}.timeline-header p{color:var(--muted);max-width:600px;margin:0 auto}.timeline-stats{display:flex;justify-content:center;gap:2rem;flex-wrap:wrap;margin-bottom:3rem}.timeline-stat{text-align:center;padding:1rem 1.5rem;background:var(--card);border:1px solid var(--border);border-radius:1rem;min-width:120px}.timeline-stat .ts-num{font-size:1.8rem;font-weight:800;color:#ef4444}.timeline-stat .ts-label{font-size:.75rem;color:var(--muted);margin-top:.2rem}.timeline-container{position:relative;max-width:900px;margin:0 auto;padding:2rem 0}.timeline-line{position:absolute;left:50%;top:0;bottom:0;width:3px;background:linear-gradient(to bottom,#ef4444,#ec4899,#f59e0b,#10b981);transform:translateX(-50%);border-radius:2px}.timeline-item{position:relative;display:flex;align-items:flex-start;margin-bottom:2rem;opacity:0;transform:translateY(30px);transition:all .6s ease}.timeline-item.visible{opacity:1;transform:translateY(0)}.timeline-item:nth-child(odd){flex-direction:row;padding-right:calc(50% + 30px);text-align:right}.timeline-item:nth-child(even){flex-direction:row-reverse;padding-left:calc(50% + 30px);text-align:left}.timeline-dot{position:absolute;left:50%;transform:translateX(-50%);width:20px;height:20px;border-radius:50%;border:3px solid;background:var(--bg);z-index:2;transition:all .3s ease}.timeline-dot:hover{transform:translateX(-50%) scale(1.5);box-shadow:0 0 20px rgba(239,68,68,.5)}.timeline-dot.phase-1{border-color:#ef4444}.timeline-dot.phase-2{border-color:#f59e0b}.timeline-dot.phase-3{border-color:#ec4899}.timeline-dot.phase-4{border-color:#10b981}.timeline-content{background:var(--card);border:1px solid var(--border);border-radius:1rem;padding:1.2rem;max-width:380px;transition:all .3s ease;cursor:pointer}.timeline-content:hover{border-color:rgba(239,68,68,.3);box-shadow:0 4px 20px rgba(239,68,68,.1);transform:translateY(-2px)}.timeline-date{font-size:.8rem;font-weight:700;color:#ef4444;margin-bottom:.3rem;display:inline-block;padding:.15rem .6rem;background:rgba(239,68,68,.1);border-radius:1rem}.timeline-content h4{font-size:1rem;font-weight:700;margin-bottom:.3rem}.timeline-content p{font-size:.85rem;color:var(--muted);line-height:1.5;margin-bottom:.3rem}@media(max-width:768px){.timeline-line{left:20px}.timeline-item:nth-child(odd),.timeline-item:nth-child(even){flex-direction:row;padding-left:50px;padding-right:0;text-align:left}.timeline-dot{left:20px}.timeline-content{max-width:100%}}</style>
</head><body>
