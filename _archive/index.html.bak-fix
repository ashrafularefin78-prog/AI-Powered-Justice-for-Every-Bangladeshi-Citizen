    body.light #paradigm-shifts .fcard p,body.light #ultra-tech .fcard p,body.light #predictive-justice .fcard p,body.light #posthuman-rights .fcard p,body.light #reality-interventions .fcard p,body.light #telepathic-interfaces .fcard p,body.light #cosmic-governance .fcard p,body.light #self-evolving-justice .fcard p,body.light #transcendent-ux .fcard p,body.light #transcendent-timeline .fcard p,body.light #existential-ethics .fcard p{color:#475569}
    body.light #paradigm-shifts,body.light #reality-interventions,body.light #telepathic-interfaces,body.light #cosmic-governance,body.light #self-evolving-justice,body.light #transcendent-ux,body.light #transcendent-timeline{background:linear-gradient(135deg,rgba(168,85,247,.03),rgba(14,165,233,.03))}
