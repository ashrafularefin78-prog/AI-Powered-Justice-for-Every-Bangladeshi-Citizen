    body.light #absolute-dissolution .fcard h3,body.light #justice-principle .fcard h3,body.light #generative-matrix .fcard h3,body.light #end-victimhood .fcard h3,body.light #transcend-transcendence .fcard h3,body.light #being-itself .fcard h3,body.light #architecture-impossible .fcard h3,body.light #path-beyond .fcard h3{color:#1e293b}
    body.light #absolute-dissolution .fcard p,body.light #justice-principle .fcard p,body.light #generative-matrix .fcard p,body.light #end-victimhood .fcard p,body.light #transcend-transcendence .fcard p,body.light #being-itself .fcard p,body.light #architecture-impossible .fcard p,body.light #path-beyond .fcard p{color:#475569}
    body.light #absolute-dissolution,body.light #justice-principle,body.light #generative-matrix,body.light #end-victimhood,body.light #transcend-transcendence,body.light #being-itself,body.light #architecture-impossible,body.light #path-beyond{background:#f8fafc}
