  'মুক্তিযুদ্ধ':'liberation war','মুক্তিযুদ্ধ ১৯৭১':'liberation war',
  'স্বাধীনতা':'independence','স্বাধীনতা দিবস':'independence',
  'বাংলাদেশ':'bangladesh','গণপ্রজাতন্ত্রী':'republic',
  'সংবিধান কবে':'constitution date','সংবিধান কী':'what is constitution',
  'প্রধানমন্ত্রী':'prime minister','রাষ্ট্রপতি':'president',
  'বিচারপতি':'chief justice','সুপ্রিম কোর্ট':'supreme court',
  'হাই কোর্ট':'high court','জেলা আদালত':'district court',
  'গ্রাম আদালত':'village court','আপিল':'appeal'
};
function sendMsg(){var i=document.getElementById('chatIn');var m=i.value.trim();if(!m)return;var d=document.createElement('div');d.className='cb-msg user';d.textContent=m;document.getElementById('chatMsgs').appendChild(d);document.getElementById('chatMsgs').scrollTop=99999;i.value='';/* Bengali to English translation */var ml=m.toLowerCase();var mk='';for(var bk in bnMap){if(ml.indexOf(bk)!==-1&&bk.length>mk.length){mk=bk;}}if(mk){m=bnMap[mk]+' '+m;}processMessage(m);}
function addM(t,y){var d=document.createElement('div');d.className='cb-msg '+y;d.textContent=t;document.getElementById('chatMsgs').appendChild(d);document.getElementById('chatMsgs').scrollTop=99999;}
function processMessage(msg){var a=AEngine.claude.analyze(msg);AEngine.claude.showThinking(function(ms){var l=msg.toLowerCase();var r='';var mk='';for(var k in cR){if(l.indexOf(k)!==-1){r=cR[k];mk=k;break;}}if(!r){var ba='';var bl=0;for(var ak in aliasMap){if(l.indexOf(ak)!==-1&&ak.length>bl){bl=ak.length;ba=ak;}}if(ba){r=cR[aliasMap[ba]];mk=aliasMap[ba];}}if(!r){r='I can help: Legal, Constitution, Courts, Rights. Call 16430.';}var g=AEngine.grok.getGreeting();var p=AEngine.hermes.getProfile();r=AEngine.hermes.adaptResponse(r,p);var full=g+r;var rh=AEngine.claude.buildReasoningBlock(a);var fu=AEngine.grok.getFollowups(mk);var fh='<div class="cb-followups">';fu.forEach(function(f){fh+='<span class="cb-followup">'+f+'</span>';});fh+='</div>';var lb=AEngine.hermes.buildLearnBadge(p);var d=document.createElement('div');d.className='cb-msg bot';d.innerHTML=(rh?rh:'')+full+fh+lb;document.getElementById('chatMsgs').appendChild(d);document.getElementById('chatMsgs').scrollTop=99999;AEngine.hermes.learn(msg,mk);AEngine.history.push({q:msg,a:full,key:mk,time:Date.now()});});}

