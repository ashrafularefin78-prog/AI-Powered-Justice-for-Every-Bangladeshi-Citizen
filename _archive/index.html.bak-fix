    body.light #absolute-conclusion p{color:#1e293b}


    body.light #agent-swarm .fcard,body.light #reasoning-engine .fcard,body.light #agent-comm .fcard,body.light #collective-intel .fcard,body.light #agent-evolution .fcard{background:#fff;border-color:#e2e8f0}
    body.light #agent-swarm .fcard h3,body.light #reasoning-engine .fcard h3,body.light #agent-comm .fcard h3,body.light #collective-intel .fcard h3,body.light #agent-evolution .fcard h3{color:#1e293b}
    body.light #agent-swarm .fcard p,body.light #reasoning-engine .fcard p,body.light #agent-comm .fcard p,body.light #collective-intel .fcard p,body.light #agent-evolution .fcard p{color:#475569}
