eal" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:20px;transition:all 0.3s;cursor:pointer;width:250px;text-align:center;" onmouseover="this.style.transform="translateY(-4px)";this.style.borderColor="rgba(247,146,30,0.5)"" onmouseout="this.style.transform="";this.style.borderColor="rgba(255,255,255,0.08)""><div style="width:50px;height:50px;border-radius:12px;background:linear-gradient(135deg,rgba(247,146,30,0.2),rgba(247,146,30,0.1));display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;color:#fff;margin:0 auto 10px;">BL</div><h3 style="color:#fff;font-size:16px;margin:0 0 4px;">Blockchain</h3><p style="color:rgba(255,255,255,0.5);font-size:13px;margin:0;">Solidity, Smart Contracts, DeFi</p></div><div class="scroll-reveal" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:20px;transition:all 0.3s;cursor:pointer;width:250px;text-align:center;" onmouseover="this.style.transform="translateY(-4px)";this.style.borderColor="rgba(0,170,255,0.5)"" onmouseout="this.style.transform="";this.style.borderColor="rgba(255,255,255,0.08)""><div style="width:50px;height:50px;border-radius:12px;background:linear-gradient(135deg,rgba(0,170,255,0.2),rgba(0,170,255,0.1));display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;color:#fff;margin:0 auto 10px;">WD</div><h3 style="color:#fff;font-size:16px;margin:0 0 4px;">Web Dev</h3><p style="color:rgba(255,255,255,0.5);font-size:13px;margin:0;">HTML/CSS, PHP, SQL, Docker, CI/CD</p></div></div><div style="text-align:center;"><button onclick="document.querySelector(".chatbot-fab").click();setTimeout(function(){document.getElementById("chatIn").value="Help me learn programming";sendMsg();},500);" style="background:linear-gradient(135deg,#00ff88,#00ccff);color:#000;border:none;padding:14px 36px;border-radius:50px;font-size:15px;font-weight:700;cursor:pointer;">Sta