er-events="none">Jhalokati</text><rect x="374" y="346" width="48" height="38" rx="6" fill="#f97316" fill-opacity="0.2" stroke="#f97316" stroke-width="1.5" class="map-district" data-name="Barishal" data-div="Barishal" onclick="showDistrict('Barishal','Barishal')" style="cursor:pointer;transition:all .2s"/><text x="398" y="369" text-anchor="middle" fill="#f97316" font-size="8" font-weight="600" pointer-events="none">Barishal</text><rect x="322" y="388" width="48" height="38" rx="6" fill="#f97316" fill-opacity="0.2" stroke="#f97316" stroke-width="1.5" class="map-district" data-name="Patuakhali" data-div="Barishal" onclick="showDistrict('Patuakhali','Barishal')" style="cursor:pointer;transition:all .2s"/><text x="346" y="411" text-anchor="middle" fill="#f97316" font-size="8" font-weight="600" pointer-events="none">Patuakhali</text><rect x="374" y="388" width="48" height="38" rx="6" fill="#f97316" fill-opacity="0.2" stroke="#f97316" stroke-width="1.5" class="map-district" data-name="Barguna" data-div="Barishal" onclick="showDistrict('Barguna','Barishal')" style="cursor:pointer;transition:all .2s"/><text x="398" y="411" text-anchor="middle" fill="#f97316" font-size="8" font-weight="600" pointer-events="none">Barguna</text><rect x="426" y="388" width="48" height="38" rx="6" fill="#f97316" fill-opacity="0.2" stroke="#f97316" stroke-width="1.5" class="map-district" data-name="Bhola" data-div="Barishal" onclick="showDistrict('Bhola','Barishal')" style="cursor:pointer;transition:all .2s"/><text x="450" y="411" text-anchor="middle" fill="#f97316" font-size="8" font-weight="600" pointer-events="none">Bhola</text></svg></div></section><div id="districtModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.7);z-index:10000;backdrop-filter:blur(5px)" onclick="if(event.target===this)closeDistrictModal()"><div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#0f172a;border:1px solid rgba(255,255,255,.1);border-radius:1rem;padding:2rem;max-width:500px;width:90%;max-height:80vh;overflow-y:auto"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem"><h3 id="dmTitle" style="margin:0;color:#fff;font-size:1.3rem"></h3><button onclick="closeDistrictModal()" style="background:none;border:none;color:rgba(255,255,255,.5);font-size:1.5rem;cursor:pointer">&times;</button></div><div id="dmContent"></div></div></div><script>
var di={'Dhaka':{court:'Dhaka District Court, Judge Court Road | সুপ্রিম কোর্ট, জেলা আদালত (৬৪), গ্রাম আদালত, মোবাইল আদালত। আইনি সাহায্য: ১৬৪৩০',legal:'Legal Aid: 16430',police:'DMP: 999 | পুলিশ আইন ২০১৮। জরুরি: ৯৯৯',emergency:'999, 333, 109, 16699 | ৯৯৯, ১০৯, ৩৩৩, ১৬৪৩০',land:'Smart Land: 16122 | ভূমি মন্ত্রণালয়, জেলা, উপজেলা, ইউনিয়ন ভূমি অফিস। ডিজিটাইজড'},'Chattogram':{court:'Chattogram District Court, Khamarbari',legal:'Legal Aid: 16430',police:'CMP: 999',emergency:'999, 333, 109, 16699',land:'Smart Land: 16122'},'Gazipur':{court:'Gazipur District Court',legal:'Legal Aid: 16430',police:'GMP: 999',emergency:'999, 333, 109, 16699'},'Narayanganj':{court:'Narayanganj District Court',legal:'Legal Aid: 16430',police:'NMP: 999',emergency:'999, 333, 109, 16699'},'Comilla':{court:'Comilla District Court',legal:'Legal Aid: 16430',police:'999',emergency:'999, 333, 109, 16699'},'Coxs Bazar':{court:"Cox's Bazar District Court",legal:'Legal Aid: 16430',police:'999',emergency:'999, 333, 16699'},'Khulna':{court:'Khulna District Court',legal:'Legal Aid: 16430',police:'KMP: 999',emergency:'999, 333, 109, 16699'},'Rajshahi':{court:'Rajshahi District Court',legal:'Legal Aid: 16430',police:'RMP: 999',emergency:'999, 333, 109, 16699'},'Sylhet':{court:'Sylhet District Court',legal:'Legal Aid: 16430',police:'SMP: 999',emergency:'999, 333, 109, 16699'},'Rangpur':{court:'Rangpur District Court',legal:'Legal Aid: 16430',police:'999',emergency:'999, 333, 109, 16699'},'Barishal':{court:'Barishal District Court',legal:'Legal Aid: 16430',police:'999',emergency:'999, 333, 109, 16699'},'Mymensingh':{court:'Mymensingh District Court',legal:'Legal Aid: 16430',police:'999',emergency:'999, 333, 109, 16699'}};
function showDistrict(n,d){var info=di[n]||{};var dc={'Rangpur':'rgba(14,165,233,.2);color:#0ea5e9','Rajshahi':'rgba(99,102,241,.2);color:#6366f1','Mymensingh':'rgba(16,185,129,.2);color:#10b981','Dhaka':'rgba(245,158,11,.2);color:#f59e0b','Chattogram':'rgba(236,72,153,.2);color:#ec4899','Sylhet':'rgba(139,92,246,.2);color:#8b5cf6','Khulna':'rgba(20,184,166,.2);color:#14b8a6','Barishal':'rgba(249,115,22,.2);color:#f97316'};var h='<div style="margin-bottom:1rem"><span style="display:inline-block;padding:.2rem .6rem;border-radius:1rem;font-size:.75rem;font-weight:600;background:'+(dc[d]||'rgba(255,255,255,.1);color:#fff')+'">'+d+' Division</span></div>';if(info.court)h+='<div style="margin-bottom:.8rem"><div style="color:#0ea5e9;font-weight:600;font-size:.85rem"><i class="fas fa-landmark"></i> District Court</div><p style="font-size:.8rem;color:rgba(255,255,255,.7);margin:.2rem 0 0">'+info.court+'</p></div>';if(info.legal)h+='<div style="margin-bottom:.8rem"><div style="color:#10b981;font-weight:600;font-size:.85rem"><i class="fas fa-gavel"></i> Legal Aid</div><p style="font-size:.8rem;color:rgba(255,255,255,.7);margin:.2rem 0 0">'+info.legal+'</p></div>';h+='<div style="margin-bottom:.8rem"><div style="color:#f59e0b;font-weight:600;font-size:.85rem"><i class="fas fa-phone"></i> Emergency</div><p style="font-size:.8rem;color:rgba(255,255,255,.7);margin:.2rem 0 0">'+(info.emergency||'999, 333, 109, 16699')+'</p></div>';if(info.land)h+='<div><div style="color:#8b5cf6;font-weight:600;font-size:.85rem"><i class="fas fa-map"></i> Land Service</div><p style="font-size:.8rem;color:rgba(255,255,255,.7);margin:.2rem 0 0">'+info.land+'</p></div>';h+='<div style="margin-top:1rem;padding:.8rem;background:rgba(255,255,255,.05);border-radius:.5rem"><p style="font-size:.75rem;color:rgba(255,255,255,.5);margin:0">A ai provides AI legal assistance for all 64 districts. Call 16430 for free legal aid.</p></div>';document.getElementById('dmTitle').textContent=n+' District';document.getElementById('dmContent').innerHTML=h;document.getElementById('districtModal').style.display='flex';}
function closeDistrictModal(){document.getElementById('districtModal').style.display='none';}
</script>
<section class="timeline-section" id="july-timeline"><div class="container"><div class="timeline-header"><div class="section-tag">July 2024 Uprising</div><h2>The People's Revolution</h2><p>36 days that changed Bangladesh forever.</p></div><div class="timeline-stats"><div class="timeline-stat"><div class="ts-num">36</div><div class="ts-label">Days of Revolution</div></div><div class="timeline-stat"><div class="ts-num" style="color:#f59e0b">1,400+</div><div class="ts-label">Lives Lost (UN)</div></div><div class="timeline-stat"><div class="ts-num" style="color:#ec4899">25,000+</div><div class="ts-label">Injured</div></div><div class="timeline-stat"><div class="ts-num" style="color:#10b981">Aug 5</div><div class="ts-label">Regime Fell</div></div></div><div class="timeline-container"><div class="timeline-line"></div><div class="timeline-item"><div class="timeline-dot phase-1"></div><div class="timeline-content"><div class="timeline-date" style="background:rgba(239,68,68,.1);color:#ef4444">June 5, 2024</div><h4>High Court Reinstates 30% Quota</h4><p>HC reinstates 30% reservation for freedom fighters descendants.</p></div></div><div class="timeline-item"><div class="timeline-dot phase-1"></div><div class="timeline-content"><div class="timeline-date" style="background:rgba(239,68,68,.1);color:#ef4444">July 1, 2024</div><h4>Dhaka University Protests Begin</h4><p>Students launch class boycotts and sit-ins at campuses.</p></div></div><div class="timeline-item"><div class="timeline-dot phase-1"></div><div class="timeline-content"><div class="timeline-date" style="background:rgba(239,68,68,.1);color:#ef4444">July 7, 2024</div><h4>Bangla Blockade</h4><p>Nationwide roads and railways blocked. First major escalation.</p></div></div><div class="timeline-item"><div class="timeline-dot phase-1"></div><div class="timeline-content"><div class="timeline-date" style="background:rgba(239,68,68,.1);color:#ef4444">July 14, 2024</div><h4>Hasina Calls Protesters Razakars</h4><p>PM labels students as Razakars, fueling outrage.</p></div></div><div class="timeline-item"><div class="timeline-dot phase-2"></div><div class="timeline-content"><div class="timeline-date" style="background:rgba(245,158,11,.1);color:#f59e0b">July 15, 2024</div><h4>BCL Attacks Students</h4><p>Chhatra League attacks at DU. 70+ injured.</p></div></div><div class="timeline-item"><div class="timeline-dot phase-2"></div><div class="timeline-content"><div class="timeline-date" style="background:rgba(245,158,11,.1);color:#f59e0b">July 16, 2024</div><h4>Abu Sayed Killed - First Martyr</h4><p>22yo shot dead in Rangpur. Viral video galvanizes nation.</p></div></div><div class="timeline-item"><div class="timeline-dot phase-2"></div><div class="timeline-content"><div class="timeline-date" style="background:rgba(245,158,11,.1);color:#f59e0b">July 18, 2024</div><h4>Internet Blackout</h4><p>11-day mobile data blackout. 27 killed.</p></div></div><div class="timeline-item"><div class="timeline-dot phase-2"></div><div class="timeline-content"><div class="timeline-date" style="background:rgba(245,158,11,.1);color:#f59e0b">July 19, 2024</div><h4>Genocide Day - 100+ Killed</h4><p>Mass shootings. Indefinite curfew imposed.</p></div></div><div class="timeline-item"><div class="timeline-dot phase-3"></div><div class="timeline-content"><div class="timeline-date" style="background:rgba(236,72,153,.1);color:#ec4899">July 21, 2024</div><h4>Supreme Court Reduces Quota to 7%</h4><p>93% merit-based. Protests continue.</p></div></div><div class="timeline-item"><div class="timeline-dot phase-3"></div><div class="timeline-content"><div class="timeline-date" style="background:rgba(236,72,153,.1);color:#ec4899">July 25, 2024</div><h4>Hasina Speaks from Vandalized Metro</h4><p>PM addresses nation from damaged station.</p></div></div><div class="timeline-item"><div class="timeline-dot phase-3"></div><div class="timeline-content"><div class="timeline-date" style="background:rgba(236,72,153,.1);color:#ec4899">Aug 4, 2024</div><h4>Deadliest Day - 90 Killed</h4><p>Non-cooperation. Long March called.</p></div></div><div class="timeline-item"><div class="timeline-dot phase-4"></div><div class="timeline-content"><div class="timeline-date" style="background:rgba(16,185,129,.1);color:#10b981">August 5, 2024</div><h4>Hasina Resigns and Flees</h4><p>2:25 PM: Army refuses. Ganabhaban stormed. Regime ends.</p></div></div><div class="timeline-item"><div class="timeline-dot phase-4"></div><div class="timeline-content"><div class="timeline-date" style="background:rgba(16,185,129,.1);color:#10b981">August 8, 2024</div><h4>Interim Govt Under Muhammad Yunus</h4><p>Nobel laureate sworn in. New era begins.</p></div></div></div></div></section><section id="govt-structure" style="background:linear-gradient(135deg,rgba(14,165,233,.06),rgba(99,102,241,.06))"><div class="container"><div class="section-header"><div class="section-tag">Government of Bangladesh</div><h2>National Government Structure</h2><p>57 Ministries and Divisions, 76 Directorates, and 8 Administrative Divisions serving 170 million citizens.</p></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;margin-bottom:2rem"><div style="text-align:center;padding:1.2rem;background:var(--card);border:1px solid var(--border);border-radius:1rem"><div style="font-size:2rem;font-weight:800;color:#0ea5e9">57</div><div style="font-size:.8rem;color:var(--muted);margin-top:.2rem">Ministries and Divisions</div></div><div style="text-align:center;padding:1.2rem;background:var(--card);border:1px solid var(--border);border-radius:1rem"><div style="font-size:2rem;font-weight:800;color:#6366f1">76</div><div style="font-size:.8rem;color:var(--muted);margin-top:.2rem">Directorates</div></div><div style="text-align:center;padding:1.2rem;background:var(--card);border:1px solid var(--border);border-radius:1rem"><div style="font-size:2rem;font-weight:800;color:#10b981">8</div><div style="font-size:.8rem;color:var(--muted);margin-top:.2rem">Divisions</div></div><div style="text-align:center;padding:1.2rem;background:var(--card);border:1px solid var(--border);border-radius:1rem"><div style="font-size:2rem;font-weight:800;color:#f59e0b">64</div><div style="font-size:.8rem;color:var(--muted);margin-top:.2rem">Districts</div></div><div style="text-align:center;padding:1.2rem;background:var(--card);border:1px solid var(--border);border-radius:1rem"><div style="font-size:2rem;font-weight:800;color:#ec4899">350</div><div style="font-size:.8rem;color:var(--muted);margin-top:.2rem">Parliament Seats</div></div></div><h3 style="font-size:1.1rem;font-weight:700;margin-bottom:.5rem"><i class="fas fa-building" style="color:#0ea5e9;margin-right:.4rem"></i> Key Ministries</h3><div class="govt-struct-grid"><div class="govt-ministry-card reveal rd0"><div class="gmc-icon" style="background:#0ea5e922;color:#0ea5e9"><i class="fas fa-balance-scale"></i></div><h4>Law, Justice and Parliamentary Affairs</h4><p>Manages legal system, courts, and justice delivery</p></div><div class="govt-ministry-card reveal rd1"><div class="gmc-icon" style="background:#ef444422;color:#ef4444"><i class="fas fa-shield-alt"></i></div><h4>Home Affairs</h4><p>Police, fire service, civil defence, NID</p></div><div class="govt-ministry-card reveal rd2"><div class="gmc-icon" style="background:#10b98122;color:#10b981"><i class="fas fa-coins"></i></div><h4>Finance Division</h4><p>National budget, taxation, economic policy</p></div><div class="govt-ministry-card reveal rd3"><div class="gmc-icon" style="background:#f59e0b22;color:#f59e0b"><i class="fas fa-city"></i></div><h4>Local Government Division</h4><p>Upazila, Union Parishad, municipal governance</p></div><div class="govt-ministry-card reveal rd4"><div class="gmc-icon" style="background:#6366f122;color:#6366f1"><i class="fas fa-laptop-code"></i></div><h4>ICT Division</h4><p>Digital Bangladesh, a2i Programme, e-Gov</p></div><div class="govt-ministry-card reveal rd5"><div class="gmc-icon" style="background:#ec489922;color:#ec4899"><i class="fas fa-graduation-cap"></i></div><h4>Education Ministry</h4><p>Primary, secondary, and higher education</p></div><div class="govt-ministry-card reveal rd0"><div class="gmc-icon" style="background:#a855f722;color:#a855f7"><i class="fas fa-heartbeat"></i></div><h4>Health and Family Welfare</h4><p>Public health, hospitals, medical education</p></div><div class="govt-ministry-card reveal rd1"><div class="gmc-icon" style="background:#14b8a622;color:#14b8a6"><i class="fas fa-tractor"></i></div><h4>Agriculture Ministry</h4><p>Farming, food security, rural development</p></div><div class="govt-ministry-card reveal rd2"><div class="gmc-icon" style="background:#f9731622;color:#f97316"><i class="fas fa-briefcase"></i></div><h4>Labour and Employment</h4><p>Workers rights, employment programs, safety</p></div><div class="govt-ministry-card reveal rd3"><div class="gmc-icon" style="background:#8b5cf622;color:#8b5cf6"><i class="fas fa-users"></i></div><h4>Women and Children Affairs</h4><p>Gender equality, child protection, GBV</p></div><div class="govt-ministry-card reveal rd4"><div class="gmc-icon" style="background:#0ea5e922;color:#0ea5e9"><i class="fas fa-globe-asia"></i></div><h4>Foreign Affairs</h4><p>Diplomacy, international relations, treaties</p></div><div class="govt-ministry-card reveal rd5"><div class="gmc-icon" style="background:#10b98122;color:#10b981"><i class="fas fa-bolt"></i></div><h4>Power, Energy and Mineral Resources</h4><p>Electricity, gas, renewable energy</p></div></div><h3 style="font-size:1.1rem;font-weight:700;margin:2rem 0 .5rem"><i class="fas fa-sitemap" style="color:#6366f1;margin-right:.4rem"></i> Key Directorates</h3><div class="govt-struct-grid"><div class="govt-ministry-card reveal rd0"><div class="gmc-icon" style="background:#ef444422;color:#ef4444"><i class="fas fa-shield-alt"></i></div><h4>DGFI</h4><p>Military intelligence agency</p></div><div class="govt-ministry-card reveal rd1"><div class="gmc-icon" style="background:#0ea5e922;color:#0ea5e9"><i class="fas fa-gavel"></i></div><h4>Anti-Corruption Commission (ACC)</h4><p>Investigates and prosecutes corruption</p></div><div class="govt-ministry-card reveal rd2"><div class="gmc-icon" style="background:#10b98122;color:#10b981"><i class="fas fa-file-alt"></i></div><h4>Right to Information Commission</h4><p>Enforces RTI Act 2009, transparency</p></div><div class="govt-ministry-card reveal rd3"><div class="gmc-icon" style="background:#f59e0b22;color:#f59e0b"><i class="fas fa-graduation-cap"></i></div><h4>Public Administration Training Centre</h4><p>Trains government officers nationwide</p></div><div class="govt-ministry-card reveal rd4"><div class="gmc-icon" style="background:#6366f122;color:#6366f1"><i class="fas fa-id-card"></i></div><h4>Bangladesh Public Service Commission</h4><p>BCS recruitment, 26 cadre services</p></div><div class="govt-ministry-card reveal rd5"><div class="gmc-icon" style="background:#ec489922;color:#ec4899"><i class="fas fa-laptop"></i></div><h4>a2i Programme</h4><p>5000+ UDCs, e-GP, digital services</p></div><div class="govt-ministry-card reveal rd0"><div class="gmc-icon" style="background:#f9731622;color:#f97316"><i class="fas fa-map-marked-alt"></i></div><h4>Land Ministry and Records</h4><p>Land registry, mutation, khatian</p></div><div class="govt-ministry-card reveal rd1"><div class="gmc-icon" style="background:#14b8a622;color:#14b8a6"><i class="fas fa-school"></i></div><h4>Directorate of Primary Education</h4><p>40000+ primary schools</p></div></div><h3 style="font-size:1.1rem;font-weight:700;margin:2rem 0 .5rem"><i class="fas fa-map" style="color:#10b981;margin-right:.4rem"></i> 8 Administrative Divisions</h3><div class="div-tabs" id="divTabs"><button class="div-tab active" onclick="showDivTab(0)">Dhaka</button><button class="div-tab" onclick="showDivTab(1)">Chattogram</button><button class="div-tab" onclick="showDivTab(2)">Rajshahi</button><button class="div-tab" onclick="showDivTab(3)">Rangpur</button><button class="div-tab" onclick="showDivTab(4)">Khulna</button><button class="div-tab" onclick="showDivTab(5)">Barishal</button><button class="div-tab" onclick="showDivTab(6)">Sylhet</button><button class="div-tab" onclick="showDivTab(7)">Mymensingh</button></div><div class="div-content active" id="divContent0"><h4>Dhaka Division (Population: 4.2 crore)</h4><div class="div-districts"><span>Dhaka</span><span>Faridpur</span><span>Gazipur</span><span>Gopalganj</span><span>Kishoreganj</span><span>Madaripur</span><span>Manikganj</span><span>Munshiganj</span><span>Narayanganj</span><span>Narsingdi</span><span>Rajbari</span><span>Shariatpur</span><span>Tangail</span></div></div><div class="div-content" id="divContent1"><h4>Chattogram Division (Population: 3.4 crore)</h4><div class="div-districts"><span>Chattogram</span><span>Bandarban</span><span>Brahmanbaria</span><span>Chandpur</span><span>Comilla</span><span>Coxsbazar</span><span>Feni</span><span>Khagrachhari</span><span>Lakshmipur</span><span>Noakhali</span><span>Rangamati</span></div></div><div class="div-content" id="divContent2"><h4>Rajshahi Division (Population: 2.0 crore)</h4><div class="div-districts"><span>Rajshahi</span><span>Bogura</span><span>Chapainawabganj</span><span>Joypurhat</span><span>Naogaon</span><span>Natore</span><span>Nawabganj</span><span>Pabna</span><span>Sirajganj</span></div></div><div class="div-content" id="divContent3"><h4>Rangpur Division (Population: 1.7 crore)</h4><div class="div-districts"><span>Rangpur</span><span>Dinajpur</span><span>Gaibandha</span><span>Kurigram</span><span>Lalmonirhat</span><span>Nilphamari</span><span>Panchagarh</span><span>Thakurgaon</span></div></div><div class="div-content" id="divContent4"><h4>Khulna Division (Population: 1.8 crore)</h4><div class="div-districts"><span>Khulna</span><span>Bagerhat</span><span>Chuadanga</span><span>Jessore</span><span>Jhenaidah</span><span>Kushtia</span><span>Magura</span><span>Meherpur</span><span>Narail</span><span>Satkhira</span></div></div><div class="div-content" id="divContent5"><h4>Barishal Division (Population: 0.9 crore)</h4><div class="div-districts"><span>Barishal</span><span>Barguna</span><span>Bhola</span><span>Jhalokathi</span><span>Patuakhali</span><span>Pirojpur</span></div></div><div class="div-content" id="divContent6"><h4>Sylhet Division (Population: 1.0 crore)</h4><div class="div-districts"><span>Sylhet</span><span>Habiganj</span><span>Moulvibazar</span><span>Sunamganj</span></div></div><div class="div-content" id="divContent7"><h4>Mymensingh Division (Population: 1.2 crore)</h4><div class="div-districts"><span>Mymensingh</span><span>Jamalpur</span><span>Netrokona</span><span>Sherpur</span></div></div></div></section>
<section id="emergency-helplines" style="background:linear-gradient(135deg,rgba(239,68,68,.06),rgba(236,72,153,.06))"><div class="container"><div class="section-header"><div class="section-tag" style="color:#ef4444">Emergency Services</div><h2>Emergency Helplines</h2><p>Save these numbers. Help is one call away across all 64 districts of Bangladesh.</p></div><div class="helpline-grid"><div class="helpline-card reveal rd0"><div class="hl-icon" style="background:#ef444422;color:#ef4444"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>National Emergency</h4><p>Fire, Ambulance, Civil Defence</p></div><div class="hl-number"><a href="tel:999">999</a></div></div><div class="helpline-card reveal rd1"><div class="hl-icon" style="background:#f59e0b22;color:#f59e0b"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Police Emergency</h4><p>Bangladesh Police</p></div><div class="hl-number"><a href="tel:999">999</a></div></div><div class="helpline-card reveal rd2"><div class="hl-icon" style="background:#ec489922;color:#ec4899"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Women Helpline</h4><p>Domestic Violence, GBV</p></div><div class="hl-number"><a href="tel:109">109</a></div></div><div class="helpline-card reveal rd3"><div class="hl-icon" style="background:#10b98122;color:#10b981"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>National Legal Aid</h4><p>Free Legal Aid Service</p></div><div class="hl-number"><a href="tel:16430">16430</a></div></div><div class="helpline-card reveal rd4"><div class="hl-icon" style="background:#6366f122;color:#6366f1"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Anti-Corruption</h4><p>Report Corruption to ACC</p></div><div class="hl-number"><a href="tel:106">106</a></div></div><div class="helpline-card reveal rd5"><div class="hl-icon" style="background:#0ea5e922;color:#0ea5e9"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Information Commission</h4><p>Right to Information</p></div><div class="hl-number"><a href="tel:103">103</a></div></div><div class="helpline-card reveal rd0"><div class="hl-icon" style="background:#8b5cf622;color:#8b5cf6"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Child Helpline</h4><p>Child Abuse, Trafficking</p></div><div class="hl-number"><a href="tel:1098">1098</a></div></div><div class="helpline-card reveal rd1"><div class="hl-icon" style="background:#14b8a622;color:#14b8a6"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Fire Service</h4><p>Bangladesh Fire Service</p></div><div class="hl-number"><a href="tel:102">102</a></div></div><div class="helpline-card reveal rd2"><div class="hl-icon" style="background:#f9731622;color:#f97316"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Ambulance Service</h4><p>National Ambulance</p></div><div class="hl-number"><a href="tel:999">999</a></div></div><div class="helpline-card reveal rd3"><div class="hl-icon" style="background:#a855f722;color:#a855f7"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Health Hotline</h4><p>Health Emergency Info</p></div><div class="hl-number"><a href="tel:16699">16699</a></div></div><div class="helpline-card reveal rd4"><div class="hl-icon" style="background:#0ea5e922;color:#0ea5e9"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Traffic Police</h4><p>Road Accident, Traffic</p></div><div class="hl-number"><a href="tel:1033">1033</a></div></div><div class="helpline-card reveal rd5"><div class="hl-icon" style="background:#ef444422;color:#ef4444"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Disaster Management</h4><p>Cyclone, Flood, Disaster</p></div><div class="hl-number"><a href="tel:16699">16699</a></div></div><div class="helpline-card reveal rd0"><div class="hl-icon" style="background:#10b98122;color:#10b981"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Cyber Crime</h4><p>Report Online Crime</p></div><div class="hl-number"><a href="tel:333">333</a></div></div><div class="helpline-card reveal rd1"><div class="hl-icon" style="background:#f59e0b22;color:#f59e0b"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Anti-Terrorism</h4><p>Report Terrorism Threats</p></div><div class="hl-number"><a href="tel:109">109</a></div></div><div class="helpline-card reveal rd2"><div class="hl-icon" style="background:#6366f122;color:#6366f1"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Electricity Emergency</h4><p>Power Outage, Line Fault</p></div><div class="hl-number"><a href="tel:16999">16999</a></div></div><div class="helpline-card reveal rd3"><div class="hl-icon" style="background:#ec489922;color:#ec4899"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Passport Helpline</h4><p>Passport Services</p></div><div class="hl-number"><a href="tel:16445">16445</a></div></div><div class="helpline-card reveal rd4"><div class="hl-icon" style="background:#8b5cf622;color:#8b5cf6"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Land Service</h4><p>Land Records, Mutation</p></div><div class="hl-number"><a href="tel:16122">16122</a></div></div><div class="helpline-card reveal rd5"><div class="hl-icon" style="background:#14b8a622;color:#14b8a6"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Traffic Helpline</h4><p>BRTA Vehicle Info</p></div><div class="hl-number"><a href="tel:16107">16107</a></div></div><div class="helpline-card reveal rd0"><div class="hl-icon" style="background:#f9731622;color:#f97316"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>Pension Info</h4><p>Universal Pension Scheme</p></div><div class="hl-number"><a href="tel:16131">16131</a></div></div><div class="helpline-card reveal rd1"><div class="hl-icon" style="background:#a855f722;color:#a855f7"><i class="fas fa-phone-alt"></i></div><div class="hl-info"><h4>NID Helpline</h4><p>National ID Services</p></div><div class="hl-number"><a href="tel:16106">16106</a></div></div></div><div style="margin-top:2rem;padding:1.2rem;background:var(--card);border:1px solid var(--border);border-radius:1rem;text-align:center"><p style="font-size:.9rem;color:var(--text);margin:0 0 .3rem;font-weight:600"><i class="fas fa-info-circle" style="color:#0ea5e9;margin-right:.3rem"></i> All Emergency Numbers at a Glance</p><p style="font-size:.8rem;color:var(--muted);margin:0">Dial <strong style="color:#ef4444">999</strong> for Police/Fire/Ambulance | <strong style="color:#10b981">16430</strong> for Legal Aid | <strong style="color:#ec4899">109</strong> for Women Helpline | <strong style="color:#6366f1">333</strong> for Cyber Crime</p></div></div></section>
<section id="memorial" style="padding:100px 0;background:linear-gradient(135deg,#1a0a0a 0%,#2a1a1a 50%,#1a0a2a 100%);position:relative;overflow:hidden;"><div class="container" style="max-width:1000px;margin:0 auto;padding:0 24px;position:relative;z-index:1;"><div style="text-align:center;margin-bottom:40px;"><span style="display:inline-block;background:linear-gradient(135deg,#ff4444,#ff8800);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:700;font-size:13px;letter-spacing:3px;text-transform:uppercase;">IN MEMORY</span></div><h2 style="font-size:clamp(28px,4vw,42px);text-align:center;margin-bottom:8px;">Shaheed <span style="color:#ff6644;">Sharif Osman Bin Hadi</span></h2><p style="text-align:center;color:rgba(255,255,255,0.5);font-size:16px;margin-bottom:40px;">1 January 1993 - 18 December 2025</p><div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;"><div><div style="width:100%;aspect-ratio:3/4;border-radius:20px;background:linear-gradient(135deg,rgba(255,68,68,0.2),rgba(255,136,0,0.2));border:2px solid rgba(255,100,68,0.3);display:flex;align-items:center;justify-content:center;overflow:hidden;"><div style="text-align:center;padding:40px;"><div style="font-size:80px;margin-bottom:16px;">&#9733;</div><div style="color:rgba(255,255,255,0.7);font-size:18px;font-weight:600;">Sharif Osman Bin Hadi</div><div style="color:rgba(255,255,255,0.4);font-size:14px;margin-top:8px;">1993 - 2025</div></div></div></div><div><div style="margin-bottom:24px;"><h3 style="color:#ff6644;font-size:16px;margin:0 0 8px;">FULL NAME</h3><p style="color:#fff;font-size:15px;margin:0;">Sharif Osman Bin Hadi (born Osman Goni)</p></div><div style="margin-bottom:24px;"><h3 style="color:#ff6644;font-size:16px;margin:0 0 8px;">BORN</h3><p style="color:#fff;font-size:15px;margin:0;">1 January 1993, Nalchity, Jhalakathi District</p></div><div style="margin-bottom:24px;"><h3 style="color:#ff6644;font-size:16px;margin:0 0 8px;">FAMILY</h3><p style="color:#fff;font-size:15px;margin:0;">Father: Maulana Abdul Hadi (madrasa teacher)<br>Mother: Taslima Hadi<br>Youngest of 6 siblings</p></div><div style="margin-bottom:24px;"><h3 style="color:#ff6644;font-size:16px;margin:0 0 8px;">EDUCATION</h3><p style="color:#fff;font-size:15px;margin:0;">Jhalakati NS Kamil Madrasa<br>University of Dhaka, Political Science (2010-11)</p></div><div style="margin-bottom:24px;"><h3 style="color:#ff6644;font-size:16px;margin:0 0 8px;">CAREER</h3><p style="color:#fff;font-size:15px;margin:0;">Lecturer, University of Scholars, Dhaka</p></div><div style="margin-bottom:24px;"><h3 style="color:#ff6644;font-size:16px;margin:0 0 8px;">KNOWN FOR</h3><p style="color:#fff;font-size:15px;margin:0;">Co-founder & Spokesperson of Inqilab Moncho<br>July Uprising 2024 Coordinator<br>Anti-hegemony activist & National martyr</p></div><div style="margin-bottom:24px;"><h3 style="color:#ff6644;font-size:16px;margin:0 0 8px;">ASSASSINATION</h3><p style="color:#fff;font-size:15px;margin:0;">Shot Dec 12, 2025 in Paltan, Dhaka<br>Airlifted to Singapore, died Dec 18, 2025</p></div><div style="margin-bottom:24px;"><h3 style="color:#ff6644;font-size:16px;margin:0 0 8px;">RESTING PLACE</h3><p style="color:#fff;font-size:15px;margin:0;">Mausoleum of Kazi Nazrul Islam, Dhaka</p></div></div></div><div style="margin-top:40px;background:rgba(255,100,68,0.05);border:1px solid rgba(255,100,68,0.15);border-radius:16px;padding:30px;text-align:center;"><blockquote style="color:rgba(255,255,255,0.8);font-size:18px;font-style:italic;margin:0 0 12px;line-height:1.6;">For 14-15 years, fascism has been established in Bangladesh. Thousands of Aynaghars have been set up. Our brothers and sisters were shot from helicopters.</blockquote><p style="color:#ff6644;font-size:14px;margin:0;">- Sharif Osman Bin Hadi, 2025</p></div><div style="text-align:center;margin-top:30px;"><p style="color:rgba(255,255,255,0.5);font-size:14px;">Hadi, you are in our hearts forever. - Chief Adviser, Bangladesh</p></div></div></section>
<section id="programming" style="padding:100px 0;background:linear-gradient(135deg,#0a0a2e 0%,#1a1a4e 50%,#0a2a4e 100%);position:relative;overflow:hidden;"><div class="container" style="position:relative;z-index:1;max-width:1200px;margin:0 auto;padding:0 24px;"><div class="section-badge scroll-reveal" style="text-align:center;margin-bottom:20px;"><span style="display:inline-block;background:linear-gradient(135deg,#00ff88,#00ccff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:700;font-size:13px;letter-spacing:3px;text-transform:uppercase;">LEARN &amp; CODE</span></div><h2 class="scroll-reveal" style="font-size:clamp(28px,4vw,42px);text-align:center;margin-bottom:12px;">Programming <span style="color:#00ff88;">Hub</span></h2><p class="scroll-reveal" style="text-align:center;color:rgba(255,255,255,0.6);max-width:600px;margin:0 auto 40px;">Ask A ai about any programming language. From Python to Blockchain.</p><div style="display:flex;flex-wrap:wrap;justify-content:center;gap:16px;margin-bottom:30px;"><div class="scroll-reveal" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:20px;transition:all 0.3s;cursor:pointer;width:250px;text-align:center;" onmouseover="this.style.transform="translateY(-4px)";this.style.borderColor="rgba(55,118,171,0.5)"" onmouseout="this.style.transform="";this.style.borderColor="rgba(255,255,255,0.08)""><div style="width:50px;height:50px;border-radius:12px;background:linear-gradient(135deg,rgba(55,118,171,0.2),rgba(55,118,171,0.1));display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;color:#fff;margin:0 auto 10px;">PY</div><h3 style="color:#fff;font-size:16px;margin:0 0 4px;">Python</h3><p style="color:rgba(255,255,255,0.5);font-size:13px;margin:0;">AI, Data Science, Web, Automation</p></div><div class="scroll-reveal" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:2