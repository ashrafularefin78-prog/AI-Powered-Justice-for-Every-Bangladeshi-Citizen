html{overflow-x:hidden}



.cbx-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:22px;margin-top:2.2rem;align-items:start}
.cbx-card{border-radius:18px;padding:24px;border:1px solid rgba(148,163,184,.18);background:rgba(10,15,28,.6);box-shadow:0 18px 50px rgba(0,0,0,.25)}
html.light .cbx-card{background:rgba(255,255,255,.92);border-color:rgba(15,23,42,.12);box-shadow:0 14px 40px rgba(15,23,42,.08)}
.cbx-ic{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;color:#fff;background:linear-gradient(135deg,#10b981,#22d3ee);margin-bottom:14px}
