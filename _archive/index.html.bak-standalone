.timeline-section{padding:5rem 0;background:linear-gradient(135deg,rgba(239,68,68,.06),rgba(236,72,153,.06))}.timeline-header{text-align:center;margin-bottom:3rem}.timeline-header .section-tag{color:#ef4444;font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:2px;margin-bottom:.5rem}.timeline-header h2{font-size:2.2rem;font-weight:800;background:linear-gradient(135deg,#ef4444,#ec4899,#f59e0b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:.5rem}.timeline-header p{color:var(--muted);max-width:600px;margin:0 auto}.timeline-stats{display:flex;justify-content:center;gap:2rem;flex-wrap:wrap;margin-bottom:3rem}.timeline-stat{text-align:center;padding:1rem 1.5rem;background:var(--card);border:1px solid var(--border);border-radius:1rem;min-width:120px}.timeline-stat .ts-num{font-size:1.8rem;font-weight:800;color:#ef4444}.timeline-stat .ts-label{font-size:.75rem;color:var(--muted);margin-top:.2rem}.timeline-container{position:relative;max-width:900px;margin:0 auto;padding:2rem 0}.timeline-line{position:absolute;left:50%;top:0;bottom:0;width:3px;background:linear-gradient(to bottom,#ef4444,#ec4899,#f59e0b,#10b981);transform:translateX(-50%);border-radius:2px}.timeline-item{position:relative;display:flex;align-items:flex-start;margin-bottom:2rem;opacity:0;transform:translateY(30px);transition:all .6s ease}.timeline-item.visible{opacity:1;transform:translateY(0)}.timeline-item:nth-child(odd){flex-direction:row;padding-right:calc(50% + 30px);text-align:right}.timeline-item:nth-child(even){flex-direction:row-reverse;padding-left:calc(50% + 30px);text-align:left}.timeline-dot{position:absolute;left:50%;transform:translateX(-50%);width:20px;height:20px;border-radius:50%;border:3px solid;background:var(--bg);z-index:2;transition:all .3s ease}.timeline-dot:hover{transform:translateX(-50%) scale(1.5);box-shadow:0 0 20px rgba(239,68,68,.5)}.timeline-dot.phase-1{border-color:#ef4444}.timeline-dot.phase-2{border-color:#f59e0b}.timeline-dot.phase-3{border-color:#ec4899}.timeline-dot.phase-4{border-color:#10b981}.timeline-content{background:var(--card);border:1px solid var(--border);border-radius:1rem;padding:1.2rem;max-width:380px;transition:all .3s ease;cursor:pointer}.timeline-content:hover{border-color:rgba(239,68,68,.3);box-shadow:0 4px 20px rgba(239,68,68,.1);transform:translateY(-2px)}.timeline-date{font-size:.8rem;font-weight:700;color:#ef4444;margin-bottom:.3rem;display:inline-block;padding:.15rem .6rem;background:rgba(239,68,68,.1);border-radius:1rem}.timeline-content h4{font-size:1rem;font-weight:700;margin-bottom:.3rem}.timeline-content p{font-size:.85rem;color:var(--muted);line-height:1.5;margin-bottom:.3rem}@media(max-width:768px){.timeline-line{left:20px}.timeline-item:nth-child(odd),.timeline-item:nth-child(even){flex-direction:row;padding-left:50px;padding-right:0;text-align:left}.timeline-dot{left:20px}.timeline-content{max-width:100%}}

