/* ===== Shared header/nav UI (restored) ===== */
:root{--bg:#0b1120;--card:#0f172a;--border:rgba(255,255,255,.1);--text:#e2e8f0;--muted:#94a3b8;--accent:#10b981}
/* Emergency hotline ticker: fixed red strip above the nav */
.hotline-ticker{width:100%;background:linear-gradient(90deg,#ef4444,#dc2626);color:#fff;padding:6px 0;overflow:hidden;white-space:nowrap;position:fixed;top:0;left:0;z-index:10001;font-size:12px;font-weight:600;letter-spacing:.5px}
.hotline-ticker .ticker-content{display:inline-block;animation:ticker 45s linear infinite}
.hotline-ticker .ticker-item{display:inline-block;padding:0 2rem;vertical-align:middle}
.hotline-ticker .ticker-item a{color:#fff;text-decoration:none;transition:opacity .2s}
.hotline-ticker .ticker-item a:hover{opacity:.8;text-decoration:underline}
.hotline-ticker .ticker-dot{display:inline-block;width:5px;height:5px;background:#fbbf24;border-radius:50%;margin:0 .6rem;vertical-align:middle}
@keyframes ticker{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
/* Fixed header stack: ticker pinned top, nav bar pinned just below it */
body{padding-top:80px}
.nav{top:36px;background:rgba(2,6,23,.9);backdrop-filter:blur(12px)}
/* Scroll progress */
.scroll-progress{position:fixed;top:0;left:0;width:0%;height:3px;background:linear-gradient(90deg,var(--pri),var(--sec),var(--acc));z-index:10002;transition:width .1s linear;box-shadow:0 0 10px rgba(16,185,129,.5)}
/* Theme / sound toggle buttons */
.theme-toggle{background:var(--glass);border:1px solid var(--gb);color:#fff;width:40px;height:40px;border-radius:10px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;font-size:1rem;transition:all .3s;backdrop-filter:blur(10px)}
.theme-toggle:hover{background:rgba(255,255,255,.15);transform:rotate(30deg)}
/* Hamburger (mobile menu trigger) */
.hamburger{display:none;background:none;border:none;cursor:pointer;padding:8px;position:relative;z-index:1001}
.hamburger span{display:block;width:22px;height:2px;background:#fff;margin:5px 0;transition:all .3s;border-radius:2px}
.hamburger.active span:nth-child(1){transform:rotate(45deg) translate(5px,5px)}
.hamburger.active span:nth-child(2){opacity:0}
.hamburger.active span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px)}
/* Slide-in mobile drawer */
.drawer-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1001;opacity:0;visibility:hidden;transition:all .3s;backdrop-filter:blur(4px)}
.drawer-overlay.active{opacity:1;visibility:visible}
.mobile-drawer{position:fixed;top:0;right:0;width:300px;height:100vh;background:var(--dk);z-index:1002;transform:translateX(100%);transition:transform .3s ease;display:flex;flex-direction:column;box-shadow:-4px 0 30px rgba(0,0,0,.3)}
.mobile-drawer.active{transform:translateX(0)}
.drawer-header{display:flex;align-items:center;justify-content:flex-end;padding:1.25rem 1.5rem;border-bottom:1px solid var(--gb)}
.drawer-close{background:none;border:none;color:#94a3b8;font-size:1.5rem;cursor:pointer;transition:color .3s;padding:4px}
.drawer-close:hover{color:#fff}
.drawer-links{list-style:none;padding:1rem 0;flex:1;overflow-y:auto}
.drawer-links li{border-bottom:1px solid var(--gb)}
.drawer-links a{display:block;padding:.875rem 1.5rem;color:#94a3b8;text-decoration:none;font-size:1rem;font-weight:500;transition:all .3s}
.drawer-links a:hover{color:#fff;background:rgba(255,255,255,.05);padding-left:2rem}
.drawer-links a.active{color:#34d399!important;border-left:3px solid #34d399!important;padding-left:1.1rem}
.drawer-footer{padding:1.25rem 1.5rem;border-top:1px solid var(--gb)}
/* User profile bar + dropdown (hidden until logged in / opened) */
.user-profile-bar{display:none;align-items:center;gap:.6rem;padding:.4rem .8rem;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:2rem;cursor:pointer}
.user-profile-bar.show{display:inline-flex}
.user-profile-bar .up-avatar{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#10b981,#ef4444);display:flex;align-items:center;justify-content:center;color:#fff;font-size:.7rem;font-weight:700;flex-shrink:0}
.user-profile-bar .up-name{font-size:.8rem;font-weight:600;color:#e2e8f0}
.user-dropdown{position:absolute;top:100%;right:0;margin-top:.5rem;background:var(--card);border:1px solid var(--border);border-radius:.8rem;min-width:200px;box-shadow:0 10px 30px rgba(0,0,0,.3);display:none;z-index:9999;padding:.5rem 0}
.user-dropdown.open{display:block}
.user-dropdown .ud-item{padding:.6rem 1rem;font-size:.85rem;color:var(--text);cursor:pointer;display:flex;align-items:center;gap:.5rem;transition:background .15s}
.user-dropdown .ud-item:hover{background:rgba(16,185,129,.1)}
.user-dropdown .ud-item i{width:16px;text-align:center;color:var(--accent)}
.user-dropdown .ud-divider{height:1px;background:var(--border);margin:.3rem 0}
.user-dropdown .ud-item.logout{color:#ef4444}
.user-dropdown .ud-item.logout i{color:#ef4444}
/* Typing headline (hero) */
.typing-headline{font-size:clamp(2.5rem,6vw,4.5rem);font-weight:900;line-height:1.1;margin-bottom:1.5rem;min-height:3.5em}
.typing-line{display:inline}
.typing-cursor{display:inline-block;color:var(--acc);font-weight:300;animation:blink .8s step-end infinite;margin-left:2px}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
/* Auth / login modal */
.auth-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(8px);z-index:10000;display:none;align-items:center;justify-content:center;padding:1rem}
.auth-overlay.open{display:flex}
.auth-modal{background:var(--card);border:1px solid var(--border);border-radius:1.2rem;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;position:relative;box-shadow:0 25px 60px rgba(0,0,0,.4)}
.auth-close{position:absolute;top:1rem;right:1rem;background:none;border:none;color:var(--text);font-size:1.3rem;cursor:pointer;z-index:2;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:background .2s}
.auth-close:hover{background:rgba(255,255,255,.1)}
.auth-header{padding:2rem 2rem 0;text-align:center}
.auth-header .auth-icon{width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#10b981,#ef4444);display:flex;align-items:center;justify-content:center;margin:0 auto .8rem;font-size:1.5rem;color:#fff}
.auth-header h2{font-size:1.4rem;font-weight:700;margin-bottom:.3rem;color:#e2e8f0}
.auth-header p{color:var(--muted);font-size:.85rem}
.auth-tabs{display:flex;gap:0;padding:1.2rem 2rem 0}
.auth-tab{flex:1;padding:.6rem;text-align:center;border:none;background:transparent;color:var(--muted);font-size:.9rem;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;transition:all .2s}
.auth-tab.active{color:var(--accent);border-bottom-color:var(--accent)}
.auth-form{padding:1.5rem 2rem 2rem}
.auth-form .form-group{margin-bottom:1rem}
.auth-form label{display:block;font-size:.8rem;font-weight:600;color:var(--text);margin-bottom:.3rem}
.auth-form select,.auth-form input{width:100%;padding:.65rem .8rem;background:var(--bg);border:1px solid var(--border);border-radius:.5rem;color:var(--text);font-size:.85rem;outline:none;transition:border .2s}
.auth-form select:focus,.auth-form input:focus{border-color:var(--accent)}
.auth-form .form-row{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.auth-form .form-full{grid-column:1/-1}
.auth-form .role-select{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-bottom:1rem}
.auth-form .role-card{padding:1rem;border:2px solid var(--border);border-radius:.8rem;text-align:center;cursor:pointer;transition:all .2s;color:var(--text)}
.auth-form .role-card:hover{border-color:var(--accent);background:rgba(16,185,129,.05)}
.auth-form .role-card.selected{border-color:var(--accent);background:rgba(16,185,129,.1)}
.auth-form .role-card i{font-size:1.5rem;color:var(--accent);margin-bottom:.3rem;display:block}
.auth-form .role-card span{font-size:.8rem;font-weight:600}
.auth-form .photo-upload{border:2px dashed var(--border);border-radius:.8rem;padding:1.2rem;text-align:center;cursor:pointer;transition:border .2s}
.auth-form .photo-upload:hover{border-color:var(--accent)}
.auth-form .photo-upload i{font-size:1.5rem;color:var(--accent);margin-bottom:.3rem;display:block}
.auth-form .photo-upload span{font-size:.75rem;color:var(--muted)}
.auth-form .submit-btn{width:100%;padding:.75rem;border:none;border-radius:.6rem;background:linear-gradient(135deg,#10b981,#ef4444);color:#fff;font-size:.95rem;font-weight:600;cursor:pointer;transition:transform .2s,box-shadow .2s;margin-top:.5rem}
.auth-form .submit-btn:hover{transform:translateY(-1px);box-shadow:0 4px 15px rgba(16,185,129,.3)}
.auth-form .divider{text-align:center;margin:1rem 0;position:relative;color:var(--muted);font-size:.8rem}
.auth-form .divider::before,.auth-form .divider::after{content:'';position:absolute;top:50%;width:40%;height:1px;background:var(--border)}
.auth-form .divider::before{left:0}
.auth-form .divider::after{right:0}
.auth-form .officer-fields{display:none}
.auth-form .officer-fields.show{display:block}
.auth-form .form-hint{font-size:.7rem;color:var(--muted);margin-top:.2rem}
.auth-toast{position:fixed;top:1.5rem;right:1.5rem;padding:1rem 1.5rem;border-radius:.8rem;background:linear-gradient(135deg,#10b981,#059669);color:#fff;font-size:.9rem;font-weight:600;z-index:99999;transform:translateX(120%);transition:transform .3s ease;box-shadow:0 5px 20px rgba(16,185,129,.3)}
.auth-toast.show{transform:translateX(0)}
/* Responsive nav hardening: below 1200px switch to hamburger mode */
@media(max-width:1199px){.nav-links{display:none!important}.hamburger{display:block!important}}
@media(max-width:560px){.nav{padding:.65rem 1rem}.nav-cta{padding:.5rem .85rem;font-size:.8rem}#loginBtn{margin-right:.3rem}.up-name{display:none}}
@media(max-width:380px){.nav-cta[href="contact.html"]{display:none}}

/* ===== A ai chat redesign - Banglalink-style light centered card ===== */
.chatbot-fab{position:fixed;bottom:22px;right:22px;z-index:12001;display:flex;align-items:center;gap:9px;padding:12px 22px;border-radius:999px;background:linear-gradient(135deg,#f4773c,#e04e1d);color:#fff;border:none;cursor:pointer;font-size:14.5px;font-weight:600;box-shadow:0 6px 22px rgba(224,78,29,.4);transition:transform .2s ease,box-shadow .2s ease}
.chatbot-fab:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(224,78,29,.5)}
.chatbot-fab i{font-size:16px;line-height:1}
#chatWin.chatbot-win{position:fixed;left:50%;top:50%;width:min(430px,calc(100vw - 18px));height:min(690px,calc(100vh - 36px));transform:translate(-50%,-50%) scale(.95);background:#fff;border:1px solid #e6e6ea;border-radius:22px;box-shadow:0 20px 60px rgba(40,25,12,.28);display:none;flex-direction:column;overflow:hidden;z-index:12000;color:#1d2126;opacity:0;transition:opacity .16s ease,transform .18s ease;box-sizing:border-box}
