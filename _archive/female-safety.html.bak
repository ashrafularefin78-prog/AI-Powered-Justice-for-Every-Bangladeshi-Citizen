<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>SheGuard - Futuristic Female Safety</title><style>*,:before,:after{box-sizing:border-box;margin:0;padding:0}:root{--bg:#070a14;--bg2:#0d1220;--card:#121a2e;--pink:#ff2d7e;--pink2:#ff6fa5;--rose:#ff5c8a;--cyan:#00d4ff;--violet:#7b5cff;--text:#e8ecf4;--muted:#8a93a8;--gold:#ffd166;--green:#2ddf8f;--red:#ff4d5e;--border:#1e2a45;--glow:0 0 20px rgba(255,45,126,.35);--radius:16px;--tr:all .3s ease}html{scroll-behavior:smooth}body{font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--text);line-height:1.7;overflow-x:hidden}a{color:var(--pink2);text-decoration:none}a:hover{color:var(--pink)}ul{list-style:none}.c{max-width:1200px;margin:0 auto;padding:0 24px}@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(255,45,126,.6)}50%{box-shadow:0 0 0 18px rgba(255,45,126,0)}}@keyframes glow{0%,100%{opacity:.6}50%{opacity:1}}.skip{position:absolute;top:-100%;left:16px;background:var(--pink);color:#fff;padding:8px 16px;border-radius:8px;z-index:1000;font-weight:600}.skip:focus{top:16px}.tb{background:linear-gradient(90deg,#1a0b14,#2d0f1e);border-bottom:1px solid var(--border);padding:7px 0;font-size:.8rem;z-index:50}.tb .c{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.tb a{color:var(--pink2);font-weight:600}.tb b{color:var(--gold)}header{background:rgba(7,10,20,.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--border);padding:14px 0;position:sticky;top:0;z-index:100}header .c{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}.logo{display:flex;align-items:center;gap:12px}.logo-badge{width:46px;height:46px;border-radius:50%;background:radial-gradient(circle at 30% 30%,var(--pink2),var(--pink));display:flex;align-items:center;justify-content:center;font-size:1.4rem;box-shadow:var(--glow);animation:glow 3s infinite}.logo h1{font-size:1.2rem;font-weight:800;color:var(--pink2)}.logo p{font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}nav ul{display:flex;gap:4px;flex-wrap:wrap}nav a{padding:8px 14px;border-radius:10px;font-size:.85rem;font-weight:500;color:var(--muted);transition:var(--tr)}nav a:hover{color:var(--pink2);background:rgba(255,45,126,.1)}.hero{position:relative;padding:90px 0 70px;text-align:center;background:radial-gradient(ellipse at 50% 0%,rgba(255,45,126,.14),transparent 60%),radial-gradient(ellipse at 80% 100%,rgba(123,92,255,.12),transparent 50%),var(--bg)}.hero .tag{display:inline-flex;align-items:center;gap:8px;padding:6px 18px;border-radius:30px;background:rgba(255,45,126,.12);border:1px solid rgba(255,45,126,.4);color:var(--pink2);font-size:.8rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;margin-bottom:22px}.hero h2{font-size:3rem;font-weight:900;line-height:1.15;margin-bottom:14px}.hero h2 .grad{background:linear-gradient(90deg,var(--pink2),var(--rose),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{font-size:1.15rem;color:var(--muted);max-width:640px;margin:0 auto 34px}.hero-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;gap:8px;padding:13px 30px;border-radius:40px;font-size:.95rem;font-weight:700;transition:var(--tr);border:none;cursor:pointer}.bp{background:linear-gradient(90deg,var(--pink),var(--rose));color:#fff;box-shadow:var(--glow)}.bp:hover{transform:translateY(-2px)}.bo{background:transparent;color:var(--cyan);border:1.5px solid rgba(0,212,255,.5)}.bo:hover{background:rgba(0,212,255,.1)}.stats-hero{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px;max-width:820px;margin:44px auto 0}.sh{background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:14px;padding:18px}.sh b{font-size:1.5rem;color:var(--pink2);display:block}.sh span{font-size:.75rem;color:var(--muted);text-transform:uppercase}.sos-wrap{padding:80px 0;background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);text-align:center}.sos-wrap h3{font-size:1.9rem;font-weight:800;margin-bottom:8px}.sos-wrap>p{color:var(--muted);margin-bottom:40px}.sos-btn{width:190px;height:190px;border-radius:50%;border:4px solid rgba(255,77,94,.5);background:radial-gradient(circle at 35% 30%,#ff7a86,#e01e3a);color:#fff;font-size:1.3rem;font-weight:900;cursor:pointer;animation:pulse 2s infinite;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;margin:0 auto 18px;transition:var(--tr);text-transform:uppercase}.sos-btn:hover{transform:scale(1.06)}.sos-btn small{font-size:.75rem;font-weight:600;opacity:.9}.sos-note{color:var(--muted);font-size:.9rem;max-width:520px;margin:0 auto 26px}.sos-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}.sos-mini{padding:10px 20px;border-radius:30px;background:rgba(255,255,255,.04);border:1px solid var(--border);color:var(--text);font-size:.85rem;font-weight:600;cursor:pointer;transition:var(--tr);display:inline-flex;gap:8px;align-items:center}.sos-mini:hover{border-color:var(--pink);color:var(--pink2)}.sec{padding:80px 0}.sec-alt{background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.sec-h{text-align:center;margin-bottom:48px}.sec-h .st{display:inline-block;padding:4px 16px;border-radius:30px;background:rgba(123,92,255,.12);border:1px solid rgba(123,92,255,.4);color:#a99bff;font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:12px}.sec-h h3{font-size:2rem;font-weight:800;margin-bottom:8px}.sec-h p{color:var(--muted);max-width:560px;margin:0 auto}.grid4{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px}.card{background:linear-gradient(160deg,var(--card),#0f1526);border:1px solid var(--border);border-radius:16px;padding:26px;transition:var(--tr);position:relative;overflow:hidden}.card:hover{transform:translateY(-4px);border-color:rgba(255,45,126,.5);box-shadow:var(--glow)}.card .ic{width:52px;height:52px;border-radius:14px;background:rgba(255,45,126,.12);border:1px solid rgba(255,45,126,.3);display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin-bottom:16px}.card h4{font-size:1.05rem;margin-bottom:8px;color:var(--text)}.card p{font-size:.85rem;color:var(--muted);line-height:1.65}.card .lv{display:inline-block;margin-top:14px;padding:3px 12px;border-radius:20px;font-size:.7rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.lv-ai{background:rgba(0,212,255,.12);color:var(--cyan)}.lv-bc{background:rgba(255,209,102,.12);color:var(--gold)}.lv-wear{background:rgba(45,223,143,.12);color:var(--green)}.lv-vr{background:rgba(123,92,255,.12);color:#a99bff}.lv-voice{background:rgba(255,45,126,.12);color:var(--pink2)}.lv-drone{background:rgba(255,77,94,.12);color:var(--red)}.map-wrap{max-width:640px;margin:0 auto}.map-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:5px;border-radius:14px;border:1px solid var(--border);padding:8px;background:#0f1526}.cell{aspect-ratio:1;border-radius:5px;cursor:pointer;transition:var(--tr);display:flex;align-items:center;justify-content:center;font-size:.6rem;color:rgba(255,255,255,.5)}.cell:hover{transform:scale(1.15)}.r1{background:rgba(45,223,143,.28)}.r2{background:rgba(255,209,102,.25)}.r3{background:rgba(255,140,66,.3)}.r4{background:rgba(255,77,94,.45)}.legend{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-top:16px;font-size:.75rem;color:var(--muted)}.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px}.legal{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px}.law{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:24px;transition:var(--tr);border-left:4px solid var(--pink)}.law:hover{transform:translateX(4px);border-left-color:var(--gold)}.law h4{font-size:1rem;margin-bottom:8px}.law p{font-size:.85rem;color:var(--muted);line-height:1.65}.law .b{display:block;margin-top:10px;color:var(--pink2);font-size:.8rem;font-weight:600}.contacts{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}.ct{display:flex;align-items:center;gap:14px;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px 20px;transition:var(--tr)}.ct:hover{border-color:var(--pink);box-shadow:var(--glow)}.ct .num{width:52px;height:52px;border-radius:50%;background:rgba(255,45,126,.12);border:1px solid rgba(255,45,126,.35);display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0}.ct b{font-size:.95rem;display:block}.ct span{font-size:.78rem;color:var(--muted)}.ct a{margin-left:auto;padding:8px 16px;border-radius:30px;background:linear-gradient(90deg,var(--pink),var(--rose));color:#fff;font-size:.8rem;font-weight:700}.welcome-bar{background:linear-gradient(90deg,rgba(255,45,126,.1),rgba(123,92,255,.1));border:1px solid rgba(255,45,126,.3);border-radius:14px;padding:20px 24px;margin-top:30px;font-size:.9rem;color:var(--muted);text-align:left}.welcome-bar b{color:var(--pink2)}footer{background:#05070e;border-top:1px solid var(--border);padding:44px 0 22px}.fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:32px;margin-bottom:28px}.fg h5{color:var(--text);font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px}.fg p{font-size:.85rem;color:var(--muted);line-height:1.7}.fg a{display:block;color:var(--muted);font-size:.85rem;padding:3px 0}.fg a:hover{color:var(--pink2)}.fbot{border-top:1px solid var(--border);padding-top:18px;display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);flex-wrap:wrap;gap:8px}@media(max-width:768px){.hero h2{font-size:2.1rem}.fg{grid-template-columns:1fr 1fr}.sos-btn{width:150px;height:150px;font-size:1.1rem}}@media(max-width:480px){.fg{grid-template-columns:1fr}.hero{padding:60px 0 50px}}</style></head><body><a href="#sos" class="skip">Jump to SOS</a><div class="tb"><div class="c"><span><b>SHE GUARD</b> | Advanced Female Safety Command Center</span><span><a href="tel:999">999</a> | <a href="tel:109">Women: 109</a> | <a href="tel:333">333</a> | <a href="tel:16430">Legal Aid: 16430</a></span></div></div><header><div class="c"><div class="logo"><div class="logo-badge">&#128737;&#65039;</div><div><h1>SheGuard</h1><p>Nirbhaya AI Shield System</p></div></div><nav><ul><li><a href="#hero" class="active">Home</a></li><li><a href="#sos">SOS</a></li><li><a href="#features">AI Shield</a></li><li><a href="#dangermap">Danger Map</a></li><li><a href="#legal">Rights &amp; Law</a></li><li><a href="#contacts">Helplines</a></li></ul></nav></div></header><section class="hero" id="hero"><div class="c"><div class="tag">&#9889; AI-Powered Protection - Level MAX</div><h2>Next-Generation <span class="grad">Female Safety</span><br>for Every Woman in Bangladesh</h2><p>One tap. One word. One breath. SheGuard fuses AI prediction, instant geolocation, blockchain evidence vault, and a 24/7 guardian swarm into an invisible shield around every woman.</p><div class="hero-actions"><a href="#sos" class="btn bp">&#128308; ACTIVATE SOS</a><a href="#features" class="btn bo">Explore AI Shield</a></div><div class="stats-hero"><div class="sh"><b>0.8s</b><span>AI Response Time</span></div><div class="sh"><b>24/7</b><span>Guardian Swarm</span></div><div class="sh"><b>64</b><span>Districts Covered</span></div><div class="sh"><b>100%</b><span>Encrypted &amp; Private</span></div></div></div></section><section class="sos-wrap" id="sos"><div class="c"><h3>Instant SOS - Emergency Activation</h3><p>One tap alerts police, family and nearby volunteers with your live location</p><button class="sos-btn" onclick="sgSOS()">&#128308;<span>SOS PANIC</span><small>Hold or double-tap</small></button><p class="sos-note" id="sosStatus"><b>System Standby.</b> Voice activation: say <b>Help me</b>, <b>Bachao</b>, or <b>Bachan</b> - AI listens 24/7.</p><div class="sos-actions"><button class="sos-mini" onclick="sgLocate()">&#128205; Share Live Location</button><button class="sos-mini" onclick="sgRecord()">&#128264;&#65039; Start Secure Recording</button><button class="sos-mini" onclick="sgShout()">&#128227; Play Max Alarm</button><button class="sos-mini" onclick="sgSms()">&#128231; SMS Trusted Contacts</button></div></div></section><section class="sec" id="features"><div class="c"><div class="sec-h"><div class="st">Futuristic Protection Stack</div><h3>AI Shield - 6 Layers of Protection</h3><p>Next-generation defense combining predictive AI, wearables, voice agents and tamper-proof evidence</p></div><div class="grid4"><div class="card"><div class="ic">&#129302;&#65039;</div><h4>AI Predictive Guardian</h4><p>Deep-learning model analyzes route, time, crowd density and district crime patterns to predict risk BEFORE you arrive - auto-alerting you and suggesting safer alternatives in real time.</p><span class="lv lv-ai">Predictive AI</span></div><div class="card"><div class="ic">&#128737;&#65039;</div><h4>Blockchain Evidence Vault</h4><p>Every recording is time-stamped and sealed on a tamper-proof ledger with zero-knowledge encryption. Court-admissible digital evidence with unbreakable chain of custody.</p><span class="lv lv-bc">Blockchain</span></div><div class="card"><div class="ic">&#128276;</div><h4>Smart Wearable Sync</h4><p>Connects SOS bracelets, smart watches and necklaces. A fall, a tug, or a fast pulse triggers automatic SOS with GPS coordinates - no phone needed.</p><span class="lv lv-wear">IoT Wearables</span></div><div class="card"><div class="ic">&#127908;</div><h4>Voice &amp; Breath Command SOS</h4><p>Whisper a keyword in Bengali or English - <b>Bachao</b>, <b>Sahayya</b>, <b>Help</b> - and the AI agent silently activates the full response chain.</p><span class="lv lv-voice">Voice Agent</span></div><div class="card"><div class="ic">&#128205;</div><h4>Safe Route Navigator</h4><p>AI maps the safest path home at any hour, showing lit streets, nearby police outposts, women-friendly zones and live risk scores zone by zone.</p><span class="lv lv-ai">Geo AI</span></div><div class="card"><div class="ic">&#128663;</div><h4>Guardian Drone Response</h4><p>Futuristic rapid-response drones and nearest police patrols are dispatched to your GPS pin within minutes, streaming live aerial support to responders.</p><span class="lv lv-drone">Drone Grid</span></div></div></div></section><section class="sec sec-alt" id="dangermap"><div class="c"><div class="sec-h"><div class="st">Live Predictive Grid</div><h3>AI Danger Zone Map - Dhaka</h3><p>Live risk heat-map computed from 10,000+ incident signals. Tap any zone for a safety verdict. (Interactive demo)</p></div><div class="map-wrap"><div class="map-grid" id="dmGrid"></div><div class="legend"><span><i style="background:rgba(45,223,143,.5)"></i>Safe</span><span><i style="background:rgba(255,209,102,.5)"></i>Caution</span><span><i style="background:rgba(255,140,66,.5)"></i>Elevated</span><span><i style="background:rgba(255,77,94,.5)"></i>High Risk</span></div><p class="welcome-bar" id="dmStatus"><b>&#128225; Grid Online.</b> 64 zones monitored by AI. Tap a block to see its live safety verdict, patrol status and nearest women-friendly help point.</p></div></div></section><section class="sec" id="legal"><div class="c"><div class="sec-h"><div class="st">Know Your Shield</div><h3>Women Protection Laws of Bangladesh</h3><p>Your legal rights are your permanent shield. Every woman deserves to know them.</p></div><div class="legal"><div class="law"><h4>&#9878;&#65039; The Domestic Violence (Prevention and Protection) Act 2010</h4><p>Protection orders, residence orders and monetary relief for victims of domestic violence. Harassment, dowry demand, and emotional abuse are covered.</p><span class="b">Helpline: 109 (Women Support)</span></div><div class="law"><h4>&#128105;&#8205;&#128105; The Prevention of Women and Children Repression Act 2000</h4><p>Stringent punishments for rape, acid violence, trafficking and sexual harassment - including death penalty for the most serious offences.</p><span class="b">24/7 Special Tribunals in every district</span></div><div class="law"><h4>&#128176; The Dowry Prohibition Act 1980</h4><p>Demanding dowry is a criminal offence punishable by up to 5 years imprisonment plus fine. Givers, takers and abettors are all liable.</p><span class="b">Report to: 999 or nearest OC office</span></div><div class="law"><h4>&#128187; The Digital Security / Cyber Law 2018</h4><p>Protects women from online harassment, morphing, blackmail and cyber stalking. Anyone sharing intimate images faces long imprisonment.</p><span class="b">Cyber Helpline: 333</span></div><div class="law"><h4>&#127891; The Acid Crime Prevention Act 2002</h4><p>Acid attacks carry life imprisonment; sale of acid is regulated. Victims receive free medical treatment and compensation funds.</p><span class="b">Free treatment: Acid Survivors Foundation</span></div><div class="law"><h4>&#128188; Constitution of Bangladesh - Art 27, 28, 29</h4><p>All citizens are equal before law (Art 27). Women have equal rights in state and public life (Art 28), with special provisions for their advancement.</p><span class="b">Supreme Law of the Land</span></div></div></div></section><section class="sec sec-alt" id="contacts"><div class="c"><div class="sec-h"><div class="st">24/7 Emergency Network</div><h3>One-Tap Helplines</h3><p>Every number connects instantly to trained responders</p></div><div class="contacts"><div class="ct"><div class="num">&#128110;</div><div><b>National Emergency</b><span>Police, Fire, Ambulance</span></div><a href="tel:999">Call 999</a></div><div class="ct"><div class="num">&#128105;&#8205;&#128105;</div><div><b>Women Help Desk</b><span>Domestic violence support</span></div><a href="tel:109">Call 109</a></div><div class="ct"><div class="num">&#128737;&#65039;</div><div><b>Legal Aid</b><span>Free lawyers, case help</span></div><a href="tel:16430">Call 16430</a></div><div class="ct"><div class="num">&#128187;</div><div><b>Cyber &amp; Women 333</b><span>Online harassment, stalking</span></div><a href="tel:333">Call 333</a></div><div class="ct"><div class="num">&#129657;</div><div><b>Child Helpline</b><span>Children in danger</span></div><a href="tel:1098">Call 1098</a></div><div class="ct"><div class="num">&#128663;</div><div><b>Traffic Police</b><span>Roadside emergency help</span></div><a href="tel:103">Call 103</a></div></div></div></section><footer><div class="c"><div class="fg"><div><h5>SheGuard Shield System</h5><p>A next-generation AI safety shield for every woman in Bangladesh - 64 districts, 24/7, zero compromise.</p></div><div><h5>Quick Access</h5><a href="#sos">Activate SOS</a><a href="#features">AI Shield</a><a href="#dangermap">Danger Map</a><a href="#legal">Legal Rights</a></div><div><h5>Official Portals</h5><a href="index.html" target="_blank">DLA Nexus - A ai</a><a href="https://bangladesh.gov.bd/" target="_blank">National Portal</a><a href="https://www.police.gov.bd/" target="_blank">Bangladesh Police</a><a href="https://www.mowca.gov.bd/" target="_blank">Women Affairs</a></div><div><h5>Emergency</h5><a href="tel:999">Police: 999</a><a href="tel:109">Women: 109</a><a href="tel:16430">Legal Aid: 16430</a><a href="tel:333">Cyber: 333</a></div></div><div class="fbot"><span>SheGuard - AI for Women Safety in Bangladesh</span><span>Back to <a href="government-homepage.html">Government Portal</a></span></div></div></footer><script>
function sayTxt(t){try{var u=new SpeechSynthesisUtterance(t);u.lang='en-US';speechSynthesis.speak(u)}catch(e){}}
function setStat(html,color){var o=document.getElementById('sosStatus');o.innerHTML=html;o.style.color=color;}
function sgSOS(){setStat('<b>&#128680; SOS ACTIVATED!</b> AI Guardian notified. Police 999 + trusted contacts alerted. Live location streaming...','#ff6fa5');sayTxt('SOS activated. Help is on the way. Stay calm.');setTimeout(function(){sgLocate()},800)}
function sgLocate(){if(navigator.geolocation){navigator.geolocation.getCurrentPosition(function(p){setStat('<b>&#128205; Live Location Shared:</b> Lat '+p.coords.latitude.toFixed(4)+', Lon '+p.coords.longitude.toFixed(4)+' - streamed to police and trusted circle.','#2ddf8f')},function(){setStat('<b>&#128205; Simulated Location:</b> Mirpur-10, Dhaka pinned. Nearest patrol dispatched (ETA 2 min).','#2ddf8f')})}else{setStat('<b>&#128205; Simulated Location:</b> Mirpur-10, Dhaka pinned.','#2ddf8f')}}
function sgRecord(){setStat('<b>&#128264;&#65039; Secure Recording ON.</b> Audio and video sealed to the Blockchain Evidence Vault (case #'+Math.floor(100000+Math.random()*900000)+').','#ffd166');sayTxt('Secure recording started. Evidence protected on the blockchain.')}
function sgShout(){setStat('<b>&#128227; MAX ALARM PLAYING</b> - 120 dB siren active. Nearby volunteers alerted.','#ff4d5e');sayTxt('Help needed. Emergency alarm activated.');try{var ac=new (window.AudioContext||window.webkitAudioContext)();var g=ac.createGain();g.connect(ac.destination);var osc=ac.createOscillator();osc.type='sine';osc.frequency.value=880;g.gain.value=.15;osc.connect(g);osc.start();setTimeout(function(){osc.stop()},1200)}catch(e){}}
function sgSms(){setStat('<b>&#128231; SOS SMS Sent</b> to 3 trusted contacts with live location link.','#00d4ff')}
var zones=['Dhanmondi','Mirpur','Uttara','Motijheel','Gulshan','Banani','Mohammadpur','Tejgaon','Khilgaon','Kamrangir','Shyampur','Badda','Rampura','Shahbagh','Ramna','Paltan','Lalbagh','Hazaribagh','Demra','Savar','Keraniganj','Narayanganj','Gazipur','Tongi','Ashulia','Kallyanpur','Pallabi','Sher-e-Bangla','Adabor','Shegunbagicha','Malibagh','Green Road','New Market','Azimpur','Jatrabari','Matuail','Basabo','Mugda','Sabujbagh','Bhashantek','Dakshinkhan','Kafrul','Cantonment','Bimanbandar','Khilkhet','Aftabnagar','Kuril','Mohakhali','Nikunja','Baridhara','Banani DOHS','Sher-e-Bangla Nagar','Agargaon','Bijoy Sarani','Elephant Road','Farmgate','Karwan Bazar','Kawranbazar','Nilkhet','Katabon','Moghbazar','Eskaton','Shantinagar','Kakrail'];
var names=['Mirpur Road','Zia Colony','Uttara Sector 3','Motijheel C/A','Gulshan-2','Banani Road 11','Monipur','Tejgaon I/A','Middle Badda','Dhaka Uddan','Dholaikhal','Notun Bazar','Rampura Bridge','Shahbagh Sq','Ramna Park','Paltan Lane','Lalbagh Fort','Saat Masjid','Sutrapur','Gausia Market','Jinjira','Chashara','Joydebpur','Tongi Bazar','Nabinagar','Bazar Road','Pallabi Ext','CRP Area','Adabor Bazar','Railgate','Kakrail Sq','Green Corner','Chankharpul','Lalbagh Gate','Jatrabari Sq','Matuail I/A','Basabo Flyover','Wari','Dewanpara','Bhashantek','Kuril Bishwa','Airport Road','Cantonment Gate','Biman Gate','Khilkhet Point','Aftabnagar 3','Purbachal','Mohakhali 7','Nikunja-2','Baridhara DOHS','Banani Lake','Parlament Sq','Agargaon 5','Bijoy 11','Azimpur Gate','Dhaka Medical','Kawran Bazar','Boro Bazar','Nilkhet Point','Jagannath Hall','Moghbazar Sq','Eskaton 2','Khilgaon Taltola','Banasree 4'];
var verdicts=['SAFE - patrol 2 min away','CAUTION - avoid after 11 PM','ELEVATED - extra vigilance advised','HIGH RISK - patrol rerouted to area','SAFE - community watch active','CAUTION - dim lighting reported','ELEVATED - 2 incidents this month','SAFE - 24h CCTV coverage','HIGH RISK - avoid alone','CAUTION - crowd density high'];
var grid=document.getElementById('dmGrid');for(var i=0;i<64;i++){var cell=document.createElement('div');var r=Math.random();var cls=r<.45?'r1':r<.7?'r2':r<.88?'r3':'r4';cell.className='cell '+cls;cell.title=zones[i]+' - '+verdicts[i%10];cell.onclick=(function(idx){return function(){var v=verdicts[idx%10];var status=document.getElementById('dmStatus');status.innerHTML='<b>&#128205; Zone: '+zones[idx]+'</b> ('+names[idx]+')<br>Verdict: <b>'+v.split(' - ')[1]+'</b> | Patrol unit #'+(100+idx)+' | Nearest help point: 300m';};})(i);grid.appendChild(cell)}
</script></body></html>