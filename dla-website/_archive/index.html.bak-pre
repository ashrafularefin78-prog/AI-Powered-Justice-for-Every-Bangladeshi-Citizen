    body.light #absolute-dissolution,body.light #justice-principle,body.light #generative-matrix,body.light #end-victimhood,body.light #transcend-transcendence,body.light #being-itself,body.light #architecture-impossible,body.light #path-beyond{background:#f8fafc}
