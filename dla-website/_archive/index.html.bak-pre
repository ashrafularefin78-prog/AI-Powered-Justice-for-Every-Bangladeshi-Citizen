var divColors={
'Rangpur':'#0ea5e9','Rajshahi':'#6366f1','Mymensingh':'#10b981',
'Dhaka':'#f59e0b','Chattogram':'#ec4899','Sylhet':'#8b5cf6',
'Khulna':'#14b8a6','Barishal':'#f97316'
};

var ttDiv=null;

function createTooltip(){
  if(!document.getElementById('mapTooltip')){
    ttDiv=document.createElement('div');
    ttDiv.id='mapTooltip';
    ttDiv.className='map-tooltip';
    ttDiv.innerHTML='<div class="tt-name"></div><div class="tt-division"></div><div class="tt-row"><span>Population</span><span class="tt-val" id="ttPop"></span></div><div class="tt-row"><span>Area</span><span class="tt-val" id="ttArea"></span></div><div class="tt-row"><span>Upazilas</span><span class="tt-val" id="ttUpa"></span></div><div class="tt-row"><span>Thanas</span><span class="tt-val" id="ttTh"></span></div><div class="tt-click">Click to view details</div>';
    document.body.appendChild(ttDiv);
  }
  ttDiv=document.getElementById('mapTooltip');
}

function showTooltip(e){
  createTooltip();
  var el=e.target.closest('.map-district');
  if(!el)return;
  var name=el.getAttribute('data-name');
  var div=el.getAttribute('data-div');
  var d=dData[name];
  if(!d)return;

  var color=divColors[div]||'#fff';
  ttDiv.querySelector('.tt-name').textContent=name;
  var badge=ttDiv.querySelector('.tt-division');
  badge.textContent=div+' Division';
  badge.style.background=color+'22';
  badge.style.color=color;
  document.getElementById('ttPop').textContent=d.pop;
  document.getElementById('ttArea').textContent=d.area;
  document.getElementById('ttUpa').textContent=d.upazilas;
  document.getElementById('ttTh').textContent=d.thana;

  var rect=el.getBoundingClientRect();
  var tx=rect.left+rect.width/2;
  var ty=rect.top-10;

  ttDiv.classList.add('visible');
  var ttRect=ttDiv.getBoundingClientRect();
  var left=tx-ttRect.width/2;
  var top=ty-ttRect.height;

  if(left<8)left=8;
  if(left+ttRect.width>window.innerWidth-8)left=window.innerWidth-ttRect.width-8;
  if(top<8)top=rect.bottom+10;

  ttDiv.style.left=left+'px';
  ttDiv.style.top=top+'px';

  el.style.transform='scale(1.1)';
  el.style.filter='brightness(1.3)';
}

function hideTooltip(e){
  var el=e.target.closest('.map-district');
  if(el){
    el.style.transform='';
    el.style.filter='';
  }
  if(ttDiv)ttDiv.classList.remove('visible');
}

document.addEventListener('mouseover',function(e){
  if(e.target.classList&&e.target.classList.contains('map-district')){
    showTooltip(e);
  }
});
document.addEventListener('mouseout',function(e){
  if(e.target.classList&&e.target.classList.contains('map-district')){
    hideTooltip(e);
  }
});



function showDivTab(i){
  var tabs=document.querySelectorAll('.div-tab');
  var contents=document.querySelectorAll('.div-content');
  tabs.forEach(function(t,idx){t.className='div-tab'+(idx===i?' active':'');});
  contents.forEach(function(c,idx){c.className='div-content'+(idx===i?' active':'');});
}



/* Map Search & Filter */
var mapFilter={query:'',division:'All',
  "paltan shooting":"hadi_assassination_detail",
  "hadi brain stem":"hadi_assassination_detail",
  "december protests":"december_violence",
  "hadi wife and family details":"hadi_personal",
  "osman hadi full biography":"hadi_full_bio",
  "who killed hadi":"hadi_assassination_detail",
  "hadi murder investigation":"hadi_scottish_yard"};

function filterMap(){
  var q=mapFilter.query.toLowerCase();
  var div=mapFilter.division;
  var districts=document.querySelectorAll('.map-district');

  var count=0;
  districts.forEach(function(d){
    var name=d.getAttribute('data-name').toLowerCase();
    var ddiv=d.getAttribute('data-div');
    var matchQ=!q||name.indexOf(q)!==-1;
    var matchD=div==='All'||ddiv===div;
    if(matchQ&&matchD){
      d.classList.remove('dimmed');
      d.classList.add('highlighted');
      count++;
    }else{
      d.classList.add('dimmed');
      d.classList.remove('highlighted');
    }
  });
  // Also dim matching text labels
  var svgTexts=document.querySelectorAll('#interactive-map svg text');
  svgTexts.forEach(function(t){
    var parent=t.previousElementSibling;
    if(parent&&parent.classList.contains('map-district')){
      if(parent.classList.contains('dimmed')){
        t.style.opacity='.12';
      }else{
        t.style.opacity='1';
      }
    }
  });
  var ct=document.getElementById('mapResultCount');
  if(ct){
    if(q||div!=='All'){
      ct.textContent=count+' of 64 districts match';
      ct.style.display='block';
    }else{
      ct.style.display='none';
    }
  }
}

function setMapFilter(div,el){
  mapFilter.division=div;
  document.querySelectorAll('.map-filter-btn').forEach(function(b){b.classList.remove('active');});
  if(el)el.classList.add('active');
  filterMap();
}

function onMapSearch(e){
  mapFilter.query=e.target.value;
  filterMap();
}

function clearMapFilter(){
  mapFilter.query='';mapFilter.division='All';
  var inp=document.getElementById('mapSearchInput');
  if(inp)inp.value='';
  document.querySelectorAll('.map-filter-btn').forEach(function(b){b.classList.remove('active');});
  var allBtn=document.querySelector('.map-filter-btn[data-div="All"]');
  if(allBtn)allBtn.classList.add('active');
  filterMap();
}



/* Timeline scroll animation */
(function(){
var obs = new IntersectionObserver(function(entries){
entries.forEach(function(e){
if(e.isIntersecting){e.target.classList.add('visible');}
});
},{threshold:0.2});
document.querySelectorAll('.timeline-item').forEach(function(item){obs.observe(item);});
})();
</script>
<style>/* ================= PROFESSIONAL SKIN v1 (appended) ================= */
/* Default (dark): calm deep navy, muted official green, restrained */
html{scroll-behavior:smooth}
html,html.light{--pri:#0e9f6e;--sec:#2f6db3;--acc:#c9a227}
:root{--dk:#0e1626;--dkr:#0a111f;--glass:rgba(255,255,255,.045);--gb:rgba(255,255,255,.09)}
html.light{--dk:#eef2f6;--dkr:#f7f9fb;--glass:rgba(15,23,42,.04);--gb:rgba(15,23,42,.09)}
body{background:var(--dkr)!important;color:#c9d6e4!important;font-family:Inter,-apple-system,"Segoe UI",Roboto,sans-serif!important}
html.light body{color:#22304a!important;background:#f7f9fb!important}
h1,h2,h3,h4{font-family:"Space Grotesk","Segoe UI",Inter,sans-serif!important;letter-spacing:-.01em}
/* Section rhythm: consistent whitespace, no 100vh jams */
section{padding:4.5rem 2rem!important}
/* Section headers: single clean accent line, calm type */
.section-tag{color:#3ec9a0!important;font-weight:600;letter-spacing:.14em}
html.light .section-tag{color:#0e7a54!important}
.section-tag::before,.section-tag::after{background:#3ec9a0;opacity:.35}
html.light .section-tag::before,html.light .section-tag::after{background:#0e7a54}
.section-header h2,.section-header h3{color:#f1f5f9!important;font-weight:650}
html.light .section-header h2,html.light .section-header h3{color:#14213d!important}
.section-header p{color:#94a7bd!important}
html.light .section-header p{color:#52627a!important}
/* Nav: professional, fixed above fold */
.nav{background:rgba(9,15,28,.92)!important;border-bottom:1px solid rgba(255,255,255,.06);backdrop-filter:blur(14px)}
html.light .nav{background:rgba(255,255,255,.9)!important;border-bottom:1px solid rgba(15,23,42,.08)}
.nav-links a{color:#a9b8cc!important;font-size:.82rem!important;font-weight:500!important;padding:.35rem 0;border-bottom:2px solid transparent}
.nav-links a:hover{color:#fff!important;border-bottom-color:#0e9f6e}
html.light .nav-links a{color:#41506b!important}
html.light .nav-links a:hover{color:#0e7a54!important;border-bottom-color:#0e7a54}
.nav-cta,.btn-p{background:#0e9f6e!important;border:none!important;box-shadow:0 1px 2px rgba(0,0,0,.25)!important}
html.light .nav-cta,html.light .btn-p{background:#0e7a54!important;color:#fff!important;box-shadow:0 1px 2px rgba(13,60,45,.25)!important}
#loginBtn{background:transparent!important;border:1px solid rgba(14,159,110,.55)!important;color:#e8f5ee!important}
html.light #loginBtn{color:#0e7a54!important}
.nav-cta:hover,.btn-p:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(14,159,110,.35)!important}
.btn-s{background:var(--glass)!important;border:1px solid var(--gb)!important;color:#dce7f2!important}
html.light .btn-s{color:#2a3a58!important}
/* Ticker: calm official band instead of alarm red */
.hotline-ticker{background:linear-gradient(90deg,#0d3a2c,#0e5a40,#0d3a2c)!important;color:#d9f2e6!important}
.hotline-ticker .ticker-item a{color:#eafaf2!important}
.hotline-ticker .ticker-dot{background:#ffd66b!important}
/* Hero: professional gradient wash, restrained glow */
.hero{background:radial-gradient(1100px 500px at 20% 0%,rgba(14,159,110,.16),transparent 60%),radial-gradient(900px 460px at 85% 10%,rgba(47,109,179,.12),transparent 55%)!important}
.hero h1,.hero h1 .typing-line,.typing-headline{background:none!important;-webkit-text-fill-color:currentColor!important;color:#f4f8fb!important}
html.light .hero h1,html.light .hero .typing-line,html.light .typing-headline{color:#14213d!important}
.typing-cursor{color:#0e9f6e!important}
.hero-badge{color:#cfe9dd!important}
html.light .hero-badge{color:#0e7a54!important}
.hero p{color:#b6c6d8!important}
html.light .hero p{color:#4c5d77!important}
/* De-neon shared cards */
.pcard,.fcard,.percard,.tlcontent,.sol-card,.impact-card,.c-card,.feature-card,.stcard{background:var(--glass)!important;border:1px solid var(--gb)!important;box-shadow:none!important}
html.light .pcard,html.light .fcard,html.light .percard,html.light .tlcontent{background:#fff!important;border-color:#e3e9f0!important;box-shadow:0 1px 3px rgba(15,23,42,.06)!important}
.pcard:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,.28)!important;border-color:rgba(14,159,110,.4)!important}
/* Footer */
footer{background:#0a1424!important;border-top:1px solid rgba(255,255,255,.06)}
html.light footer{background:#eef2f6!important;border-top:1px solid #dfe6ee!important}
html.light footer *{color:#41506b!important}
html.light footer h4{color:#14213d!important}

/* ---- light-mode cohesion for hard-coded dark sections ---- */
html.light section[style*="rgba(2,6,23"]{background:transparent!important}
html.light #solution,html.light #roadmap,html.light #vision,html.light #additional-features,html.light #futuristic,html.light #personas,html.light #roadmap-phases,html.light #reasoning-engine,html.light #collective-intel,html.light #govt-services{background:transparent!important}
html.light #memorial{background:linear-gradient(135deg,#fdf3f3 0%,#fdf7ef 50%,#f4f0fa 100%)!important}
html.light #programming{background:linear-gradient(135deg,#f3f6fd 0%,#eef4fb 50%,#f3f8fd 100%)!important}
html.light #constitution-full{background:transparent!important}
/* base text coercion only where sections are light now */
html.light .hero h1{background:none!important;-webkit-text-fill-color:currentColor!important;color:#12213b!important}
html.light .timeline-content h3,html.light .timeline-content .tl-title{color:#12213b!important}
html.light .tl-date,html.light .timeline-content span{color:#52627a!important}
/* map + interactive panels get white surface */
html.light #interactive-map{background:transparent!important}
html.light .map-card,html.light .map-panel,html.light #mapPanel{background:#fff!important;border-color:#e3e9f0!important;color:#22304a!important}
/* uniform scrollbar */
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-track{background:#0a111f}
html.light ::-webkit-scrollbar-track{background:#eef2f6}
::-webkit-scrollbar-thumb{background:#1e3b4f;border-radius:6px}
/* de-neon: neutralize glow shadows on common interactive bits */
.particle{opacity:.18!important}
.scroll-progress{background:linear-gradient(90deg,#0e9f6e,#2f6db3)!important;box-shadow:none!important;height:3px}
.back-to-top{background:#0e9f6e!important;box-shadow:0 6px 18px rgba(14,159,110,.35)!important}
.chat-fab,.chat-toggle,.fab-ai,.ai-fab{background:#0e9f6e!important;box-shadow:0 8px 22px rgba(14,159,110,.4)!important}
/* Visionary archive hub buttons */
#visionary-archive .btn-s{border-radius:999px;padding:.5rem 1.1rem;font-size:.82rem}
#vaBody section{border-top:1px solid rgba(255,255,255,.06)}
html.light #vaBody section{border-top:1px solid #e3e9f0}
</style><script>
/* Visionary archive expander */
function vaShow(id){
  var body=document.getElementById('vaBody');
  if(body&&body.style.display==='none'){body.style.display='block';}
  var el=document.getElementById(id);
  if(el){setTimeout(function(){el.scrollIntoView({behavior:'smooth',block:'start'});},60);}
  var btn=document.getElementById('vaExpandBtn');
  if(btn){btn.textContent='Hide Extended Blueprints';}
}
function vaShowAll(){
  var body=document.getElementById('vaBody');
  if(body){body.style.display='block';}
  var first=document.getElementById('futuristic-tech');
  if(first){setTimeout(function(){first.scrollIntoView({behavior:'smooth',block:'start'});},60);}
}
function vaToggleAll(){
  var body=document.getElementById('vaBody');
  if(!body)return;
  var showing=body.style.display!=='none';
  if(showing){body.style.display='none';}
  else{body.style.display='block';
    var hub=document.getElementById('visionary-archive');
    if(hub){setTimeout(function(){hub.scrollIntoView({behavior:'smooth',block:'start'});},60);}
  }
}
</script>
<style>/* calm the AI assistant launcher (de-neon) */
.chatbot-fab{background:linear-gradient(135deg,#0e9f6e,#147d8f)!important;box-shadow:0 8px 22px rgba(14,120,84,.35)!important}
.chatbot-fab:hover{box-shadow:0 10px 30px rgba(14,120,84,.45)!important}
.chatbot-pulse{background:linear-gradient(135deg,#0e9f6e,#147d8f)!important}
</style><style>/* Memorial & Programming: keep as cohesive dark feature panels in BOTH themes (inline white-on-dark content) */
html.light #memorial{background:linear-gradient(135deg,#160b0f 0%,#241420 55%,#180f22 100%)!important}
html.light #memorial h2,html.light #memorial p,html.light #memorial div{color:inherit}
html.light #memorial p[style*="color:#fff"],html.light #memorial div[style*="rgba(255,255,255"]{color:#fff!important}
html.light #programming{background:linear-gradient(135deg,#0a1030 0%,#141a4a 55%,#0a2444 100%)!important}
/* borders around the panels so they read as deliberate app windows on light pages */
html.light #memorial,html.light #programming{border-radius:0;border-top:1px solid rgba(255,255,255,.05);border-bottom:1px solid rgba(255,255,255,.05)}
</style><style>/* Contact hero: readable in light mode */
html.light #contact h2{color:#14213d!important}
html.light #contact p{color:#4c5d77!important}
html.light #contact{background:linear-gradient(135deg,rgba(14,159,110,.08),rgba(47,109,179,.08))!important}
</style><style>/* ============ Calm layer: remove decorative motion/glow ============ */
/* Hero particle field (JS orbs + parallax layers): hidden entirely */
#particles,.particles,.parallax-layer{display:none!important}
/* Hero ambient gradient: stop the slow drift */
.hero-bg::before,.hero-bg{animation:none!important}
/* Hero badge status dot: static, no pulse */
.hero-badge .dot,.dot{animation:none!important}
/* Chat header "online" dot: static */
.cb-dot{animation:none!important}
/* SheGuard "live" glow dot next to nav label: static + no halo */
[style*="blinkD"]{animation:none!important;box-shadow:none!important}
/* Dead pulse keyframes / leftover halo behind launcher */
.chatbot-pulse{display:none!important}
/* Any leftover box-shadow glow halos on decorative bits */
.ticker-dot{box-shadow:none!important}
</style><style>/* Toast: fully hidden at rest, slides in only when .show */
.auth-toast{transform:translateX(calc(100% + 3rem))!important;visibility:hidden}
.auth-toast.show{transform:translateX(0)!important;visibility:visible}
</style><style>/* ===== Auth/account surface: define missing vars + calm green accents ===== */
html{--card:#0f1a2c;--border:rgba(255,255,255,.12);--text:#e6edf6;--muted:#8fa3ba;--accent:#3ec9a0;--bg:#0a111f}
html.light{--card:#ffffff;--border:#e2e8f0;--text:#14213d;--muted:#5a6b85;--accent:#0e7a54;--bg:#f7f9fb}
.auth-overlay{background:rgba(8,14,26,.62)!important;backdrop-filter:blur(6px)!important}
.auth-modal{background:rgba(255,255,255,.6)!important;-webkit-backdrop-filter:blur(24px) saturate(1.5)!important;backdrop-filter:blur(24px) saturate(1.5)!important;border:1px solid rgba(255,255,255,.55)!important;box-shadow:0 20px 60px rgba(2,8,20,.28)!important}
html:not(.light) .auth-modal{background:rgba(13,22,40,.55)!important;border:1px solid rgba(255,255,255,.18)!important}
.auth-header h2{color:var(--text)!important}
.auth-header p{color:var(--muted)!important}
.auth-header .auth-icon,.auth-icon{background:linear-gradient(135deg,#0e9f6e,#147d8f)!important}
.auth-tabs .auth-tab{color:var(--muted)!important}
.auth-tabs .auth-tab.active{color:var(--accent)!important;border-bottom-color:var(--accent)!important}
.auth-form label{color:var(--text)!important}
.auth-form .form-hint{color:var(--muted)!important}
.auth-form input,.auth-form select{background:rgba(255,255,255,.72)!important;border:1px solid rgba(13,32,26,.16)!important;color:var(--text)!important}
html:not(.light) .auth-form input,html:not(.light) .auth-form select{background:rgba(10,17,31,.5)!important;border:1px solid rgba(255,255,255,.14)!important}
.auth-form input:focus{border-color:var(--accent)!important}
.auth-form .submit-btn{background:linear-gradient(135deg,#0e9f6e,#0c7d5c)!important;box-shadow:0 6px 18px rgba(14,159,110,.3)!important}
.auth-form .submit-btn:hover{box-shadow:0 8px 22px rgba(14,159,110,.4)!important}
.auth-form .role-card{border-color:var(--border)!important;background:rgba(255,255,255,.5)!important}
html:not(.light) .auth-form .role-card{background:rgba(255,255,255,.06)!important}
.auth-form .role-card span{color:var(--text)!important}
.auth-form .role-card i{color:var(--accent)!important}
.auth-form .role-card:hover,.auth-form .role-card.selected{border-color:var(--accent)!important;background:rgba(14,159,110,.08)!important}
.auth-form .photo-upload{border-color:var(--border)!important;background:rgba(255,255,255,.35)!important}
html:not(.light) .auth-form .photo-upload{background:rgba(255,255,255,.05)!important}
.auth-form .photo-upload i{color:var(--accent)!important}
.auth-form .photo-upload span{color:var(--muted)!important}
.auth-close{color:var(--muted)!important}
.auth-close:hover{color:var(--text)!important;background:rgba(14,159,110,.12)!important}
.auth-form .divider{color:var(--muted)!important}
/* role cards inside auth selectors on dark nav */
.user-profile-bar,.up-avatar,.user-dropdown{--accent:#0e9f6e}
.up-avatar{background:linear-gradient(135deg,#0e9f6e,#147d8f)!important}
.user-dropdown{background:var(--card)!important;border-color:var(--border)!important}
.ud-item{color:var(--text)!important}
.ud-item:hover{background:rgba(14,159,110,.1)!important}
.ud-item i{color:var(--accent)!important}
</style><style>.auth-overlay{z-index:10050!important}
</style><style>
/* ===== Auth modal entrance / exit animations ===== */
@keyframes authOvIn{from{opacity:0}to{opacity:1}}
@keyframes authOvOut{to{opacity:0}}
@keyframes authMIn{from{opacity:0;transform:translateY(26px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes authMOut{to{opacity:0;transform:translateY(14px) scale(.97)}}
@keyframes authUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes authPop{from{opacity:0;transform:scale(.4)}60%{transform:scale(1.08)}to{opacity:1;transform:scale(1)}}
.auth-overlay.open{animation:authOvIn .3s ease-out both}
.auth-overlay.closing{animation:authOvOut .26s ease-in both}
.auth-overlay.open .auth-modal{animation:authMIn .45s cubic-bezier(.2,1.15,.3,1) both}
.auth-overlay.closing .auth-modal{animation:authMOut .26s ease-in both}
.auth-overlay.open .auth-header{animation:authUp .4s ease-out .07s both}
.auth-overlay.open .auth-icon{animation:authPop .5s cubic-bezier(.2,1.3,.35,1) .12s both}
.auth-overlay.open .auth-tabs{animation:authUp .4s ease-out .13s both}
.auth-overlay.open .auth-form{animation:authUp .45s ease-out .19s both}
@media (prefers-reduced-motion:reduce){
  .auth-overlay.open,.auth-overlay.closing,
  .auth-overlay.open .auth-modal,.auth-overlay.closing .auth-modal,
  .auth-overlay.open .auth-header,.auth-overlay.open .auth-icon,
  .auth-overlay.open .auth-tabs,.auth-overlay.open .auth-form{animation:none}
}
</style><style>
/* ===== Claude Mythos 5.2 deep-reasoning skin ===== */
.cb-reasoning.mythos52{border-color:rgba(14,159,110,.28)!important;background:rgba(14,159,110,.05)!important}
.cb-reasoning.mythos52 .reason-title{color:#0e9f6e!important}
.cb-reasoning.mythos52 .reason-header{border-bottom-color:rgba(14,159,110,.18)!important}
.cb-reasoning.mythos52 .rtag{background:rgba(14,159,110,.13)!important;color:#0e9f6e!important}
.cb-reasoning.mythos52 .rstep{opacity:0;animation:cbStepIn .35s ease-out forwards}
@keyframes cbStepIn{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}
.cb-reasoning.mythos52 .stat-steps{padding:.1rem .4rem;border-radius:.5rem;background:rgba(14,159,110,.12);color:#0e9f6e;font-weight:600}
.cb-reasoning.mythos52 .conf-bar{height:5px;border-radius:3px;background:rgba(14,159,110,.14);margin-top:.55rem;overflow:hidden}
.cb-reasoning.mythos52 .conf-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,#0e9f6e,#2dd4a7);animation:confGrow .9s ease-out .25s both}
@keyframes confGrow{from{width:0}}
@media (prefers-reduced-motion:reduce){
  .cb-reasoning.mythos52 .rstep{opacity:1;animation:none}
  .cb-reasoning.mythos52 .conf-fill{animation:none}
}
</style><style>
/* ===== Animated sign-in success screen ===== */
.auth-success{display:none;position:absolute;inset:0;z-index:30;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:.55rem;background:rgba(255,255,255,.88);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);border-radius:1.2rem;padding:2rem}
html:not(.light) .auth-success{background:rgba(13,22,40,.82)}
.auth-success.show{display:flex;animation:authSuccessIn .35s ease-out both}
@keyframes authSuccessIn{from{opacity:0}to{opacity:1}}
.auth-success .as-ring{width:96px;height:96px;margin-bottom:.3rem;position:relative}
.auth-success svg{width:100%;height:100%}
.auth-success .as-circle{stroke:#0e9f6e;stroke-width:3;stroke-dasharray:151;stroke-dashoffset:151;animation:asDraw .6s ease-out .15s forwards}
.auth-success .as-check{stroke:#0e9f6e;stroke-width:4;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:40;stroke-dashoffset:40;animation:asDraw .45s ease-out .7s forwards}
@keyframes asDraw{to{stroke-dashoffset:0}}
.auth-success .as-ring::after{content:'';position:absolute;inset:-6px;border-radius:50%;border:2px solid rgba(14,159,110,.35);opacity:0;animation:asPulse 1.6s ease-out .8s infinite}
@keyframes asPulse{0%{transform:scale(.8);opacity:0}40%{opacity:1}100%{transform:scale(1.15);opacity:0}}
.auth-success .as-ring::before{content:'';position:absolute;left:50%;top:50%;width:120px;height:120px;margin:-60px 0 0 -60px;border-radius:50%;background:radial-gradient(circle,rgba(52,211,167,.5) 0%,rgba(14,159,110,.3) 36%,rgba(14,159,110,0) 70%);filter:blur(5px);opacity:0;animation:asGlow 2.4s ease-out .45s both}
@keyframes asGlow{0%{opacity:0;transform:scale(.45)}26%{opacity:1;transform:scale(.92)}55%{opacity:.8;transform:scale(1.12)}100%{opacity:0;transform:scale(1.3)}}
.auth-success h3{color:var(--text,#14213d);font-size:1.25rem;margin:0;opacity:0;animation:authUp .4s ease-out .9s both}
html:not(.light) .auth-success h3{color:#e6edf6}
.auth-success p{color:var(--muted,#5a6b85);font-size:.85rem;margin:0;max-width:280px;opacity:0;animation:authUp .4s ease-out 1.05s both}
html:not(.light) .auth-success p{color:#8fa3ba}
.auth-success .as-continue{margin-top:.7rem;background:linear-gradient(135deg,#0e9f6e,#0c7d5c);color:#fff;border:none;border-radius:.6rem;padding:.6rem 1.7rem;font-weight:600;font-size:.9rem;font-family:inherit;cursor:pointer;opacity:0;animation:authUp .4s ease-out 1.2s both;transition:transform .2s,box-shadow .2s}
.auth-success .as-continue:hover{transform:translateY(-1px);box-shadow:0 6px 16px rgba(14,159,110,.35)}
@media (prefers-reduced-motion:reduce){
  .auth-success .as-circle,.auth-success .as-check{animation:none;stroke-dashoffset:0}
  .auth-success .as-ring::after,.auth-success h3,.auth-success p,.auth-success .as-continue{animation:none;opacity:1}
}
</style><style>
/* ===== Entrance animations: district modal + chat window + complaint desk ===== */
#districtModal{animation:dmFadeIn .3s ease-out both}
#districtModal.closing{animation:dmFadeOut .25s ease-in both}
#districtModal>div{animation:dmPanelIn .45s ease-out both}
#districtModal.closing>div{animation:dmPanelOut .25s ease-in both}
@keyframes dmFadeIn{from{opacity:0}to{opacity:1}}
@keyframes dmFadeOut{to{opacity:0}}
@keyframes dmPanelIn{from{opacity:0}to{opacity:1}}
@keyframes dmPanelOut{to{opacity:0}}
#districtModal #dmTitle,#districtModal #dmContent>div{opacity:0;animation:authUp .4s ease-out both}
#districtModal #dmTitle{animation-delay:.1s}
#districtModal #dmContent>div:nth-child(1){animation-delay:.16s}
#districtModal #dmContent>div:nth-child(2){animation-delay:.24s}
#districtModal #dmContent>div:nth-child(3){animation-delay:.32s}
#districtModal #dmContent>div:nth-child(4){animation-delay:.4s}
#districtModal #dmContent>div:nth-child(5){animation-delay:.48s}
#districtModal #dmContent>div:nth-child(6){animation-delay:.56s}
.chatbot-win.open{animation:cbWinIn .42s cubic-bezier(.2,1.15,.3,1) both}
.chatbot-win.open.closing{animation:cbWinOut .28s ease-in both}
@keyframes cbWinIn{from{opacity:0;transform:translateY(22px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes cbWinOut{to{opacity:0;transform:translateY(14px) scale(.97)}}
.chatbot-win.open .cb-head,.chatbot-win.open .cb-msgs,.chatbot-win.open .cb-input{opacity:0;animation:authUp .38s ease-out both}
.chatbot-win.open .cb-head{animation-delay:.07s}
.chatbot-win.open .cb-msgs{animation-delay:.14s}
.chatbot-win.open .cb-input{animation-delay:.22s}
@media (prefers-reduced-motion:reduce){
  #districtModal,#districtModal.closing,#districtModal>div,#districtModal.closing>div,
  #districtModal #dmTitle,#districtModal #dmContent>div,
  .chatbot-win.open,.chatbot-win.open.closing,
  .chatbot-win.open .cb-head,.chatbot-win.open .cb-msgs,.chatbot-win.open .cb-input{animation:none;opacity:1}
}
</style><style>
/* ===== Sign-up step wizard ===== */
.auth-wsteps-bar{display:flex;align-items:flex-start;justify-content:center;gap:4px;margin:0 0 1.1rem}
.ws-dot{display:flex;flex-direction:column;align-items:center;gap:5px;cursor:pointer;user-select:none}
.ws-dot span{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;background:var(--bg,#eef2f7);color:var(--muted,#5a6b85);border:2px solid var(--border,#e2e8f0);transition:all .3s}
.ws-dot.active span{background:linear-gradient(135deg,#0e9f6e,#0c7d5c);color:#fff;border-color:#0e9f6e;box-shadow:0 4px 12px rgba(14,159,110,.35);transform:scale(1.08)}
.ws-dot.done span{background:rgba(14,159,110,.14);color:#0e9f6e;border-color:#0e9f6e}
.ws-dot b{font-size:.62rem;color:var(--muted,#5a6b85);font-weight:600;transition:color .3s}
.ws-dot.active b{color:var(--text,#14213d)}
.ws-line{width:20px;height:2px;background:var(--border,#e2e8f0);border-radius:2px;margin-top:12px}
.auth-wsteps{position:relative}
.auth-wstep{position:absolute;left:0;top:0;width:100%;opacity:0;visibility:hidden;pointer-events:none;transform:translateX(46px);transition:transform .38s cubic-bezier(.25,.9,.3,1),opacity .35s ease,visibility 0s .38s}
.auth-wstep.active{opacity:1;visibility:visible;pointer-events:auto;position:relative;transform:translateX(0);transition:transform .38s cubic-bezier(.25,.9,.3,1),opacity .35s ease}
#wsSteps[dir="back"] .auth-wstep{transform:translateX(-46px)}
#wsSteps[dir="back"] .auth-wstep.active{transform:translateX(0)}
.ws-nav{display:flex;gap:.6rem;margin-top:1rem}
.btn-ws{flex:1;padding:.68rem;border:none;border-radius:.6rem;font-size:.88rem;font-weight:600;cursor:pointer;font-family:inherit;background:linear-gradient(135deg,#0e9f6e,#0c7d5c);color:#fff;transition:transform .2s,box-shadow .2s}
.btn-ws.btn-next{width:100%;margin-top:.7rem}
.auth-wstep:not(.active) .btn-ws.btn-next{display:none}
.btn-ws.btn-back{flex:0 0 auto;padding:.68rem 1.1rem;background:transparent;border:1px solid var(--border,#e2e8f0);color:var(--muted,#5a6b85)}
.btn-ws:hover{transform:translateY(-1px);box-shadow:0 6px 16px rgba(14,159,110,.3)}
.btn-ws.btn-back:hover{box-shadow:none;color:var(--text,#14213d);border-color:#0e9f6e}
@media (prefers-reduced-motion:reduce){
  .auth-wstep,.auth-wstep.active,#wsSteps[dir="back"] .auth-wstep,#wsSteps[dir="back"] .auth-wstep.active{transition:none;transform:none}
}
</style><style>
/* ===== Collapsible Mythos 5.2 reasoning steps ===== */
.cb-reasoning.mythos52 .reason-steps-wrap{max-height:0;overflow:hidden;opacity:0;transition:max-height .45s cubic-bezier(.4,0,.2,1),opacity .3s ease .05s}
.cb-reasoning.mythos52.expanded .reason-steps-wrap{max-height:900px;opacity:1}
.reason-toggle{width:22px;height:22px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:rgba(14,159,110,.13);color:#0e9f6e;cursor:pointer;font-size:.62rem;flex-shrink:0;transition:transform .3s,background .2s;margin-left:.2rem}
.reason-toggle:hover{background:rgba(14,159,110,.24)}
.cb-reasoning.mythos52.expanded .reason-toggle{transform:rotate(180deg)}
@media (prefers-reduced-motion:reduce){
  .cb-reasoning.mythos52 .reason-steps-wrap,.cb-reasoning.mythos52.expanded .reason-steps-wrap{transition:none}
  .cb-reasoning.mythos52.expanded .reason-toggle{transform:none}
}
</style><style>
/* ===== Source citation chips in Mythos 5.2 reasoning ===== */
.cb-reasoning.mythos52 .reason-sources{display:flex;flex-wrap:wrap;gap:.32rem;align-items:center;margin-top:.5rem;padding-top:.45rem;border-top:1px dashed rgba(14,159,110,.2)}
.cb-reasoning.mythos52 .src-label{font-size:.6rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:#0e9f6e;margin-right:.1rem}
.cb-reasoning.mythos52 .src-chip{font-size:.66rem;font-weight:600;color:#0c7d5c;background:rgba(14,159,110,.1);border:1px solid rgba(14,159,110,.28);border-radius:2rem;padding:.16rem .55rem;cursor:pointer;transition:background .2s,color .2s,transform .15s;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cb-reasoning.mythos52 .src-chip:hover{background:rgba(14,159,110,.22);color:#0a5f43;transform:translateY(-1px)}
.cb-reasoning.mythos52 .src-chip:active{transform:scale(.96)}
</style><style>
/* ===== Confetti burst around the success checkmark ===== */
.auth-success .as-confetti{position:absolute;inset:0;pointer-events:none;overflow:visible}
.auth-success .as-confetti i{position:absolute;left:50%;top:50%;width:8px;height:12px;border-radius:2px;margin:-6px 0 0 -4px;opacity:0;transform:translate(0,0) rotate(0deg);animation:confFly 1.05s cubic-bezier(.16,.6,.32,1) var(--d,1s) both}
.auth-success .as-confetti i:nth-child(even){border-radius:50%;width:7px;height:7px;margin:-4px 0 0 -4px}
.auth-success .as-confetti i::after{content:'';position:absolute;inset:0;background:inherit;opacity:.55;transform:scale(1.6);border-radius:inherit}
@keyframes confFly{
  0%{opacity:1;transform:translate(0,0) rotate(0deg) scale(1)}
  60%{opacity:1;transform:translate(calc(var(--dx) * .55),calc(var(--dy) * .55)) rotate(calc(var(--sp) * .6)) scale(1)}
  100%{opacity:0;transform:translate(var(--dx),var(--dy)) rotate(var(--sp)) scale(.55)}
}
@media (prefers-reduced-motion:reduce){
  .auth-success .as-confetti i{animation:none;opacity:0}
  .auth-success .as-ring::before{animation:none;opacity:0}
}
</style><style>
/* ===== Success screen: user chips + dashboard shortcuts ===== */
.auth-success .as-user{display:flex;flex-wrap:wrap;gap:.4rem;justify-content:center;margin-top:.1rem;opacity:0;animation:authUp .4s ease-out .95s both}
.auth-success .as-chip{display:inline-flex;align-items:center;gap:.38rem;font-size:.72rem;font-weight:600;color:var(--text,#14213d);background:rgba(14,159,110,.09);border:1px solid rgba(14,159,110,.22);border-radius:2rem;padding:.26rem .68rem;max-width:100%}
html:not(.light) .auth-success .as-chip{color:#dbe6f1;background:rgba(14,159,110,.13);border-color:rgba(14,159,110,.32)}
.auth-success .as-chip i{color:#0e9f6e;font-size:.66rem}
.auth-success .as-actions{display:flex;gap:.45rem;flex-wrap:wrap;justify-content:center;margin-top:.55rem;opacity:0;animation:authUp .4s ease-out 1.18s both}
.auth-success .as-shortcut{display:inline-flex;align-items:center;gap:.42rem;background:rgba(255,255,255,.62);border:1px solid var(--border,#e2e8f0);color:var(--text,#14213d);border-radius:.55rem;padding:.44rem .85rem;font-size:.72rem;font-weight:600;cursor:pointer;font-family:inherit;transition:border-color .2s,transform .15s,box-shadow .2s}
html:not(.light) .auth-success .as-shortcut{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.16)}
.auth-success .as-shortcut i{color:#0e9f6e;font-size:.72rem}
.auth-success .as-shortcut:hover{border-color:#0e9f6e;transform:translateY(-1px);box-shadow:0 4px 10px rgba(14,159,110,.16)}
@media (prefers-reduced-motion:reduce){
  .auth-success .as-user,.auth-success .as-actions{animation:none;opacity:1}
}
<style>
/* ===== Previous-conversation divider ===== */
.cb-prev-div{display:flex;align-items:center;gap:.55rem;margin:.9rem .35rem .25rem;padding:0 .2rem}
.cb-prev-div .cb-prev-line{flex:1;height:1px;background:rgba(14,159,110,.35)}
.cb-prev-div .cb-prev-txt{font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:#6fb7a4;white-space:nowrap;font-weight:600;opacity:.92}
.cb-prev-div .cb-prev-txt:hover{opacity:1}
@media (max-width:480px){.cb-prev-div .cb-prev-txt{font-size:.55rem;letter-spacing:.05em}}
</style></style><script>
/* ====== Success chime (Web Audio) + mute toggle ====== */
var soundOn = true;
try{ if(window.localStorage && localStorage.getItem('aai_sound')==='off'){ soundOn=false; } }catch(_e){}
var _sndCtx = null;
function _sndCtxGet(){
  var AC = window.AudioContext || window.webkitAudioContext;
  if(!AC) return null;
  try{
    if(!_sndCtx){ _sndCtx = new AC(); }
    if(_sndCtx.state === 'suspended' && _sndCtx.resume){ try{ _sndCtx.resume(); }catch(_e){} }
    return _sndCtx;
  }catch(_e){ return null; }
}
function playSuccessChime(){
  if(!soundOn) return;
  var ctx = _sndCtxGet();
  if(!ctx) return;
  try{
    var t = ctx.currentTime + 0.02;
    var notes = [1046.5, 1318.5, 1568.0];
    for(var i=0;i<notes.length;i++){
      var o = ctx.createOscillator(), g = ctx.createGain();
      o.type = 'sine';
      o.frequency.value = notes[i];
      var st = t + i*0.095;
      g.gain.setValueAtTime(0.0001, st);
      g.gain.exponentialRampToValueAtTime(0.10, st+0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, st+0.55);
      o.connect(g); g.connect(ctx.destination);
      o.start(st); o.stop(st+0.6);
    }
  }catch(_e){}
}
function setSoundIcon(){
  var b = document.getElementById('soundToggle');
  if(!b) return;
  b.innerHTML = soundOn ? '<i class="fas fa-volume-up"></i>' : '<i class="fas fa-volume-off"></i>';
  b.setAttribute('aria-pressed', soundOn ? 'true' : 'false');
  b.title = soundOn ? 'Success sound on - click to mute' : 'Success sound muted - click to enable';
}
function toggleSound(){
  soundOn = !soundOn;
  try{ localStorage.setItem('aai_sound', soundOn ? 'on' : 'off'); }catch(_e){}
  setSoundIcon();
  try{ showToast(soundOn ? 'Success sound enabled' : 'Success sound muted'); }catch(_e){}
  if(soundOn){ setTimeout(function(){ playSuccessChime(); }, 60); }
}
(function(){
  setSoundIcon();
  var b = document.getElementById('soundToggle');
  if(b){ b.addEventListener('click', toggleSound); }
  window.addEventListener('pointerdown', function _warm(){
    var c = _sndCtxGet();
    if(c && c.state === 'running'){ try{ window.removeEventListener('pointerdown', _warm); }catch(_e){} }
  }, {passive:true});
})();
</script>
<style>
/* fix crushed reason header on narrow widths: never squeeze the title word-by-word */
.cb-reasoning .reason-header{flex-wrap:wrap;row-gap:.35rem;column-gap:.6rem}
.cb-reasoning .reason-title{flex:0 0 auto;max-width:100%;white-space:normal}
.cb-reasoning .reason-title>span{white-space:nowrap}
.cb-reasoning .reason-stats{flex-wrap:wrap;justify-content:flex-start}
</style>
</body></html>