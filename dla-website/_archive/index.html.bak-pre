<section id="women-safety" style="padding:2.5rem 0;background:radial-gradient(ellipse at 30% 20%,rgba(244,63,94,.14),transparent 60%),radial-gradient(ellipse at 80% 90%,rgba(168,85,247,.12),transparent 50%),rgba(2,6,23,.6);border-bottom:1px solid rgba(244,63,94,.2)"><div class="container"><div class="section-header"><div class="section-tag" style="color:#fb7185;border-color:#fb718555;background:#fb718511">SheGuard - Women Safety</div><h2>Futuristic Female Safety <span style="background:linear-gradient(90deg,#fb7185,#f472b6,#a78bfa);-webkit-background-clip:text;background-clip:text;color:transparent">AI Command Center</span></h2><p>Next-generation protection for every woman: AI predictive guardian, one-tap SOS, blockchain evidence vault, danger-zone map and instant helplines</p></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.2rem;align-items:stretch"><div class="pcard reveal rd0" style="padding:1.4rem;border-left:4px solid #f43f5e"><h4 style="margin:0 0 .6rem;font-size:1.05rem;color:#fff"><i class="fas fa-shield-alt" style="color:#fb7185;margin-right:.4rem"></i>One-Tap SOS Shield</h4><p style="font-size:.85rem;color:rgba(255,255,255,.6);margin:0">Instant panic alert with live GPS to police 999, women helpline 109 and your trusted circle. Voice-activated in Bengali and English.</p></div><div class="pcard reveal rd1" style="padding:1.4rem;border-left:4px solid #a855f7"><h4 style="margin:0 0 .6rem;font-size:1.05rem;color:#fff"><i class="fas fa-brain" style="color:#c084fc;margin-right:.4rem"></i>AI Predictive Guardian</h4><p style="font-size:.85rem;color:rgba(255,255,255,.6);margin:0">Deep-learning risk prediction, safe-route navigation and 64-zone live danger map across all districts of Bangladesh.</p></div><div class="pcard reveal rd2" style="padding:1.4rem;border-left:4px solid #f59e0b"><h4 style="margin:0 0 .6rem;font-size:1.05rem;color:#fff"><i class="fas fa-gavel" style="color:#fbbf24;margin-right:.4rem"></i>Rights + Blockchain Evidence</h4><p style="font-size:.85rem;color:rgba(255,255,255,.6);margin:0">Know every women-protection law with one-tap helplines, plus tamper-proof court-admissible evidence vault.</p></div></div><div style="text-align:center;margin-top:1.8rem"><a href="female-safety.html" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:.6rem;padding:.85rem 2.4rem;background:linear-gradient(90deg,#e11d48,#f43f5e);border-radius:2.4rem;color:#fff;font-weight:700;font-size:.95rem;text-decoration:none;box-shadow:0 0 30px rgba(244,63,94,.4);transition:all .2s">🛡️ Enter SheGuard Command Center</a></div></div></section>

<section id="sheguard-live" style="padding:3.5rem 0;background:radial-gradient(ellipse at 20% 10%,rgba(244,63,94,.12),transparent 55%),radial-gradient(ellipse at 90% 95%,rgba(0,212,255,.08),transparent 55%),rgba(2,6,23,.55);border-top:1px solid rgba(244,63,94,.18);border-bottom:1px solid rgba(14,165,233,.15)"><div class="container"><div class="section-header"><div class="section-tag" style="color:#fb7185;border-color:#fb718555;background:#fb718511">SheGuard X - Live Command Center</div><h2>Full Female Safety Suite <span style="background:linear-gradient(90deg,#fb7185,#f472b6,#a78bfa);-webkit-background-clip:text;background-clip:text;color:transparent">Embedded Live</span></h2><p>Everything is interactive below - voice panic guardian, one-tap SOS, WhatsApp guardian alerts, covert duress mode, safety check-in, evidence vault, FIR wizard, district dispatch for 64 districts and the OSCC &amp; shelter finder. Works inside this page.</p></div>
<div style="position:relative;border-radius:1.2rem;overflow:hidden;border:1px solid rgba(244,63,94,.35);box-shadow:0 25px 80px rgba(244,63,94,.15),0 0 0 1px rgba(148,163,184,.08);background:#070a14">
<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:.6rem 1rem;background:linear-gradient(90deg,#170b14,#101a2e);border-bottom:1px solid rgba(244,63,94,.25);font-size:.8rem;color:#cbd5e1;flex-wrap:wrap"><span style="display:inline-flex;align-items:center;gap:.5rem"><span style="width:10px;height:10px;border-radius:50%;background:#22c55e;box-shadow:0 0 10px #22c55e;animation:blinkD 1.6s infinite"></span><b style="color:#fda4af">SheGuard X</b> - AI safety shield · interactive</span><a href="female-safety.html" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:.4rem;padding:.35rem .9rem;border-radius:2rem;background:linear-gradient(90deg,#e11d48,#f43f5e);color:#fff;font-size:.75rem;font-weight:700;text-decoration:none">Open Full Screen ↗</a></div>
<iframe id="sheguardFrame" data-autofit src="female-safety.html" title="SheGuard X - Female Safety Command Center" loading="lazy" style="display:block;width:100%;height:520px;border:0;background:#070a14" allow="microphone;geolocation"></iframe>
</div>
<p style="text-align:center;font-size:.78rem;color:#64748b;margin-top:.9rem">Emergency: 999 · Women Support: 109 · Legal Aid: 16430 · Cyber: 333 - always available directly too</p>
</div></section>
<script>
/* ==== SheGuard X embedded frame: auto-fit to full content height ==========
   Keeps #sheguardFrame exactly as tall as its inner document so the host page
   scrolls as one continuous document (no nested scrollbar). The frame is
   same-origin (female-safety.html), so we can read its layout directly and
   watch it with a ResizeObserver (panels, toasts and language switches inside
   the frame can change its height at any time). */
(function(){
  var f=document.getElementById('sheguardFrame');
  if(!f){return;}
  var ro=null;
  function fit(){
    try{
      var d=f.contentDocument;
      if(!d||!d.documentElement){return;}
      var h=Math.max(d.documentElement.scrollHeight,(d.body?d.body.scrollHeight:0),Math.max(d.documentElement.offsetHeight,(d.body?d.body.offsetHeight:0)));
      if(h>300){
        var cur=parseInt(f.style.height,10)||0;
        if(Math.abs(cur-h)>4){f.style.height=h+'px';}
      }
    }catch(e){}
  }
  function watch(){
    fit();
    if(!ro){try{ro=new ResizeObserver(fit);}catch(e){ro=null;}}
    if(ro){try{ro.observe(f.contentDocument.documentElement);}catch(e){}}
  }
  /* Called by the frame's own embed boot script if it initialises first */
  window.sgEmbedReady=function(){watch();};
  /* Smooth-scroll the OUTER page to a point inside the frame (used by the
     frame's header nav links, which have no inner scrollport to jump to) */
  window.sgJump=function(off){
    try{
      var top=f.getBoundingClientRect().top+window.pageYOffset+(typeof off==='number'?off:0);
      window.scrollTo({top:top,behavior:'smooth'});
    }catch(e){}
  };
  f.addEventListener('load',watch);
  window.addEventListener('resize',function(){clearTimeout(window.__sgRt);window.__sgRt=setTimeout(fit,150);});
  var iv=setInterval(fit,700);setTimeout(function(){clearInterval(iv);},15000);
  setTimeout(fit,500);setTimeout(fit,2000);setTimeout(watch,4500);

  /* SheGuard toasts from the embedded frame: render them pinned to the OUTER
     viewport. The frame is thousands of px tall, so in-frame toasts would be
     invisible unless the user happens to be at the very bottom of the section. */
  (function(){
    if(document.getElementById('sgToastStyle')){return;}
    var st=document.createElement('style');st.id='sgToastStyle';
    st.textContent=
      '#sgToastWrap{position:fixed;left:50%;bottom:96px;transform:translateX(-50%);z-index:2147483000;display:flex;flex-direction:column;align-items:center;gap:8px;pointer-events:none}'
      +'#sgToastWrap .sgt{background:#0f172a;border:1px solid rgba(244,63,94,.7);color:#fdeef1;padding:10px 18px;border-radius:999px;font:600 .86rem/1.45 system-ui,-apple-system,"Segoe UI",sans-serif;box-shadow:0 10px 34px rgba(244,63,94,.3),0 0 0 1px rgba(244,63,94,.15);max-width:min(560px,calc(100vw - 40px));text-align:center;opacity:0;transform:translateY(14px);animation:sgtIn .28s ease forwards;white-space:normal}'
      +'#sgToastWrap .sgt::before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:#fb7185;box-shadow:0 0 8px #fb7185;margin-right:8px;vertical-align:middle}'
      +'@keyframes sgtIn{to{opacity:1;transform:translateY(0)}}'
      +'#sgToastWrap .sgt.out{animation:sgtOut .3s ease forwards}'
      +'@keyframes sgtOut{to{opacity:0;transform:translateY(10px)}}';
    (document.head||document.documentElement).appendChild(st);
  })();
  window.sgToast=function(txt){
    try{
      var wrap=document.getElementById('sgToastWrap');
      if(!wrap){wrap=document.createElement('div');wrap.id='sgToastWrap';document.body.appendChild(wrap);}
      while(wrap.children.length>=3){wrap.removeChild(wrap.firstChild);}
      var p=document.createElement('div');p.className='sgt';p.textContent=txt;
      wrap.appendChild(p);
      setTimeout(function(){if(p.classList)p.classList.add('out');setTimeout(function(){if(p.parentNode)p.parentNode.removeChild(p);},320);},3200);
    }catch(e){}
  };
})();
</script>
<script>
/* ===== SheGuard X embed scrollspy: highlight the header nav link for the
   section currently in view while scrolling the outer (host) page. ===== */
(function(){
  var f=document.getElementById('sheguardFrame');
  if(!f){return;}
  var ids=['hero','sos','voice','checkin','vault','fir','dangermap','legal','shelters','contacts'];
  var cur=null,tic=false;
  function compute(){
    var d=null;try{d=f.contentDocument;}catch(e){}
    if(!d||!d.title){return;}
    if(!d.getElementById('sos')){return;}
    var base=f.getBoundingClientRect().top+window.pageYOffset;
    var probe=window.pageYOffset+Math.max(140,window.innerHeight*0.3);
    var found=null;
    for(var i=0;i<ids.length;i++){
      var el=d.getElementById(ids[i]);
      if(!el){continue;}
      var top=base+el.getBoundingClientRect().top;
      if(top<=probe){found=ids[i];}else{break;}
    }
    if(found!==cur){
      cur=found;
      var links=d.querySelectorAll('header nav a');
      for(var k=0;k<links.length;k++){
        var lk=links[k];
        if(lk.getAttribute('href')==='#'+found){lk.classList.add('act');}
        else{lk.classList.remove('act');}
      }
    }
  }
  function tick(){if(tic){return;}tic=true;requestAnimationFrame(function(){tic=false;compute();});}
  window.addEventListener('scroll',tick,{passive:true});
  window.addEventListener('resize',tick);
  setInterval(compute,1200);
  setTimeout(compute,600);
})();
/* ===== Generic auto-fit for any other iframes marked data-autofit =====
   #sheguardFrame is handled by the dedicated coordinator above; this keeps
   the same one-page scroll behaviour available site-wide for future embeds. */
document.querySelectorAll('iframe[data-autofit]').forEach(function(o){
  if(o.id==='sheguardFrame'){return;}
  var ro=null;
  function fit(){
    try{
      var d=o.contentDocument;
      if(!d||!d.documentElement){return;}
      var h=Math.max(d.documentElement.scrollHeight,(d.body?d.body.scrollHeight:0));
      if(h>200){var c=parseInt(o.style.height,10)||0;if(Math.abs(c-h)>4){o.style.height=h+'px';}}
    }catch(e){}
  }
  o.addEventListener('load',function(){
    fit();
    if(!ro){try{ro=new ResizeObserver(fit);}catch(e){ro=null;}}
    if(ro){try{ro.observe(o.contentDocument.documentElement);}catch(e){}}
  });
  window.addEventListener('resize',fit);
  setTimeout(fit,800);setTimeout(fit,2500);
});
</script>

<style>@keyframes blinkD{0%,100%{opacity:1}50%{opacity:.25}}</style>

<section id="complaints" style="background:linear-gradient(135deg,rgba(16,185,129,.07),rgba(14,165,233,.05) 45%,rgba(99,102,241,.07));border-top:1px solid rgba(16,185,129,.22);border-bottom:1px solid rgba(99,102,241,.15);padding:3.5rem 0"><div class="container"><div class="section-header reveal"><div class="section-tag" style="color:#34d399;border-color:#34d39955;background:#34d39911">Grievance Redressal Portal</div><h2 style="font-size:clamp(1.9rem,3.6vw,2.7rem);font-weight:800;margin-bottom:.4rem">Complaint &amp; Feedback <span style="background:linear-gradient(90deg,#34d399,#22d3ee);-webkit-background-clip:text;background-clip:text;color:transparent">Desk</span></h2><p style="color:#94a3b8;font-size:.95rem;max-width:640px;margin:0 auto;line-height:1.7">Your voice matters - report any problem to the concerned authority or tell us about website issues. Every submission gets a tracking ID. / আপনার অভিযোগ জানান - প্রতিটি অভিযোগের জন্য ট্র্যাকিং আইডি দেওয়া হবে।</p></div>
<div class="cbx-grid"><div class="cbx-card reveal"><div class="cbx-ic"><i class="fas fa-comment-dots"></i></div><h3>General Complaint <span class="cbx-bn">সাধারণ অভিযোগ</span></h3><p class="cbx-sub">For citizens &amp; the general public - police, legal aid, court, land, service issues or any grievance. / সাধারণ নাগরিকদের জন্য অভিযোগ বক্স।</p>
<form id="cbxCitForm" class="cbx-form" autocomplete="off"><div class="cbx-row"><label>Full Name / পূর্ণ নাম</label><input type="text" id="cbxCitName" class="cbx-f" placeholder="Your name (optional)"></div><div class="cbx-row"><label>Mobile Number / মোবাইল নম্বর <b class="cbx-req">*</b></label><input type="tel" id="cbxCitPhone" class="cbx-f" placeholder="01XXXXXXXXX" maxlength="11"></div><div class="cbx-row"><label>NID Number / এনআইডি (optional)</label><input type="text" id="cbxCitNid" class="cbx-f" placeholder="National ID (optional)" maxlength="17"></div><div class="cbx-row2"><div class="cbx-row"><label>Division / বিভাগ</label><select id="cbxCitDiv" class="cbx-f cbx-sel"><option value="">Select / নির্বাচন করুন</option><option>Dhaka</option><option>Chattogram</option><option>Rajshahi</option><option>Khulna</option><option>Barishal</option><option>Sylhet</option><option>Rangpur</option><option>Mymensingh</option></select></div><div class="cbx-row"><label>District / জেলা</label><input type="text" id="cbxCitDist" class="cbx-f" placeholder="e.g. Dhaka, Cumilla"></div></div><div class="cbx-row"><label>Complaint Category / অভিযোগের ধরন <b class="cbx-req">*</b></label><select id="cbxCitCat" class="cbx-f cbx-sel"><option value="">Select category / ধরন বাছাই করুন</option><option value="police">Police / Service related (পুলিশ)</option><option value="legal-aid">Legal aid not provided (আইনি সহায়তা)</option><option value="court">Court / case related (আদালত)</option><option value="land">Land / mutation / khas land (জমি)</option><option value="women-safety">Women &amp; child safety (নারী ও শিশু)</option><option value="corruption">Corruption / harassment (দুর্নীতি)</option><option value="gov-service">Government service failure (সরকারি সেবা)</option><option value="education-health">Education / Health (শিক্ষা ও স্বাস্থ্য)</option><option value="other">Other (অন্যান্য)</option></select></div><div class="cbx-row"><label>Complaint Details / বিস্তারিত বিবরণ <b class="cbx-req">*</b></label><textarea id="cbxCitDet" class="cbx-f cbx-ta" rows="4" placeholder="Describe what happened, where, when, and who is involved. / কী ঘটেছে, কোথায়, কখন - বিস্তারিত লিখুন।"></textarea></div><button type="submit" class="cbx-btn"><i class="fas fa-paper-plane"></i> Submit Complaint / অভিযোগ জমা দিন</button></form><div class="cbx-err" id="cbxCitErr" role="alert"></div><div class="cbx-ok" id="cbxCitOk"></div>
<div class="cbx-list"><div class="cbx-lhead">Your submitted complaints <span class="cbx-bn">আপনার অভিযোগসমূহ</span></div><div id="cbxCitList" class="cbx-items"><div class="cbx-empty">No complaints submitted yet. / এখনো কোনো অভিযোগ জমা দেওয়া হয়নি।</div></div></div></div>
<div class="cbx-card reveal"><div class="cbx-ic cbx-ic-it"><i class="fas fa-bug"></i></div><h3>IT / Website Issue <span class="cbx-bn">ওয়েবসাইট সমস্যা</span></h3><p class="cbx-sub">Report website bugs, broken pages, wrong information or send suggestions about A ai itself. / ওয়েবসাইটের কোনো সমস্যা বা পরামর্শ জানান।</p>
<form id="cbxItForm" class="cbx-form" autocomplete="off"><div class="cbx-row"><label>Issue Type / সমস্যার ধরন <b class="cbx-req">*</b></label><select id="cbxItType" class="cbx-f cbx-sel"><option value="">Select type / ধরন বাছাই করুন</option><option value="page">Broken page / not loading (পেজ খুলছে না)</option><option value="content">Wrong or outdated information (ভুল তথ্য)</option><option value="chatbot">A ai chatbot gave a wrong answer (চ্যাটবট)</option><option value="account">Login / NID account problem (লগইন)</option><option value="safety">SheGuard X / women safety section issue</option><option value="map">District map / search issue (ম্যাপ)</option><option value="other-bug">Other bug or error (অন্যান্য সমস্যা)</option><option value="suggestion">Suggestion / new feature idea (পরামর্শ)</option></select></div><div class="cbx-row"><label>Where did it happen? / কোন অংশে?</label><input type="text" id="cbxItWhere" class="cbx-f" placeholder="e.g. Home page, SheGuard section, Chatbot, Login form"></div><div class="cbx-row"><label>Describe the issue / সমস্যার বিবরণ <b class="cbx-req">*</b></label><textarea id="cbxItDet" class="cbx-f cbx-ta" rows="4" placeholder="What did you expect and what happened instead? Include the exact text of any error. / কী সমস্যা হচ্ছে তা বিস্তারিত লিখুন।"></textarea></div><div class="cbx-row2"><div class="cbx-row"><label>Browser / Device (optional)</label><input type="text" id="cbxItDev" class="cbx-f" placeholder="e.g. Chrome, Android phone"></div><div class="cbx-row"><label>Your contact (optional)</label><input type="text" id="cbxItCon" class="cbx-f" placeholder="Email or phone (optional)"></div></div><button type="submit" class="cbx-btn cbx-btn-it"><i class="fas fa-paper-plane"></i> Report Issue / সমস্যা জানান</button></form><div class="cbx-err" id="cbxItErr" role="alert"></div><div class="cbx-ok" id="cbxItOk"></div>
<div class="cbx-list"><div class="cbx-lhead">Reported issues <span class="cbx-bn">আপনার রিপোর্ট</span></div><div id="cbxItList" class="cbx-items"><div class="cbx-empty">No reports yet. / এখনো কোনো রিপোর্ট নেই।</div></div></div></div>
</div>
<p class="cbx-note"><i class="fas fa-info-circle"></i> Every submission is stored with a tracking reference. For urgent help call <a href="tel:999">999</a> (police), <a href="tel:109">109</a> (women support), <a href="tel:16430">16430</a> (free legal aid), <a href="tel:333">333</a> (cyber). Demo portal - data is kept securely in your own browser. / জরুরি প্রয়োজনে হেল্পলাইনে কল করুন।</p>
</div></section><div class="csx-ov" id="csxOv"><div class="csx-card" id="csxCard"><button class="csx-x" id="csxX" aria-label="Close"><i class="fas fa-times"></i></button><div class="csx-ring" id="csxRing"><svg viewBox="0 0 52 52"><circle class="csx-circle" cx="26" cy="26" r="24" fill="none"/><path class="csx-check" fill="none" d="M14 27l8 8 16-16"/></svg></div><div class="csx-confetti" id="csxConfetti"></div><h3 class="csx-title" id="csxTitle">Complaint Received!</h3><p class="csx-sub" id="csxSub">Your complaint has been forwarded to the concerned authority desk.</p><div class="csx-tid"><span class="csx-tid-lbl">Tracking ID / ট্র্যাকিং আইডি</span><span class="csx-tid-val" id="csxTid">GRV-XXXX</span></div><p class="csx-detail" id="csxDetail"></p><button class="csx-btn" id="csxDone">Done <i class="fas fa-arrow-right"></i></button></div></div>
<style>
.cbx-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:22px;margin-top:2.2rem;align-items:start}
.cbx-card{border-radius:18px;padding:24px;border:1px solid rgba(148,163,184,.18);background:rgba(10,15,28,.6);box-shadow:0 18px 50px rgba(0,0,0,.25)}
html.light .cbx-card{background:rgba(255,255,255,.92);border-color:rgba(15,23,42,.12);box-shadow:0 14px 40px rgba(15,23,42,.08)}
.cbx-ic{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;color:#fff;background:linear-gradient(135deg,#10b981,#22d3ee);margin-bottom:14px}
.cbx-ic-it{background:linear-gradient(135deg,#f43f5e,#f59e0b)}
.cbx-card h3{font-size:1.25rem;font-weight:800;color:#fff;margin:0 0 4px;display:flex;align-items:center;flex-wrap:wrap;gap:8px}
html.light .cbx-card h3{color:#0f172a}
.cbx-bn{font-size:.75rem;font-weight:500;color:#34d399;opacity:.85}
.cbx-ic-it ~ h3 .cbx-bn{color:#fb7185}
.cbx-sub{font-size:.82rem;line-height:1.6;color:#94a3b8;margin:0 0 16px}
html.light .cbx-sub{color:#475569}
.cbx-form{display:flex;flex-direction:column;gap:12px}
.cbx-row{display:flex;flex-direction:column;gap:5px;flex:1}
.cbx-row2{display:flex;gap:12px;flex-wrap:wrap}
.cbx-row2 .cbx-row{min-width:180px}
.cbx-form label{font-size:.75rem;font-weight:600;color:#cbd5e1;letter-spacing:.02em}
html.light .cbx-form label{color:#334155}
.cbx-req{color:#fb7185}
.cbx-f{background:rgba(15,23,42,.85);border:1px solid rgba(148,163,184,.22);color:#e2e8f0;border-radius:10px;padding:10px 12px;font-size:.88rem;outline:none;transition:border .2s;width:100%;box-sizing:border-box;font-family:inherit}
html.light .cbx-f{background:#fff;border-color:rgba(15,23,42,.2);color:#0f172a}
.cbx-f:focus{border-color:#34d399;box-shadow:0 0 0 3px rgba(52,211,153,.15)}
.cbx-sel{appearance:auto;cursor:pointer}
.cbx-sel option{color:#0f172a;background:#fff}
.cbx-ta{resize:vertical;min-height:96px}
.cbx-btn{margin-top:6px;border:none;cursor:pointer;background:linear-gradient(135deg,#10b981,#0ea5e9);color:#fff;font-weight:700;font-size:.9rem;padding:12px 18px;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:transform .15s,box-shadow .2s}
.cbx-btn:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(16,185,129,.35)}
.cbx-btn-it{background:linear-gradient(135deg,#f43f5e,#f59e0b)}
.cbx-btn-it:hover{box-shadow:0 10px 26px rgba(244,63,94,.35)}
.cbx-err{display:none;margin-top:12px;background:rgba(244,63,94,.12);border:1px solid rgba(244,63,94,.4);color:#fda4af;font-size:.82rem;padding:9px 12px;border-radius:10px}
.cbx-err.on{display:block}
.cbx-ok{display:none;margin-top:12px;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.4);color:#6ee7b7;font-size:.84rem;padding:11px 13px;border-radius:10px;line-height:1.55}
.cbx-ok.on{display:block}
html.light .cbx-ok{color:#047857}
.cbx-ok b{color:#fff}
html.light .cbx-ok b{color:#065f46}
.csx-ov{position:fixed;inset:0;z-index:10090;display:none;align-items:center;justify-content:center;padding:1rem;background:rgba(4,12,10,.55);-webkit-backdrop-filter:blur(7px);backdrop-filter:blur(7px)}
.csx-ov.show{display:flex;animation:csxOvIn .3s ease-out both}
.csx-ov.closing{animation:csxOvOut .24s ease-in both}
@keyframes csxOvIn{from{opacity:0}to{opacity:1}}
@keyframes csxOvOut{from{opacity:1}to{opacity:0}}
.csx-card{position:relative;width:min(430px,92vw);border-radius:22px;padding:2.4rem 2rem 2rem;text-align:center;background:rgba(255,255,255,.9);-webkit-backdrop-filter:blur(22px) saturate(1.4);backdrop-filter:blur(22px) saturate(1.4);border:1px solid rgba(16,185,129,.28);box-shadow:0 30px 80px rgba(4,30,20,.35);overflow:hidden}
html:not(.light) .csx-card{background:rgba(10,20,16,.88);border-color:rgba(52,211,153,.22);box-shadow:0 30px 80px rgba(0,0,0,.6)}
.csx-ov.show .csx-card{animation:csxCardIn .5s cubic-bezier(.2,1.15,.3,1) both}
@keyframes csxCardIn{from{opacity:0;transform:translateY(26px) scale(.94)}to{opacity:1;transform:translateY(0) scale(1)}}
.csx-ov.closing .csx-card{animation:csxCardOut .22s ease-in both}
@keyframes csxCardOut{to{opacity:0;transform:translateY(14px) scale(.97)}}
.csx-x{position:absolute;top:12px;right:12px;width:32px;height:32px;border-radius:50%;border:1px solid rgba(148,163,184,.3);background:transparent;color:#64748b;cursor:pointer;font-size:.85rem;line-height:1;transition:all .2s}
.csx-x:hover{background:rgba(16,185,129,.12);color:#0e9f6e;transform:rotate(90deg)}
.csx-ring{width:104px;height:104px;margin:0 auto .4rem;position:relative}
.csx-ring svg{width:100%;height:100%}
.csx-circle{stroke:#0e9f6e;stroke-width:3;fill:none;stroke-linecap:round;stroke-dasharray:152;stroke-dashoffset:152}
html:not(.light) .csx-circle{stroke:#34d399}
.csx-check{stroke:#0e9f6e;stroke-width:4;fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:40;stroke-dashoffset:40}
html:not(.light) .csx-check{stroke:#34d399}
.csx-ov.show .csx-circle{animation:csxDraw .62s ease-out .05s both}
.csx-ov.show .csx-check{animation:csxDraw .45s ease-out .6s both}
@keyframes csxDraw{to{stroke-dashoffset:0}}
.csx-ring::before{content:'';position:absolute;left:50%;top:50%;width:130px;height:130px;margin:-65px 0 0 -65px;border-radius:50%;background:radial-gradient(circle,rgba(52,211,167,.5) 0%,rgba(14,159,110,.3) 36%,rgba(14,159,110,0) 70%);filter:blur(5px);opacity:0;animation:csxGlow 2.4s ease-out .2s both}
@keyframes csxGlow{0%{opacity:0;transform:scale(.45)}26%{opacity:1;transform:scale(.92)}55%{opacity:.8;transform:scale(1.12)}100%{opacity:0;transform:scale(1.3)}}
.csx-confetti{position:absolute;left:50%;top:26%;width:0;height:0;pointer-events:none;z-index:2}
.csx-confetti i{position:absolute;width:8px;height:12px;border-radius:2px;opacity:0;animation:confFly 1.05s cubic-bezier(.16,.6,.32,1) var(--d,1s) both}
.csx-confetti i:nth-child(even){border-radius:50%;width:7px;height:7px}
.csx-confetti i::after{content:'';position:absolute;inset:0;background:inherit;opacity:.55;transform:scale(1.6);border-radius:inherit}
.csx-title{font-size:1.5rem;font-weight:800;color:#0f172a;margin:1.1rem 0 .25rem;letter-spacing:-.01em}
html:not(.light) .csx-title{color:#f1f5f9}
.csx-sub{font-size:.9rem;color:#475569;line-height:1.6;margin:0 auto;max-width:330px}
html:not(.light) .csx-sub{color:#94a3b8}
.csx-ov.show .csx-title{animation:csxUp .45s ease-out .3s both}
.csx-ov.show .csx-sub{animation:csxUp .45s ease-out .38s both}
@keyframes csxUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.csx-tid{display:inline-flex;flex-direction:column;gap:3px;align-items:center;margin:1rem auto .7rem;padding:.55rem 1.3rem;border-radius:14px;border:1.5px dashed rgba(16,185,129,.55);background:rgba(16,185,129,.09);animation:csxUp .45s ease-out .46s both}
.csx-tid-lbl{font-size:.66rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#0e9f6e}
html:not(.light) .csx-tid-lbl{color:#34d399}
.csx-tid-val{font-size:1.25rem;font-weight:900;letter-spacing:.08em;color:#0f172a;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
html:not(.light) .csx-tid-val{color:#e2ffe9}
.csx-detail{font-size:.78rem;color:#64748b;line-height:1.55;margin:0 0 .2rem}
html:not(.light) .csx-detail{color:#8fa3b8}
.csx-btn{display:inline-flex;align-items:center;gap:8px;margin-top:.9rem;padding:.68rem 1.9rem;border:none;border-radius:40px;cursor:pointer;font-weight:700;font-size:.92rem;color:#fff;background:linear-gradient(135deg,#0e9f6e,#0c7d5c);box-shadow:0 8px 22px rgba(14,159,110,.35);transition:transform .18s,box-shadow .18s;animation:csxUp .45s ease-out .6s both}
.csx-btn:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(14,159,110,.45)}
.csx-btn:active{transform:translateY(0)}
@media (prefers-reduced-motion:reduce){.csx-ov.show,.csx-card,.csx-title,.csx-sub,.csx-tid,.csx-btn,.csx-ov.closing{animation:none!important}.csx-confetti{display:none}.csx-ring::before{animation:none;opacity:0}}
.cbx-list{margin-top:18px;border-top:1px dashed rgba(148,163,184,.25);padding-top:14px}
.cbx-lhead{font-size:.78rem;font-weight:700;color:#94a3b8;margin-bottom:10px;letter-spacing:.03em}
.cbx-items{display:flex;flex-direction:column;gap:8px;max-height:230px;overflow:auto}
.cbx-item{background:rgba(15,23,42,.7);border:1px solid rgba(148,163,184,.14);border-left:3px solid #34d399;border-radius:10px;padding:9px 12px;font-size:.8rem}
.cbx-ic-it ~ * .cbx-item,.cbx-card:nth-child(2) .cbx-item{border-left-color:#fb7185}
html.light .cbx-item{background:#f8fafc;border-color:rgba(15,23,42,.1)}
.cbx-item .id{color:#34d399;font-weight:800;letter-spacing:.02em}
.cbx-card:nth-child(2) .cbx-item .id{color:#fb7185}
.cbx-item .cat{display:block;color:#cbd5e1;font-weight:600;margin-top:2px}
html.light .cbx-item .cat{color:#334155}
.cbx-item .dt{display:block;color:#64748b;font-size:.7rem;margin-top:3px}
.cbx-item .st{float:right;font-size:.66rem;color:#34d399;border:1px solid rgba(52,211,153,.4);padding:1px 7px;border-radius:99px;font-weight:700}
.cbx-card:nth-child(2) .cbx-item .st{color:#fb7185;border-color:rgba(244,63,94,.4)}
.cbx-empty{font-size:.78rem;color:#64748b;padding:4px 0}
.cbx-note{font-size:.76rem;color:#64748b;line-height:1.7;margin:1.2rem auto 0;max-width:760px;text-align:center}
.cbx-note a{color:#34d399;font-weight:700;text-decoration:none}
@media(max-width:640px){.cbx-grid{grid-template-columns:1fr}}
</style>
<script>
(function(){
  var KEY='aai_complaints';
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  function load(){try{return JSON.parse(localStorage.getItem(KEY)||'[]');}catch(e){return [];}}
  function save(a){try{localStorage.setItem(KEY,JSON.stringify(a));}catch(e){}}
  function rid(p){var n=Date.now().toString(36).slice(-4).toUpperCase()+Math.floor(Math.random()*1296).toString(36).toUpperCase().padStart(2,'0');return p+'-'+n;}
  function nowStr(){var d=new Date();var p=function(x){return (x<10?'0':'')+x;};return d.getDate()+' '+['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()]+' '+d.getFullYear()+' '+p(d.getHours())+':'+p(d.getMinutes());}
  var CATS={police:'Police / Service',land:'Land',court:'Court / Case',corruption:'Corruption',women:'Women safety',gov:'Govt service',legal:'Legal aid',other:'Other'};
  function show(el,html){el.innerHTML=html;el.classList.add('on');}
  function hide(el){el.classList.remove('on');el.innerHTML='';}
  function itemsHTML(list){
    if(!list.length){return '<div class="cbx-empty">No complaints submitted yet. / এখনো কোনো অভিযোগ জমা দেওয়া হয়নি।</div>';}
    return list.map(function(c){
      var det=c.details.length>110?esc(c.details.slice(0,110))+'...':esc(c.details);
      var meta=[];
      if(c.cat)meta.push(esc(c.cat));if(c.where)meta.push(esc(c.where));if(c.phone)meta.push(esc(c.phone));
      return '<div class="cbx-item"><span class="st">Received</span><span class="id">'+esc(c.id)+'</span><span class="cat">'+esc(c.name||c.type||'Report')+((meta.length)?' - '+meta.join(' ·'):'')+'</span><span class="dt">'+esc(c.when)+'</span></div>';
    }).join('');
  }
  function render(){
    var all=load();
    var cit=all.filter(function(c){return c.kind==='cit';});
    var it=all.filter(function(c){return c.kind==='it';});
    var cl=document.getElementById('cbxCitList');if(cl)cl.innerHTML=itemsHTML(cit);
    var il=document.getElementById('cbxItList');if(il)il.innerHTML=itemsHTML(it).replace('complaints submitted','reports submitted');
  }
  function phoneOK(v){return /^01[3-9][0-9]{8}$/.test(v);}
  function csxConfetti(){
    var c=document.getElementById('csxConfetti');if(!c)return;
    c.innerHTML='';
    var cols=['#0e9f6e','#fbbf24','#2dd4a7','#f97316','#a3e635','#14b8a6','#f59e0b','#0e9f6e'];
    var _cd2=document.getElementById('csxCard');var _cw2=_cd2?_cd2.clientWidth:360;var _sc2=Math.max(.55,Math.min(1.4,(_cw2*0.5-40)/110));
    for(var k=0;k<16;k++){
      var i=document.createElement('i');
      var a=k*Math.PI*2/16+Math.random()*.4;
      var r=((k%2===0)?72+Math.random()*26:48+Math.random()*22)*_sc2;
      i.style.setProperty('--dx',Math.round(Math.cos(a)*r)+'px');
      i.style.setProperty('--dy',Math.round(Math.sin(a)*r)+'px');
      i.style.setProperty('--d',(0.82+k*0.025+Math.random()*.12).toFixed(2)+'s');
      i.style.setProperty('--sp',(200+Math.floor(Math.random()*160))*(k%2?-1:1)+'deg');
      i.style.background=cols[k%8];
      c.appendChild(i);
    }
  }
  function closeCbxSuccess(){
    var ov=document.getElementById('csxOv');
    if(!ov||ov.className.indexOf('show')===-1)return;
    ov.className='csx-ov closing';
    clearTimeout(csxTimer);
    document.body.style.overflow='';
    setTimeout(function(){ov.className='csx-ov';},240);
  }
  var csxTimer=null;
  function showCbxSuccess(id,title,sub,detail){
    var ov=document.getElementById('csxOv');
    if(!ov)return false;
    var okc=document.getElementById('cbxCitOk'),oki=document.getElementById('cbxItOk');
    if(okc)okc.className='cbx-ok';
    if(oki)oki.className='cbx-ok';
    /* moved below the show so the card width is measurable */
    document.getElementById('csxTid').textContent=id||'';
    if(title)document.getElementById('csxTitle').textContent=title;
    document.getElementById('csxSub').textContent=sub||'';
    document.getElementById('csxDetail').textContent=detail||'';
    var ci=ov.querySelector('.csx-circle'),ck=ov.querySelector('.csx-check');
    if(ci){ci.style.animation='none';ck.style.animation='none';void ci.offsetWidth;ci.style.animation='';ck.style.animation='';}
    ov.className='csx-ov show';
    csxConfetti();
setTimeout(function(){if(typeof playSuccessChime==='function'){playSuccessChime();}},1150);
    document.body.style.overflow='hidden';
    clearTimeout(csxTimer);
    csxTimer=setTimeout(closeCbxSuccess,5600);
    return true;
  }

  (function(){
    var x=document.getElementById('csxX'),d=document.getElementById('csxDone');
    if(x&&!x.onclick){x.onclick=closeCbxSuccess;}
    if(d&&!d.onclick){d.onclick=closeCbxSuccess;}
  })();

  function handleCit(e){
    e.preventDefault();
    var name=document.getElementById('cbxCitName').value.trim();
    var phone=document.getElementById('cbxCitPhone').value.trim();
    var nid=document.getElementById('cbxCitNid').value.trim();
    var div=document.getElementById('cbxCitDiv').value;
    var dist=document.getElementById('cbxCitDist').value.trim();
    var csel=document.getElementById('cbxCitCat');var cat=csel.value;var catLbl=csel.options[csel.selectedIndex]?csel.options[csel.selectedIndex].text.split(' (')[0]:cat;
    var det=document.getElementById('cbxCitDet').value.trim();
    var err=document.getElementById('cbxCitErr');
    if(!phone){show(err,'Please enter your mobile number / মোবাইল নম্বর দিন।');return;}
    if(!phoneOK(phone)){show(err,'Enter a valid Bangladeshi mobile number (01XXXXXXXXX) / সঠিক মোবাইল নম্বর দিন।');return;}
    if(!cat){show(err,'Please choose a complaint category / অভিযোগের ধরন বাছাই করুন।');return;}
    if(det.length<10){show(err,'Please describe your complaint in at least 10 characters / কমপক্ষে ১০ অক্ষরে বিবরণ লিখুন।');return;}
    hide(err);
    var id=rid('GRV');
    var all=load();
    all.unshift({kind:'cit',id:id,name:name||'Anonymous',phone:phone,nid:nid,div:div,dist:dist,cat:catLbl,details:det,when:nowStr(),status:'Received'});
    save(all);
    document.getElementById('cbxCitForm').reset();
    showCbxSuccess(id,'Complaint Received!','Your complaint has been received and forwarded to the concerned authority desk for review.','Category: '+catLbl+(div?'  |  '+div+(dist?', '+dist:''):'')+'  |  '+nowStr());
    render();
  }
  function handleIt(e){
    e.preventDefault();
    var tsel=document.getElementById('cbxItType');var type=tsel.value;var typeLbl=tsel.options[tsel.selectedIndex]?tsel.options[tsel.selectedIndex].text.split(' (')[0]:type;
    var where=document.getElementById('cbxItWhere').value.trim();
    var det=document.getElementById('cbxItDet').value.trim();
    var dev=document.getElementById('cbxItDev').value.trim();
    var con=document.getElementById('cbxItCon').value.trim();
    var err=document.getElementById('cbxItErr');
    if(!type){show(err,'Please select the issue type / সমস্যার ধরন বাছাই করুন।');return;}
    if(det.length<5){show(err,'Please describe the issue briefly / সমস্যাটি সংক্ষেপে লিখুন।');return;}
    hide(err);
    var id=rid('IT');
    var all=load();
    all.unshift({kind:'it',id:id,type:typeLbl,where:where,details:det,dev:dev,con:con,when:nowStr(),status:'Received'});
    save(all);
    document.getElementById('cbxItForm').reset();
    showCbxSuccess(id,'Report Received!','Thank you - our technical team will review the issue and fix it.','Type: '+typeLbl+(where?'  |  Where: '+where:'')+'  |  '+nowStr());
    render();
  }
  var cf=document.getElementById('cbxCitForm');if(cf)cf.addEventListener('submit',handleCit);
  var inf=document.getElementById('cbxItForm');if(inf)inf.addEventListener('submit',handleIt);
  render();
})();
</script>

<section id="contact" style="background:linear-gradient(135deg,rgba(14,165,233,.1),rgba(99,102,241,.1));border-top:1px solid var(--gb);border-bottom:1px solid var(--gb)"><div class="container" style="text-align:center">
<h2 style="font-size:clamp(2rem,4vw,3rem);font-weight:800;color:#fff;margin-bottom:1rem">Join the Justice Revolution</h2>
<p style="color:#94a3b8;font-size:1.1rem;max-width:600px;margin:0 auto 2rem;line-height:1.7">Whether developer, lawyer, policymaker, or donor across any of the 64 districts - there is a role for you.</p>
<div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap"><a href="mailto:jin.choi@undp.org" class="btn-p"><i class="fas fa-envelope"></i> Contact Project Lead</a><a href="#" class="btn-s"><i class="fas fa-download"></i> Download PRD</a></div>
</div></section>
<button class="back-to-top" id="backToTop" aria-label="Back to top"><i class="fas fa-arrow-up"></i></button>
<footer><div class="fgrid">
<div><a href="#" class="nav-logo" style="margin-bottom:1rem;display:inline-flex"><span>A ai</span></a><p>Next-Gen Digital Legal Aid - Access to justice for 682,500+ citizens across all 64 districts.</p></div>
<div class="fcol"><h4>Platform</h4><a href="#features">Features</a><a href="#solution">Architecture</a><a href="#personas">Personas</a><a href="#impact">Impact</a></div>
<div class="fcol"><h4>Project</h4><a href="#roadmap">Roadmap</a><a href="#partners">Partners</a><a href="#flow">User Flows</a><a href="#contact">Contact</a></div>
<div class="fcol"><h4>Resources</h4><a href="#">PRD</a><a href="#">TRD</a><a href="#">User Flows</a><a href="#">Info Sheet</a></div>
</div><div class="fb"><span>© 2025 A ai | EU / UNDP / DBLA</span><span>Accelerating Digital Legal Aid in Bangladesh</span></div></footer>
<script>
const pc=document.getElementById('particles');for(let i=0;i<30;i++){const p=document.createElement('div');p.className='particle';const s=Math.random()*4+1;p.style.cssText='width:'+s+'px;height:'+s+'px;top:'+Math.random()*100+'%;left:'+Math.random()*100+'%;animation-delay:'+Math.random()*15+'s;animation-duration:'+(10+Math.random()*20)+'s';pc.appendChild(p)}
window.addEventListener('scroll',()=>{document.getElementById('nav').classList.toggle('scrolled',window.scrollY>50)})
const obs=new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target)}})},{threshold:0.1})
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el))

const themeToggle=document.getElementById('themeToggle');
const savedTheme=localStorage.getItem('dla-theme');
if(savedTheme!=='dark'){document.documentElement.classList.add('light');themeToggle.innerHTML='<i class="fas fa-moon"></i>'}
themeToggle.addEventListener('click',()=>{const isLight=document.documentElement.classList.toggle('light');themeToggle.innerHTML=isLight?'<i class="fas fa-moon"></i>':'<i class="fas fa-sun"></i>';localStorage.setItem('dla-theme',isLight?'light':'dark')});

const hamburger=document.getElementById('hamburger');
const drawer=document.getElementById('mobileDrawer');
const overlay=document.getElementById('drawerOverlay');
const closeBtn=document.getElementById('drawerClose');
function openDrawer(){hamburger.classList.add('active');drawer.classList.add('active');overlay.classList.add('active');document.body.style.overflow='hidden'}
function closeDrawer(){hamburger.classList.remove('active');drawer.classList.remove('active');overlay.classList.remove('active');document.body.style.overflow=''}
hamburger.addEventListener('click',()=>{drawer.classList.contains('active')?closeDrawer():openDrawer()});
closeBtn.addEventListener('click',closeDrawer);
overlay.addEventListener('click',closeDrawer);
drawer.querySelectorAll('a').forEach(link=>link.addEventListener('click',closeDrawer));

const scrollProgress=document.getElementById('scrollProgress');
const backToTop=document.getElementById('backToTop');
window.addEventListener('scroll',()=>{
  const scrollTop=document.documentElement.scrollTop||document.body.scrollTop;
  const scrollHeight=document.documentElement.scrollHeight-document.documentElement.clientHeight;
  const progress=(scrollTop/scrollHeight)*100;
  scrollProgress.style.width=progress+'%';
  backToTop.classList.toggle('visible',scrollTop>500);
});
backToTop.addEventListener('click',()=>{window.scrollTo({top:0,behavior:'smooth'})});

// Animated counter numbers
const counterObserver=new IntersectionObserver((entries)=>{
  entries.forEach(entry=>{
    if(entry.isIntersecting){
      const el=entry.target;
      const target=parseFloat(el.dataset.target);
      const suffix=el.dataset.suffix||'';
      const prefix=el.dataset.prefix||'';
      const decimals=parseInt(el.dataset.decimals)||0;
      const duration=2000;
      const start=performance.now();
      function animate(now){
        const elapsed=now-start;
        const progress=Math.min(elapsed/duration,1);
        const eased=1-Math.pow(1-progress,3);
        const current=eased*target;
        if(decimals>0){
          el.textContent=prefix+current.toFixed(decimals)+suffix;
        }else{
          el.textContent=prefix+Math.floor(current).toLocaleString()+suffix;
        }
        if(progress<1)requestAnimationFrame(animate);
      }
      requestAnimationFrame(animate);
      counterObserver.unobserve(el);
    }
  });
},{threshold:0.5});
document.querySelectorAll('.sn[data-target]').forEach(el=>counterObserver.observe(el));

// Typing animation for hero headline
(function(){
  const line1=document.getElementById('typingLine1');
  const line2=document.getElementById('typingLine2');
  const lines=[
    {el:line1,text:'AI-Powered',speed:80},
    {el:line2,text:'Justice for Every Bangladeshi Citizen',speed:50}
  ];
  let lineIdx=0,charIdx=0;
  function typeNext(){
    if(lineIdx>=lines.length)return;
    const current=lines[lineIdx];
    if(charIdx<current.text.length){
      current.el.textContent+=current.text[charIdx];
      charIdx++;
      setTimeout(typeNext,current.speed);
    }else{
      lineIdx++;
      charIdx=0;
      if(lineIdx<lines.length)setTimeout(typeNext,400);
    }
  }
  setTimeout(typeNext,800);
})();

// Parallax scrolling for hero particles
(function(){
  const particles=document.getElementById('particles');
  const heroBg=document.querySelector('.hero-bg');
  const hero=document.querySelector('.hero');
  if(!particles||!hero)return;
  
  // Create additional parallax layers
  const layer1=document.createElement('div');
  layer1.className='parallax-layer';
  layer1.style.cssText='position:absolute;inset:0;z-index:0;will-change:transform';
  
  // Add floating orbs with different sizes and speeds
  const orbs=[
    {size:120,color:'rgba(14,165,233,0.08)',x:10,y:20,speed:0.3},
    {size:80,color:'rgba(99,102,241,0.06)',x:70,y:30,speed:0.5},
    {size:60,color:'rgba(245,158,11,0.05)',x:85,y:70,speed:0.2},
    {size:100,color:'rgba(14,165,233,0.06)',x:20,y:80,speed:0.4},
    {size:50,color:'rgba(99,102,241,0.07)',x:60,y:15,speed:0.35},
  ];
  
  orbs.forEach(orb=>{
    const el=document.createElement('div');
    el.style.cssText='position:absolute;border-radius:50%;background:'+orb.color+';width:'+orb.size+'px;height:'+orb.size+'px;left:'+orb.x+'%;top:'+orb.y+'%;filter:blur(30px);will-change:transform;transition:transform .1s linear';
    el.dataset.speed=orb.speed;
    layer1.appendChild(el);
  });
  particles.appendChild(layer1);
  
  // Track scroll for parallax
  let ticking=false;
  window.addEventListener('scroll',()=>{
    if(!ticking){
      requestAnimationFrame(()=>{
        const scrollY=window.scrollY;
        const heroHeight=hero.offsetHeight;
        
        if(scrollY<heroHeight*1.5){
          // Parallax effect: particles move slower than scroll
          const orbs=layer1.querySelectorAll('div');
          orbs.forEach(orb=>{
            const speed=parseFloat(orb.dataset.speed);
            const yOffset=scrollY*speed;
            const xOffset=scrollY*speed*0.2;
            orb.style.transform='translate3d('+xOffset+'px,'+(-yOffset)+'px,0)';
          });
          
          // Fade hero content on scroll
          const heroContent=document.querySelector('.hero-content');
          if(heroContent){
            const fadeStart=heroHeight*0.1;
            const fadeEnd=heroHeight*0.6;
            const opacity=scrollY<fadeStart?1:scrollY>fadeEnd?0:1-(scrollY-fadeStart)/(fadeEnd-fadeStart);
            heroContent.style.opacity=opacity;
            heroContent.style.transform='translateY('+(scrollY*0.15)+'px)';
          }
          
          // Parallax on hero background gradient
          if(heroBg){
            heroBg.style.transform='translateY('+(scrollY*0.3)+'px)';
          }
        }
        ticking=false;
      });
      ticking=true;
    }
  });
})();
</script><div class="auth-overlay" id="authOverlay">
<div class="auth-modal">
<button class="auth-close" onclick="closeAuthModal()"><i class="fas fa-times"></i></button>
<div class="auth-success" id="authSuccess">
<div class="as-ring"><svg viewBox="0 0 52 52"><circle class="as-circle" cx="26" cy="26" r="24" fill="none"/><path class="as-check" fill="none" d="M14 27l8 8 16-16"/></svg></div>
<div class="as-confetti"><i style="--dx:85px;--dy:0px;--d:0.86s;--sp:260deg;background:#0e9f6e"></i><i style="--dx:62px;--dy:62px;--d:0.90s;--sp:320deg;background:#fbbf24"></i><i style="--dx:0px;--dy:85px;--d:0.94s;--sp:240deg;background:#2dd4a7"></i><i style="--dx:-62px;--dy:62px;--d:0.98s;--sp:300deg;background:#f97316"></i><i style="--dx:-85px;--dy:0px;--d:1.02s;--sp:220deg;background:#a3e635"></i><i style="--dx:-62px;--dy:-62px;--d:1.06s;--sp:340deg;background:#14b8a6"></i><i style="--dx:0px;--dy:-85px;--d:1.10s;--sp:280deg;background:#f59e0b"></i><i style="--dx:62px;--dy:-62px;--d:1.14s;--sp:310deg;background:#0e9f6e"></i><i style="--dx:60px;--dy:0px;--d:0.92s;--sp:-260deg;background:#f97316"></i><i style="--dx:42px;--dy:42px;--d:0.96s;--sp:-320deg;background:#a3e635"></i><i style="--dx:0px;--dy:60px;--d:1.00s;--sp:-240deg;background:#14b8a6"></i><i style="--dx:-42px;--dy:42px;--d:1.04s;--sp:-300deg;background:#f59e0b"></i><i style="--dx:-60px;--dy:0px;--d:1.08s;--sp:-220deg;background:#0e9f6e"></i><i style="--dx:-42px;--dy:-42px;--d:1.12s;--sp:-340deg;background:#0e9f6e"></i><i style="--dx:0px;--dy:-60px;--d:1.16s;--sp:-280deg;background:#fbbf24"></i><i style="--dx:42px;--dy:-42px;--d:1.20s;--sp:-310deg;background:#2dd4a7"></i></div>
<h3 id="asTitle">Signed In Successfully!</h3>
<p id="asSub">Welcome back - your legal dashboard is ready.</p>
<div class="as-user" id="asUser">
<span class="as-chip" id="asRole"><i class="fas fa-user" id="asRoleIcon"></i><span id="asRoleTxt">General User</span></span>
<span class="as-chip" id="asLoc"><i class="fas fa-map-marker-alt"></i><span id="asLocTxt">-</span></span>
</div>
<div class="as-actions" id="asActions">
<button class="as-shortcut" onclick="successGo('complaints')"><i class="fas fa-file-alt"></i> My Complaints</button>
<button class="as-shortcut" onclick="successGo('sheguard-live')"><i class="fas fa-shield-alt"></i> SheGuard X</button>
<button class="as-shortcut" onclick="successGo('contact')"><i class="fas fa-headset"></i> Get Help</button>
</div>
