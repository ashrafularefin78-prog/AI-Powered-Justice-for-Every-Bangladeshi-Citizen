    body.light #omega-intro .fcard h3,body.light #juston-force .fcard h3,body.light #justice-computer .fcard h3,body.light #end-free-will .fcard h3,body.light #justice-field .fcard h3,body.light #god-mind .fcard h3,body.light #akashic-records .fcard h3,body.light #omega-point .fcard h3,body.light #omega-ux .fcard h3,body.light #omega-ethics .fcard h3{color:#1e293b}
    body.light #omega-intro .fcard p,body.light #juston-force .fcard p,body.light #justice-computer .fcard p,body.light #end-free-will .fcard p,body.light #justice-field .fcard p,body.light #god-mind .fcard p,body.light #akashic-records .fcard p,body.light #omega-point .fcard p,body.light #omega-ux .fcard p,body.light #omega-ethics .fcard p{color:#475569}
    body.light #omega-intro,body.light #juston-force,body.light #end-free-will,body.light #god-mind,body.light #omega-point,body.light #omega-ethics,body.light #omega-timeline{background:linear-gradient(135deg,rgba(255,215,0,.03),rgba(168,85,247,.03))}
